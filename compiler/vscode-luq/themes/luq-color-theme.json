{
  "name": "Luq Default Theme",
  "type": "dark",
  "colors": {
    "editor.background": "#1e1e1e",
    "editor.foreground": "#d4d4d4"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6A9955"
      }
    },
    {
      "name": "Test Function Keyword",
      "scope": [
        "keyword.control.function.test"
      ],
      "settings": {
        "foreground": "#FF0000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Test Decorator",
      "scope": [
        "punctuation.decorator.test"
      ],
      "settings": {
        "foreground": "#00FF00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Keyword",
      "scope": [
        "storage.type.function",
        "storage.type.function.luq",
        "keyword.control.function.luq",
        "keyword.function"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Function Names",
      "scope": [
        "entity.name.function",
        "entity.name.function.luq",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type.interface",
        "storage.type.type"
      ],
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "name": "Storage Modifiers",
      "scope": [
        "storage.modifier",
        "keyword.control.export",
        "keyword.control.import",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.type.interface",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Primitive Types",
      "scope": [
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "name": "Booleans & Null",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Variables & Properties",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "punctuation.decorator",
        "entity.name.decorator",
        "meta.decorator",
        "punctuation.decorator.at.luq",
        "keyword.operator.at.luq",
        "support.function.decorator.luq"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#D7BA7D"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition.block",
        "punctuation.definition.parameters"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#D16969"
      }
    }
  ]
}