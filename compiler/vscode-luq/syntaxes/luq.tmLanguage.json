{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Luq",
  "scopeName": "source.luq",
  "patterns": [
    { "include": "#comments" },
    { "include": "#decorators" },
    { "include": "#imports" },
    { "include": "#exports" },
    { "include": "#function-declaration" },
    { "include": "#interface-declaration" },
    { "include": "#type-alias" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.luq",
          "match": "//.*$"
        },
        {
          "name": "comment.block.luq",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.luq" }
          }
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.luq",
          "match": "(@)(\\w+)(\\(([^)]*)\\))?",
          "captures": {
            "1": { "name": "punctuation.decorator.at.luq" },
            "2": { "name": "entity.name.decorator support.function.decorator.luq" },
            "3": { "name": "meta.decorator.arguments.luq" },
            "4": { "name": "variable.parameter.decorator.luq" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.luq",
          "begin": "\\b(import)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.luq" }
          },
          "end": "(?=;|$)",
          "patterns": [
            {
              "match": "\\b(from)\\b",
              "name": "keyword.control.from.luq"
            },
            { "include": "#strings" },
            { "include": "#punctuation" },
            {
              "match": "\\b(\\w+)\\b",
              "name": "variable.other.readwrite.luq"
            }
          ]
        }
      ]
    },
    "exports": {
      "patterns": [
        {
          "match": "\\b(export)\\s+(default)\\b",
          "captures": {
            "1": { "name": "keyword.control.export.luq" },
            "2": { "name": "keyword.control.default.luq" }
          }
        },
        {
          "match": "\\b(export)\\b",
          "name": "keyword.control.export.luq"
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "name": "meta.function.luq",
          "begin": "\\b(function)\\s+(\\w+)\\s*(?=\\()",
          "beginCaptures": {
            "1": { "name": "keyword.control.function.luq storage.type.function.luq" },
            "2": { "name": "entity.name.function.luq" }
          },
          "end": "(?<=\\})|(?=;)",
          "patterns": [
            { "include": "#function-parameters" },
            { "include": "#return-type" },
            { "include": "#function-body" }
          ]
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "name": "meta.parameters.luq",
          "begin": "\\(",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.parameters.begin.luq" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.parameters.end.luq" }
          },
          "patterns": [
            {
              "match": "(\\w+)(\\??)(\\s*:\\s*)",
              "captures": {
                "1": { "name": "variable.parameter.luq" },
                "2": { "name": "keyword.operator.optional.luq" },
                "3": { "name": "punctuation.separator.parameter.luq" }
              }
            },
            { "include": "#types" },
            { "include": "#literals" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "return-type": {
      "patterns": [
        {
          "match": "(\\s*:\\s*)",
          "captures": {
            "1": { "name": "punctuation.separator.return-type.luq" }
          }
        }
      ]
    },
    "function-body": {
      "patterns": [
        {
          "name": "meta.block.luq",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.block.luq" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.luq" }
          },
          "patterns": [
            { "include": "#statements" }
          ]
        }
      ]
    },
    "interface-declaration": {
      "patterns": [
        {
          "name": "meta.interface.luq",
          "begin": "\\b(interface)\\s+(\\w+)",
          "beginCaptures": {
            "1": { "name": "storage.type.interface.luq" },
            "2": { "name": "entity.name.type.interface.luq" }
          },
          "end": "(?<=\\})",
          "patterns": [
            { "include": "#interface-extends" },
            { "include": "#interface-body" }
          ]
        }
      ]
    },
    "interface-extends": {
      "patterns": [
        {
          "match": "\\b(extends)\\s+(\\w+)",
          "captures": {
            "1": { "name": "storage.modifier.extends.luq" },
            "2": { "name": "entity.name.type.luq" }
          }
        }
      ]
    },
    "interface-body": {
      "patterns": [
        {
          "name": "meta.interface.body.luq",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.block.luq" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.luq" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#decorators" },
            { "include": "#interface-member" }
          ]
        }
      ]
    },
    "interface-member": {
      "patterns": [
        {
          "match": "\\b(readonly)\\s+(\\w+)(\\??)(\\s*:\\s*)",
          "captures": {
            "1": { "name": "storage.modifier.readonly.luq" },
            "2": { "name": "variable.object.property.luq" },
            "3": { "name": "keyword.operator.optional.luq" },
            "4": { "name": "punctuation.separator.type.luq" }
          }
        },
        {
          "match": "(\\w+)(\\??)(\\s*:\\s*)",
          "captures": {
            "1": { "name": "variable.object.property.luq" },
            "2": { "name": "keyword.operator.optional.luq" },
            "3": { "name": "punctuation.separator.type.luq" }
          }
        },
        { "include": "#types" },
        { "include": "#literals" },
        { "include": "#punctuation" }
      ]
    },
    "type-alias": {
      "patterns": [
        {
          "name": "meta.type.declaration.luq",
          "begin": "\\b(type)\\s+(\\w+)\\s*(=)",
          "beginCaptures": {
            "1": { "name": "storage.type.type.luq" },
            "2": { "name": "entity.name.type.alias.luq" },
            "3": { "name": "keyword.operator.assignment.luq" }
          },
          "end": "(?=;|$)",
          "patterns": [
            { "include": "#types" },
            { "include": "#literals" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "statements": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#return-statement" },
        { "include": "#control-flow" },
        { "include": "#expressions" }
      ]
    },
    "return-statement": {
      "patterns": [
        {
          "name": "keyword.control.flow.luq",
          "match": "\\b(return)\\b"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.conditional.luq",
          "match": "\\b(if|else|switch|case|default)\\b"
        },
        {
          "name": "keyword.control.loop.luq",
          "match": "\\b(for|while|do|break|continue)\\b"
        },
        {
          "name": "keyword.control.trycatch.luq",
          "match": "\\b(try|catch|finally|throw)\\b"
        }
      ]
    },
    "expressions": {
      "patterns": [
        { "include": "#literals" },
        { "include": "#operators" },
        { "include": "#function-call" },
        { "include": "#member-access" },
        { "include": "#identifiers" },
        { "include": "#punctuation" }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "(\\w+)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.luq" }
          }
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "(\\.)\\s*(\\w+)",
          "captures": {
            "1": { "name": "punctuation.accessor.luq" },
            "2": { "name": "variable.other.property.luq" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.luq",
          "match": "\\b(const|let|var|class|extends|implements|static|async|await|yield|of|in|instanceof|typeof|keyof|new|this|super)\\b"
        },
        {
          "name": "storage.type.luq",
          "match": "\\b(function|interface|type|enum|namespace|module|declare|abstract)\\b"
        },
        {
          "name": "storage.modifier.luq",
          "match": "\\b(public|private|protected|readonly|static|export|import|from|default|as)\\b"
        },
        {
          "name": "constant.language.boolean.luq",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.luq",
          "match": "\\b(null|undefined)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.luq",
          "match": "\\b(string|number|boolean|symbol|bigint|object|any|unknown|never|void)\\b"
        },
        {
          "name": "entity.name.type.luq",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b"
        },
        {
          "match": "(\\[\\s*\\])",
          "name": "meta.type.array.luq"
        },
        {
          "match": "(\\|)",
          "name": "keyword.operator.type.union.luq"
        },
        {
          "match": "(&)",
          "name": "keyword.operator.type.intersection.luq"
        },
        {
          "match": "(\\?)",
          "name": "keyword.operator.type.optional.luq"
        }
      ]
    },
    "literals": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#template-strings" },
        { "include": "#regex" },
        { "include": "#numbers" },
        { "include": "#boolean" },
        { "include": "#null" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.luq",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.luq" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.luq" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.luq",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.luq",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.luq" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.luq" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.luq",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|.)"
            }
          ]
        }
      ]
    },
    "template-strings": {
      "patterns": [
        {
          "name": "string.template.luq",
          "begin": "`",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.template.begin.luq" }
          },
          "end": "`",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.template.end.luq" }
          },
          "patterns": [
            {
              "name": "meta.template.expression.luq",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.luq" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.luq" }
              },
              "patterns": [
                { "include": "#expressions" }
              ]
            },
            {
              "name": "constant.character.escape.luq",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.luq",
          "begin": "(?<=[=(:,\\[]|^|return|&&|\\|\\||!)\\s*(/)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.luq" }
          },
          "end": "(/)([gimsuvy]*)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.luq" },
            "2": { "name": "keyword.other.luq" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.luq",
              "match": "\\\\."
            },
            {
              "name": "constant.other.character-class.luq",
              "match": "\\[([^\\]]+)\\]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.luq",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.luq",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.luq",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.decimal.luq",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "boolean": {
      "patterns": [
        {
          "name": "constant.language.boolean.luq",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "null": {
      "patterns": [
        {
          "name": "constant.language.null.luq",
          "match": "\\b(null|undefined)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.luq",
          "match": "(\\+|\\-|\\*|\\/|%|\\+\\+|\\-\\-)"
        },
        {
          "name": "keyword.operator.assignment.luq",
          "match": "(=|\\+=|\\-=|\\*=|\\/=|%=|\\|=|&=|\\^=|<<=|>>=|>>>=)"
        },
        {
          "name": "keyword.operator.comparison.luq",
          "match": "(==|!=|===|!==|<|<=|>|>=)"
        },
        {
          "name": "keyword.operator.logical.luq",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.luq",
          "match": "(&|\\||\\^|~|<<|>>|>>>)"
        },
        {
          "name": "keyword.operator.ternary.luq",
          "match": "(\\?|:)"
        },
        {
          "name": "keyword.operator.spread.luq",
          "match": "(\\.\\.\\.)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.luq",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.luq",
          "match": ";"
        },
        {
          "name": "punctuation.definition.block.luq",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.array.luq",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.parameters.luq",
          "match": "[()]"
        },
        {
          "name": "punctuation.accessor.luq",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.key-value.luq",
          "match": ":"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.luq",
          "match": "[a-zA-Z_$][a-zA-Z0-9_$]*"
        }
      ]
    }
  }
}