{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Luq",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.luq",
          "match": "//.*$"
        },
        {
          "name": "comment.block.luq",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.luq",
          "match": "\\b(interface|export|import|from|function|if|else|return|for|while|do|break|continue|switch|case|default|try|catch|finally|throw)\\b"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.luq",
          "match": "@(required|optional|validator|min|max|pattern|email|array|minLength|maxLength|validateUser)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.luq",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.luq",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.luq",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.luq",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.luq",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.luq",
          "match": "\\b(string|number|boolean|void|any|unknown|never|null|undefined)\\b"
        }
      ]
    }
  },
  "scopeName": "source.luq"
}