import { validateEmail } from "./validators.luq";
import UserValidator from "./validators.luq";
import * as utils from "./validators.luq";

export interface TestValidator extends UserValidator {
    @required
    priority: number;
}

export function testFunction(input: string): boolean {
    if (!validateEmail(input)) {
        return false;
    }
    return true;
}

