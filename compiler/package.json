{
  "name": "@maroonedog/luq-compiler",
  "version": "0.1.0-alpha",
  "description": "Compiler for .luq DSL files - TypeScript-like validation definition language",
  "type": "module",
  "bin": {
    "luqc": "./dist/bin/luqc.js"
  },
  "scripts": {
    "build": "tsc",
    "build:lsp": "cargo build --release --bin luq-lsp",
    "build:rust:all": "npm run build:rust:linux && npm run build:rust:windows && npm run build:rust:macos",
    "build:rust:linux": "cargo build --release --target x86_64-unknown-linux-gnu",
    "build:rust:windows": "cargo build --release --target x86_64-pc-windows-msvc",
    "build:rust:macos": "cargo build --release --target x86_64-apple-darwin",
    "test": "cargo test",
    "prepublishOnly": "npm run build && echo 'Remember to build binaries for all platforms first!'"
  },
  "files": [
    "dist/",
    "binaries/"
  ],
  "keywords": [
    "luq",
    "compiler",
    "validation",
    "dsl",
    "typescript",
    "code-generation",
    "aot"
  ],
  "author": "Luq Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maroonedog/luq.git",
    "directory": "compiler"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "@maroonedog/luq-compiler-darwin-arm64": "0.1.0-alpha",
    "@maroonedog/luq-compiler-darwin-x64": "0.1.0-alpha",
    "@maroonedog/luq-compiler-linux-arm64": "0.1.0-alpha",
    "@maroonedog/luq-compiler-linux-x64": "0.1.0-alpha",
    "@maroonedog/luq-compiler-win32-x64": "0.1.0-alpha"
  },
  "dependencies": {
    "@types/vscode": "^1.104.0",
    "vscode-languageclient": "^9.0.1"
  }
}
