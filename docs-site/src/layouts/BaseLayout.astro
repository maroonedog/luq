---
import '../styles/global.css';
import { navItems } from '../components/Header.astro';
import MobileMenuOverlay from '../components/MobileMenuOverlay.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Luq — a type-first validation library for TypeScript.',
  image = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/library_image_cropped.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/library_image_cropped.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title} | Luq</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!--
      Browser chrome follows the MD3 `surface` role of each scheme. These two
      values are the light and dark `--md-sys-color-surface` from
      src/styles/md3-tokens.css; re-copy them if the seed ever changes.
    -->
    <meta name="theme-color" content="#fff7fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161215" media="(prefers-color-scheme: dark)" />

    <!--
      Material Symbols, the MD3 icon set. `display=block` keeps the glyph slot
      blank while the font loads rather than flashing the ligature text
      ("menu", "close") that the markup falls back to.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
    />

    <!--
      Scheme is applied before first paint so the page never flashes the wrong
      one. An explicit choice is stored under `theme`; with no choice stored the
      OS preference wins and keeps winning as it changes.
    -->
    <script is:inline>
      (() => {
        const stored = (() => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        })();
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const apply = (dark) =>
          document.documentElement.classList.toggle('dark', dark);

        apply(stored ? stored === 'dark' : media.matches);

        media.addEventListener('change', (event) => {
          let current = null;
          try {
            current = localStorage.getItem('theme');
          } catch {
            current = null;
          }
          if (!current) apply(event.matches);
        });
      })();
    </script>
  </head>
  <body>
    <slot />

    {/*
      The drawer the app bar's menu button opens, rendered here rather than per
      page. Header always emits that button below md, but nine of sixteen pages
      never rendered the overlay — every docs page and the plugin catalogue —
      so the button had no listener and a phone reader arriving from the README
      had no primary navigation at all and no way to ask for it. Rendering it
      from the layout is what makes "the button exists" and "the drawer exists"
      the same fact. check-built-pages.mjs holds the pair.
    */}
    <MobileMenuOverlay navItems={navItems} />

    <script>
      // Prism highlights the code blocks CodeBlock.astro emits. Colours come
      // from the --md-code-* tokens, so no Prism theme stylesheet is loaded.
      const PRISM_BASE = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0';
      const PRISM_FILES = [
        'components/prism-core.min.js',
        'components/prism-clike.min.js',
        'components/prism-javascript.min.js',
        'components/prism-typescript.min.js',
        'components/prism-json.min.js',
        'components/prism-bash.min.js',
      ];

      function loadScript(src: string): Promise<void> {
        return new Promise((resolve, reject) => {
          const element = document.createElement('script');
          element.src = src;
          element.onload = () => resolve();
          element.onerror = () => reject(new Error(`failed to load ${src}`));
          document.head.appendChild(element);
        });
      }

      interface PrismGlobal {
        manual: boolean;
        highlightElement(element: Element): void;
      }

      const readPrism = (): PrismGlobal | undefined =>
        (window as unknown as { Prism?: PrismGlobal }).Prism;

      function highlightAll(): void {
        const prism = readPrism();
        if (!prism) return;
        document.querySelectorAll('pre code').forEach((block) => {
          if (!block.className.includes('language-')) {
            block.className = 'language-typescript';
          }
          prism.highlightElement(block);
        });
      }

      async function startPrism(): Promise<void> {
        for (const file of PRISM_FILES) {
          await loadScript(`${PRISM_BASE}/${file}`);
        }
        const prism = readPrism();
        if (prism) prism.manual = true;
        highlightAll();

        // Pages that build code blocks client-side (the plugin picker) insert
        // <pre><code> after load; re-highlight when that happens.
        const observer = new MutationObserver((mutations) => {
          const added = mutations.some((mutation) =>
            Array.from(mutation.addedNodes).some(
              (node) =>
                node instanceof HTMLElement &&
                (node.tagName === 'PRE' || node.querySelector('pre code') !== null)
            )
          );
          if (added) highlightAll();
        });
        observer.observe(document.body, { childList: true, subtree: true });
      }

      startPrism().catch(() => {
        // Highlighting is decorative; unhighlighted code is still readable.
      });
    </script>
  </body>
</html>
