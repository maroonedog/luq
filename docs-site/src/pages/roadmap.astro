---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header, { navItems } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileMenuOverlay from '../components/MobileMenuOverlay.astro';
import { conformance } from '../data/conformance';

/**
 * This page replaces the 1.x roadmap, which advertised a `.luq` universal-platform
 * DSL — @database adapters, @endpoint definitions, `luq generate --lang=java`,
 * OpenAPI emission — against dated milestones ("Coming Q1–Q3 2026", "Q4 2026 —
 * v1.0", "2027+"). Those dates have now passed with none of it shipped, so the
 * page is not a plan any more; it is a broken promise. Nothing here carries a
 * date, and nothing here is unmeasured.
 *
 * Sources:
 *   README.md                          what ships, and the withdrawal below
 *   docs/json-schema-conformance.md    the named open features and their case counts
 *   config/perf-baseline.json          the shapes this release is slower on
 *   config/size-budget.json            the bundle floor
 */

const shipped = [
  {
    icon: 'inventory_2',
    headline: '77 plugins across 76 subpaths',
    detail:
      'Every rule you can call is a plugin you imported by name. An unimported plugin is not merely absent at run time — its method does not typecheck.',
    href: '/plugins',
    linkLabel: 'Browse the catalogue',
  },
  {
    icon: 'schema',
    headline: `${conformance.percent}% of the Draft-07 suite`,
    detail:
      `${conformance.passingCases} of ${conformance.caseCount} required cases, with skipped cases counted as failures. A validator that always said yes would score ${conformance.trivialPercent}%; 1.x scored 57.70%.`,
    href: '/json-schema',
    linkLabel: 'See the breakdown',
  },
  {
    icon: 'compress',
    headline: 'A 7,420 B gzipped floor',
    detail:
      'That is Builder with zero plugins. 1.x charged 17,423 B before you used anything. Adding the first six plugins costs about 159 B each.',
    href: '/benchmarks#bundle-size',
    linkLabel: 'See the measurements',
  },
  {
    icon: 'lock',
    headline: 'CSP-safe, and checked',
    detail:
      'Zero occurrences of eval and new Function across all 762 emitted modules, verified by a script and by the public-API smoke test. 1.x claimed this in its README while shipping a live new Function.',
    href: '/benchmarks',
    linkLabel: 'How it is checked',
  },
  {
    icon: 'package_2',
    headline: '84 export keys, every one resolving',
    detail:
      'A scratch consumer typechecks all 84 against the published declarations under both node16 and bundler resolution, and proves an unpublished subpath fails.',
    href: '/docs/getting-started',
    linkLabel: 'Get started',
  },
  {
    icon: 'cable',
    headline: 'Standard Schema v1',
    detail:
      'toStandardSchema() on the @maroonedog/luq/standard-schema subpath, so anything that accepts a Standard Schema — tRPC, TanStack Form, Hono, t3-env — accepts a Luq validator. A subpath rather than part of build(), because carrying it on every validator costs 312 B gzipped.',
    href: '/docs/getting-started#standard-schema',
    linkLabel: 'How to use it',
  },
  {
    icon: 'account_tree',
    headline: 'Paths that name the real index',
    detail:
      'Declare items[*].productId and the issue you get back says items[1].productId. A path that does not exist on your type is a compile error, not a silent no-op.',
    href: '/docs/getting-started',
    linkLabel: 'Read the guide',
  },
];

/**
 * Every entry is a `expiresWith` value from test/json-schema/suite-skip-list.ts —
 * a closed string union, so a failing case cannot be recorded without naming the
 * thing that would fix it. The counts are the measured case counts. No dates:
 * none of these is scheduled.
 */
const namedOpenWork = [
  {
    id: 'feature:external-ref-loader',
    cases: 57,
    what: 'Resolve external and remote $ref. A loader that touches the network is not a default a validation library should carry, so this is a design question before it is a task.',
  },
  {
    id: 'feature:json-pointer-escaping',
    cases: 9,
    what: 'JSON pointers containing ~0, ~1, %25 or an empty token.',
  },
  {
    id: 'feature:tuple-items-and-additional-items',
    cases: 6,
    what: 'The array form of items combined with additionalItems.',
  },
  {
    id: 'feature:document-driven-presence',
    cases: 5,
    what: 'Let a document express whether null is permitted. Today a plugin build() returns one rule, and presence is settled before any rule runs, so the caller writes .optional() themselves.',
  },
  {
    id: 'feature:additional-properties-with-patterns',
    cases: 3,
    what: 'Make additionalProperties consult patternProperties instead of over-rejecting.',
  },
  {
    id: 'feature:ref-identifier-scope',
    cases: 3,
    what: 'Base URIs established by $id, and #anchor.',
  },
  {
    id: 'feature:code-point-string-length',
    cases: 2,
    what: 'Count minLength / maxLength in code points rather than UTF-16 code units.',
  },
  {
    id: 'feature:ref-chain-resolution',
    cases: 1,
    what: 'Collect the rules behind a second-hop $ref.',
  },
  {
    id: 'feature:boolean-sub-schema',
    cases: 1,
    what: 'Accept true / false as a sub-schema in its own right.',
  },
];

const decidedAgainst = [
  {
    id: 'decision:reserved-path-segments',
    cases: 14,
    what: '__proto__ as a segment of a declared path. Refused on purpose, so that prototype pollution is unreachable. This is not open work and will not be “fixed”.',
  },
];

const knownWeaknesses = [
  {
    title: 'Slower than 1.x on flat and nested shapes',
    detail:
      'Measured in one process: ×0.11 on one field, ×0.35 on three fields, ×0.32 nested. Arrays (×1.57) and JSON Schema (×1.09) are the two wins. 1.x carried a directory of specialised fast paths that this implementation has no equivalent of. Recovering that ground is the largest single piece of unfinished engineering in the project.',
    href: '/benchmarks#against-1x',
  },
  {
    title: 'A recursive $ref stops after the first iteration',
    detail:
      'No required suite case covers it, so it does not show up in the conformance figure — but a depth like tree.child.name is not validated. It is a real gap, recorded rather than hidden behind a number.',
    href: '/json-schema#not-supported',
  },
  {
    title: 'The performance gate has a resolution',
    detail:
      'CI gates on the ratio between Luq and a hand-written validator in the same process. Measured against deliberate slowdowns, it catches a 35% regression and misses a 15% one. That floor is written down rather than assumed.',
    href: '/benchmarks#the-gate',
  },
];
---

<BaseLayout
  title="Roadmap"
  description="What has shipped in 2.0, what is measured as missing and named in the source, and why the 1.x universal-platform roadmap has been withdrawn."
>
  <Header />
  <MobileMenuOverlay navItems={navItems} />

  <main class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <!-- ================= Hero ================= -->
    <header class="mb-12">
      <p class="mb-2 text-label-large text-primary">2.0</p>
      <h1 class="mb-4 text-display-small text-on-surface">Roadmap</h1>
      <p class="max-w-3xl text-body-large text-on-surface-variant">
        This page carries no dates. Everything below is either measured and shipped, or measured as
        missing and named in the source — the version of this page that promised a
        <code>.luq</code> language by a quarter is gone, and
        <a class="text-primary underline underline-offset-2" href="#withdrawn">
          what happened to it is at the bottom
        </a>.
      </p>
    </header>

    <!-- ================= Shipped ================= -->
    <section id="shipped" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">What is in the box</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        A TypeScript validation library that takes a type you already wrote and lets you declare
        rules against its field paths. Each figure below is produced by a script in the repository
        and read back by CI.
      </p>

      <div class="grid gap-4 md:grid-cols-2">
        {
          shipped.map((item) => (
            <div class="md-card md-card-outlined flex flex-col p-6">
              <span class="md-icon mb-3 text-primary" aria-hidden="true">
                {item.icon}
              </span>
              <h3 class="mb-2 text-title-medium text-on-surface">{item.headline}</h3>
              <p class="mb-4 flex-1 text-body-medium text-on-surface-variant">{item.detail}</p>
              <a
                class="text-label-large text-primary underline underline-offset-2"
                href={item.href}
              >
                {item.linkLabel}
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ================= Named open work ================= -->
    <section id="open-work" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">What is not done</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        Each row is a real identifier in the repository. Every failing conformance case names the
        feature that would resolve it, from a closed string union — so a gap cannot be recorded
        without saying what closes it, and it cannot quietly disappear either: if a case starts
        passing while it is still listed, the build fails.
        <strong class="text-on-surface"> None of these is scheduled.</strong> They are listed so a
        reader can tell whether the thing they need is missing, not so anyone can plan around a date.
      </p>

      <div class="md-card md-card-outlined overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[46rem] border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline-variant text-label-large text-on-surface-variant">
                <th class="px-4 py-3 text-left font-medium">Named in the source as</th>
                <th class="px-4 py-3 text-right font-medium">Suite cases</th>
                <th class="px-4 py-3 text-left font-medium">What it would do</th>
              </tr>
            </thead>
            <tbody>
              {
                namedOpenWork.map((row) => (
                  <tr class="border-b border-outline-variant/60 last:border-0">
                    <td class="whitespace-nowrap px-4 py-3 align-top font-mono text-body-small text-on-surface">
                      {row.id}
                    </td>
                    <td class="px-4 py-3 text-right align-top font-mono text-on-surface">
                      {row.cases}
                    </td>
                    <td class="px-4 py-3 align-top text-body-small text-on-surface-variant">
                      {row.what}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <h3 class="mb-3 mt-8 text-title-large text-on-surface">Decided against, not pending</h3>
      <div class="md-card md-card-filled overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[46rem] border-collapse text-body-medium">
            <tbody>
              {
                decidedAgainst.map((row) => (
                  <tr>
                    <td class="whitespace-nowrap px-4 py-4 align-top font-mono text-body-small text-on-surface">
                      {row.id}
                    </td>
                    <td class="px-4 py-4 text-right align-top font-mono text-on-surface">
                      {row.cases}
                    </td>
                    <td class="px-4 py-4 align-top text-body-small text-on-surface-variant">
                      {row.what}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ================= Weaknesses ================= -->
    <section id="weaknesses" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">Where this release is weak</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        Not everything unfinished is a JSON Schema keyword. These are the things a reader deserves
        to know before adopting 2.0.
      </p>

      <div class="space-y-4">
        {
          knownWeaknesses.map((item) => (
            <div class="md-card md-card-outlined p-6">
              <h3 class="mb-2 text-title-medium text-on-surface">{item.title}</h3>
              <p class="mb-3 text-body-medium text-on-surface-variant">{item.detail}</p>
              <a
                class="text-label-large text-primary underline underline-offset-2"
                href={item.href}
              >
                See the numbers
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ================= Withdrawn ================= -->
    <section id="withdrawn" class="mb-12 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">
        The “universal platform” goal, withdrawn
      </h2>

      <div class="md-card md-card-outlined p-6">
        <p class="mb-4 text-body-medium text-on-surface-variant">
          1.x advertised a <code>.luq</code> DSL that would generate validators for other
          languages: database and cache adapters, endpoint definitions, a
          <code>luq generate --lang=java</code> command, OpenAPI emission. This page carried it with
          dated milestones. Those dates have since passed, and none of it shipped.
        </p>
        <blockquote class="mb-4 border-l-4 border-primary bg-surface-container-high py-3 pl-4 pr-3 text-body-medium text-on-surface">
          No part of it ships in this package and this release makes no claim about when it will.
          What is in the box is the TypeScript validation library described above.
        </blockquote>
        <p class="text-body-medium text-on-surface-variant">
          A roadmap whose dates have already elapsed is worse than no roadmap: it tells a reader
          something about the project that is not true. So the milestones are gone rather than
          moved, and nothing on this page has been given a new one. When something is built, it will
          appear in the list above with a measurement beside it.
        </p>
      </div>
    </section>

    <nav class="flex flex-wrap gap-3" aria-label="Related pages">
      <a class="md-button md-button-filled md-state-layer" href="/docs/getting-started">
        Get started
      </a>
      <a class="md-button md-button-tonal md-state-layer" href="/json-schema">
        JSON Schema conformance
      </a>
      <a
        class="md-button md-button-outlined md-state-layer"
        href="https://github.com/maroonedog/luq"
        target="_blank"
        rel="noopener noreferrer"
      >
        Follow on GitHub
      </a>
    </nav>
  </main>

  <Footer />
</BaseLayout>
