---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bundleSize } from '../data/bundle-size';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OnThisPage from '../components/OnThisPage.astro';
import { conformance } from '../data/conformance';
import { legacySpeedups } from '../data/legacy-speedups';
import { packageInfo } from '../data/package-info';
import { pluginObjectCount, pluginSubpathCount } from '../data/plugins';

/**
 * This page replaces the 1.x roadmap, which advertised a `.luq` universal-platform
 * DSL — @database adapters, @endpoint definitions, `luq generate --lang=java`,
 * OpenAPI emission — against dated milestones ("Coming Q1–Q3 2026", "Q4 2026 —
 * v1.0", "2027+"). Those dates have now passed with none of it shipped, so the
 * page is a record of what was promised and not delivered, so nothing here carries a
 * date, and nothing here is unmeasured.
 *
 * Sources:
 *   README.md                          what ships, and the withdrawal below
 *   docs/json-schema-conformance.md    the named open features and their case counts
 *   config/perf-baseline.json          the shapes this release is slower on
 *   config/size-budget.json            the bundle floor
 */

const shipped = [
  {
    icon: 'inventory_2',
    headline: `${pluginObjectCount} plugins across ${pluginSubpathCount} subpaths`,
    detail:
      'Every rule you can call is a plugin you imported by name. An unimported plugin is not merely absent at run time — its method does not typecheck.',
    href: '/plugins',
    linkLabel: 'Browse the catalogue',
  },
  {
    icon: 'schema',
    headline: `${conformance.percent}% of the Draft-07 suite`,
    detail:
      `${conformance.passingCases} of ${conformance.caseCount} required cases, with skipped cases counted as failures. A validator that always said yes would score ${conformance.trivialPercent}%; 1.x scored 57.70%.`,
    href: '/json-schema',
    linkLabel: 'See the breakdown',
  },
  {
    icon: 'compress',
    headline: `A ${bundleSize.coreOnly.gzip} gzipped floor`,
    detail:
      `That is Builder with zero plugins. 1.x charged ${bundleSize.legacyCoreGzip.toLocaleString('en-US')} B before you used anything. Adding the first six plugins costs about 148 B each.`,
    href: '/benchmarks#bundle-size',
    linkLabel: 'See the measurements',
  },
  {
    icon: 'lock',
    headline: 'CSP-safe, and checked',
    detail:
      `Zero occurrences of eval and new Function across all ${packageInfo.moduleCount} emitted modules, verified by a script and by the public-API smoke test. 1.x claimed this in its README while shipping a live new Function.`,
    href: '/benchmarks',
    linkLabel: 'How it is checked',
  },
  {
    icon: 'package_2',
    headline: `${packageInfo.exportKeyCount} export keys, every one resolving`,
    detail:
      `A scratch consumer typechecks all ${packageInfo.exportKeyCount} against the published declarations under both node16 and bundler resolution, and proves an unpublished subpath fails.`,
    href: '/docs/getting-started',
    linkLabel: 'Get started',
  },
  {
    icon: 'cable',
    headline: 'Standard Schema v1',
    detail:
      'toStandardSchema() on the @maroonedog/luq/standard-schema subpath, so anything that accepts a Standard Schema — tRPC, TanStack Form, Hono, t3-env — accepts a Luq validator. A subpath rather than part of build(), because carrying it on every validator costs 312 B gzipped.',
    href: '/docs/getting-started#standard-schema',
    linkLabel: 'How to use it',
  },
  {
    icon: 'account_tree',
    headline: 'Paths that name the real index',
    detail:
      'Declare items[*].productId and the issue you get back says items[1].productId. A path that does not exist on your type is a compile error, not a silent no-op.',
    href: '/docs/getting-started',
    linkLabel: 'Read the guide',
  },
];

/**
 * Every entry is a `expiresWith` value from test/json-schema/suite-skip-list.ts —
 * a closed string union, so a failing case cannot be recorded without naming the
 * thing that would fix it. The counts are the measured case counts. No dates:
 * none of these is scheduled.
 */
// Everything this page once listed as unsupported has been resolved. An
// empty table serves the reader less well than a record of what closed and
// how, so the same layout now lists that. The counts are the cases that were
// failing at the time.
const closedWork = [
  {
    id: 'External and remote $ref',
    cases: 57,
    what: 'Resolved against a map of documents the caller already has. Luq does not fetch: a URI written in a schema can never make the process open a socket, and conversion stays synchronous.',
  },
  {
    id: '__proto__ in a declared path',
    cases: 14,
    what: 'Declarable, and prototype pollution still unreachable — the writer uses Object.defineProperty, so __proto__ is a key rather than a setter. Conformance and safety turned out not to be a trade.',
  },
  {
    id: 'JSON pointer escaping',
    cases: 9,
    what: 'The whole fragment is percent-decoded before it is split, which is the order RFC 6901 §6 specifies.',
  },
  {
    id: 'Tuple items with additionalItems',
    cases: 6,
    what: 'A branch no longer re-follows the $ref that created it, so a $ref inside a tuple position produces rules instead of silently producing none.',
  },
  {
    id: 'null reaching a rule',
    cases: 5,
    what: 'Inside a sub-schema, null is a VALUE rather than an absence presence settles first. false, {"not":{}} and an enum without null all forbid null while saying nothing about type.',
  },
  {
    id: 'additionalProperties with patternProperties',
    cases: 3,
    what: 'The plugin takes the patterns as well as the declared keys, so it no longer over-rejects a key a pattern already matched.',
  },
  {
    id: 'Base URIs from $id, and anchors',
    cases: 3,
    what: 'A $ref is a URI reference, so resolution carries the base in force and an index of what a URI can name — not just the root document.',
  },
  {
    id: 'Code-point string length',
    cases: 2,
    what: 'minLength / maxLength count code points, not UTF-16 code units.',
  },
  {
    id: 'Second-hop $ref, and boolean sub-schemas',
    cases: 2,
    what: 'The same one-line fix as tuple items: the recursion guard was stopping itself.',
  },
];

const knownWeaknesses = [
  {
    title: 'Slower than 1.x on flat and nested shapes',
    detail:
      `Measured in one process: ${legacySpeedups.singleField} on one field, ${legacySpeedups.multiField} on three fields, ${legacySpeedups.nested} nested. Arrays (${legacySpeedups.array}) and JSON Schema (${legacySpeedups.jsonSchema}) are the two wins. 1.x carried a directory of specialised fast paths that this implementation has no equivalent of. Recovering that ground is the largest single piece of unfinished engineering in the project.`,
    href: '/benchmarks#against-1x',
  },
  {
    title: 'A recursive $ref is unrolled three times, and then stops',
    detail:
      'A mutually recursive schema has infinitely many declared paths, so the expansion is bounded. Unrolling further is exponential in the number of definitions in the cycle: a three-way cycle builds in 17 ms at one unroll, 55 ms at two, 538 ms at three and 9.3 s at four. Three is what the official corpus needs. Past that depth a document is not checked — the same silence as before, moved further out rather than removed.',
    href: '/json-schema#not-supported',
  },
  {
    title: 'The performance gate has a resolution',
    detail:
      'CI gates on the ratio between Luq and a hand-written validator in the same process. Measured against deliberate slowdowns, it catches a 35% regression and misses a 15% one. That floor is written down rather than assumed.',
    href: '/benchmarks#the-gate',
  },
];

// One entry per <section id> below, in page order. The ids already existed —
// this page's own hero links to #withdrawn — so none is renamed here.
// OnThisPage is hidden under xl.
const tableOfContents = [
  { id: 'shipped', title: 'What is in the box', level: 2 },
  { id: 'open-work', title: 'What used to be missing', level: 2 },
  { id: 'weaknesses', title: 'Where this release is weak', level: 2 },
  { id: 'withdrawn', title: 'The withdrawn goal', level: 2 },
];
---

<BaseLayout
  title="Project status"
  description="Where 2.0 stands: what has shipped and is measured, where the release is measurably weak, and why the 1.x universal-platform roadmap has been withdrawn."
>
  <Header />

  <div class="flex min-h-screen">
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <!-- ================= Hero ================= -->
    <header class="mb-12">
      <p class="mb-2 text-label-large text-primary">2.0</p>
      <h1 class="mb-4 text-on-surface">Project status</h1>
      <p class="max-w-3xl text-body-large text-on-surface-variant">
        Where 2.0 stands: what has shipped and is measured, what has closed since this page listed
        it as missing, where the release is still measurably weak — speed first — and why the 1.x{' '}
        <code>.luq</code> roadmap was{' '}
        <a class="text-primary underline underline-offset-2" href="#withdrawn">
          withdrawn rather than rescheduled
        </a>. Nothing here carries a date, and nothing here is unmeasured.
      </p>
    </header>

    <!-- ================= Shipped ================= -->
    <section id="shipped" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">What is in the box</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        A TypeScript validation library that takes a type you already wrote and lets you declare
        rules against its field paths. Each figure below is produced by a script in the repository
        and read back by CI.
      </p>

      <div class="grid gap-4 md:grid-cols-2">
        {
          shipped.map((item) => (
            <div class="md-card md-card-outlined flex flex-col p-6">
              <span class="md-icon mb-3 text-primary" aria-hidden="true">
                {item.icon}
              </span>
              <h3 class="mb-2 text-title-medium text-on-surface">{item.headline}</h3>
              <p class="mb-4 flex-1 text-body-medium text-on-surface-variant">{item.detail}</p>
              <a
                class="text-label-large text-primary underline underline-offset-2"
                href={item.href}
              >
                {item.linkLabel}
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ================= Named open work ================= -->
    <section id="open-work" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">What this page used to list as missing</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        Nine rows, and all nine are closed — the Draft-07 corpus now passes{' '}
        <strong class="text-on-surface">{conformance.passingCases} of {conformance.caseCount}</strong>. They are kept here rather than deleted,
        because a roadmap that only ever shows what is left tells you nothing about whether the
        things on it actually get done. The real remaining weaknesses are further down, and the
        first of them is speed.
      </p>

      <div class="md-card md-card-outlined overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[46rem] border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline-variant text-label-large text-on-surface-variant">
                <th class="px-4 py-3 text-left font-medium">What was missing</th>
                <th class="px-4 py-3 text-right font-medium">Suite cases</th>
                <th class="px-4 py-3 text-left font-medium">What closed it</th>
              </tr>
            </thead>
            <tbody>
              {
                closedWork.map((row) => (
                  <tr class="border-b border-outline-variant/60 last:border-0">
                    <td class="whitespace-nowrap px-4 py-3 align-top font-mono text-body-small text-on-surface">
                      {row.id}
                    </td>
                    <td class="px-4 py-3 text-right align-top font-mono text-on-surface">
                      {row.cases}
                    </td>
                    <td class="px-4 py-3 align-top text-body-small text-on-surface-variant">
                      {row.what}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <h3 class="mb-3 mt-8 text-title-large text-on-surface">
        A refusal that turned out not to be necessary
      </h3>
      <div class="md-card md-card-filled p-6">
        <p class="text-body-medium text-on-surface-variant">
          This page used to record <code>__proto__</code> in a declared path as decided against —
          refused on purpose, so prototype pollution stayed unreachable, and 14 suite cases lost on
          purpose with it. That was the wrong reading of the problem. Only ASSIGNMENT reaches{' '}
          <code>Object.prototype</code>'s setter; writing the key with{' '}
          <code>Object.defineProperty</code> creates an own property and touches nothing. The
          refusal is gone, the 14 cases pass, and{' '}
          <code>test/unit/path/prototype-pollution.test.ts</code> proves both halves — that{' '}
          <code>__proto__</code> is declarable, and that <code>Object.prototype</code> is still
          clean afterwards. Reverting the write back to an assignment makes it fail.
        </p>
      </div>
    </section>

    <!-- ================= Weaknesses ================= -->
    <section id="weaknesses" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">Where this release is weak</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        Not everything unfinished is a JSON Schema keyword. These are the things a reader deserves
        to know before adopting 2.0.
      </p>

      <div class="space-y-4">
        {
          knownWeaknesses.map((item) => (
            <div class="md-card md-card-outlined p-6">
              <h3 class="mb-2 text-title-medium text-on-surface">{item.title}</h3>
              <p class="mb-3 text-body-medium text-on-surface-variant">{item.detail}</p>
              <a
                class="text-label-large text-primary underline underline-offset-2"
                href={item.href}
              >
                See the numbers
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ================= Withdrawn ================= -->
    <section id="withdrawn" class="mb-12 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">
        The “universal platform” goal, withdrawn
      </h2>

      <div class="md-card md-card-outlined p-6">
        <p class="mb-4 text-body-medium text-on-surface-variant">
          1.x advertised a <code>.luq</code> DSL that would generate validators for other
          languages: database and cache adapters, endpoint definitions, a{' '}
          <code>luq generate --lang=java</code> command, OpenAPI emission. This page carried it with
          dated milestones. Those dates have since passed, and none of it shipped.
        </p>
        <blockquote class="mb-4 border-l-4 border-primary bg-surface-container-high py-3 pl-4 pr-3 text-body-medium text-on-surface">
          No part of it ships in this package and this release makes no claim about when it will.
          What is in the box is the TypeScript validation library described above.
        </blockquote>
        <p class="text-body-medium text-on-surface-variant">
          A roadmap whose dates have already elapsed is worse than no roadmap: it tells a reader
          something about the project that is not true. So the milestones are gone rather than
          moved, and nothing on this page has been given a new one. When something is built, it will
          appear in the list above with a measurement beside it.
        </p>
      </div>
    </section>

    <nav class="flex flex-wrap gap-3" aria-label="Related pages">
      <a class="md-button md-button-filled md-state-layer" href="/docs/getting-started">
        Get started
      </a>
      <a class="md-button md-button-tonal md-state-layer" href="/json-schema">
        JSON Schema conformance
      </a>
      <a
        class="md-button md-button-outlined md-state-layer"
        href="https://github.com/maroonedog/luq"
        target="_blank"
        rel="noopener noreferrer"
      >
        Follow on GitHub
      </a>
    </nav>
    </main>

    <OnThisPage tableOfContents={tableOfContents} />
  </div>

  <Footer />
</BaseLayout>
