---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CodeBlock from '../components/CodeBlock.astro';

/**
 * Sources for everything on this page:
 *
 *   docs/guide/standard-schema.md          the three decisions, what does not
 *                                          cross the boundary
 *   src/standard-schema/to-standard-schema.ts   the decisions, in the code
 *   examples/react-hook-form/              the resolver line, running
 *
 * The guide is the version-tracked copy; this page renders it. Every code
 * block that imports only from this package was executed against the built
 * package before it was written.
 *
 * The tRPC, Hono and TanStack Form blocks are the exception and are marked
 * `skip`: none of those packages is a dependency here, so what each one shows
 * is that consumer's own documented entry point for a Standard Schema with a
 * Luq validator in the slot. The page says as much rather than implying they
 * were run. react-hook-form is the one that is — examples/react-hook-form.
 */

const description =
  'Luq implements Standard Schema v1, so a Luq validator goes wherever a zod schema goes — tRPC, TanStack Form, Hono, react-hook-form. What crosses that boundary, and what does not.';

const standardExample = `import { Builder } from "@maroonedog/luq";
import { requiredPlugin } from "@maroonedog/luq/plugins/required";
import { stringMinPlugin } from "@maroonedog/luq/plugins/stringMin";
import { toStandardSchema } from "@maroonedog/luq/standard-schema";

type Account = { handle: string };

export const account = toStandardSchema(
  Builder()
    .use(requiredPlugin)
    .use(stringMinPlugin)
    .for<Account>()
    .v("handle", (b) => b.string.required().min(2))
    .build()
);

const outcome = account["~standard"].validate({ handle: "j" });

if (outcome.issues === undefined) {
  console.log(outcome.value.handle);
} else {
  for (const issue of outcome.issues) {
    console.log(issue.message, issue.path);
  }
}`;

// luq-example: with standardExample an excerpt that uses the validator built above
const stillAValidatorExample = `// toStandardSchema ADDS ~standard and takes nothing away, so the same value is
// still the validator. Nothing has to be given up to get the other face.
account.pick("handle").validate("j");
account.parse({ handle: "ada" });`;

// luq-example: skip — @trpc/server is not a dependency of the doc harness's scratch consumer
const trpcExample = `import { initTRPC } from "@trpc/server";
import { account } from "./account";

const t = initTRPC.create();

// .input() takes any Standard Schema, so it takes this one.
export const setHandle = t.procedure
  .input(account)
  .mutation(({ input }) => input.handle);`;

// luq-example: skip — hono and @hono/standard-validator are not dependencies of the doc harness's scratch consumer
const honoExample = `import { Hono } from "hono";
import { sValidator } from "@hono/standard-validator";
import { account } from "./account";

const app = new Hono().post("/account", sValidator("json", account), (c) =>
  c.json(c.req.valid("json"))
);`;

// luq-example: skip — @tanstack/react-form is not a dependency of the doc harness's scratch consumer
const tanstackExample = `import { useForm } from "@tanstack/react-form";
import { account } from "./account";

const form = useForm({
  defaultValues: { handle: "" },
  validators: { onChange: account },
});`;

// luq-example: skip — needs react and react-hook-form, which the doc harness's scratch consumer does not install
const resolverExample = `import { standardSchemaResolver } from "@hookform/resolvers/standard-schema";
import { useForm } from "react-hook-form";
import { signupSchema, type Signup } from "./signup-schema";

const { register, handleSubmit, formState } = useForm<Signup>({
  resolver: standardSchemaResolver(signupSchema),
});`;

const decisions = [
  {
    title: 'validate calls parse(), not validate()',
    body: "The spec's success result is { value: Output }, and Output is the value AFTER validation — so a transform has to be applied, and only parse() applies it. This is also why a normalize reaches the consumer: the tidied value is the one written back.",
    href: '/docs/getting-started',
    hrefLabel: 'normalize, in Getting started',
  },
  {
    title: 'It collects every issue',
    body: 'The library default is abortEarly: true; this seam turns it off. What consumes it is usually a form, and returning one issue at a time produces a UI where fixing an error reveals the next one. Callers who want the fast path use the validator directly.',
  },
  {
    title: 'InferInput is the type you wrote',
    body: 'It is the type given to .for<T>(), not a type inferred back out of a schema value. The name in an error message is the name you chose.',
  },
];
---

<BaseLayout title="Standard Schema" description={description}>
  <Header />

  <main class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-3xl">
      <p class="mb-3 text-label-large uppercase tracking-wide text-on-surface-variant">
        Interop
      </p>
      <h1 class="mb-6 text-on-surface">Standard Schema</h1>
      <p class="mb-6 text-body-large text-on-surface-variant">
        Luq implements <a
          class="text-primary underline underline-offset-2"
          href="https://standardschema.dev">Standard Schema v1</a
        >. Anything that accepts a Standard Schema over an object — tRPC,
        TanStack Form, Hono, react-hook-form — accepts a Luq validator wherever
        it accepts a zod schema.
      </p>
      <p class="mb-12 text-body-medium text-on-surface-variant">
        It is a subpath, not part of <code class="font-mono">build()</code>, so you
        import it and pay for it when you use it.
      </p>

      <h2 class="mb-4 text-headline-small text-on-surface">One import</h2>
      <CodeBlock code={standardExample} language="typescript" fileName="account.ts" />

      <p class="mb-4 mt-8 text-body-large text-on-surface-variant">
        What comes back is <strong class="text-on-surface">still the validator</strong>:{' '}
        <code class="font-mono">validate</code>, <code class="font-mono">parse</code>,{' '}
        <code class="font-mono">pick</code> and <code class="font-mono">pickAll</code>{' '}
        are all still there for the rest of the application.
      </p>
      <CodeBlock code={stillAValidatorExample} language="typescript" fileName="both-faces.ts" />

      <h2 class="mb-6 mt-12 text-headline-small text-on-surface">Where it plugs in</h2>

      <h3 class="mb-3 text-title-large text-on-surface">tRPC</h3>
      <CodeBlock code={trpcExample} language="typescript" fileName="router.ts" />

      <h3 class="mb-3 mt-8 text-title-large text-on-surface">Hono</h3>
      <CodeBlock code={honoExample} language="typescript" fileName="server.ts" />

      <h3 class="mb-3 mt-8 text-title-large text-on-surface">TanStack Form</h3>
      <CodeBlock code={tanstackExample} language="typescript" fileName="AccountForm.tsx" />

      <h2 class="mb-4 mt-12 text-headline-small text-on-surface">
        Three decisions the spec leaves open
      </h2>
      <div class="mb-12 grid gap-4">
        {
          decisions.map((decision) => (
            <div class="md-card md-card-filled p-6">
              <p class="mb-2 text-title-medium text-on-surface">{decision.title}</p>
              <p class="text-body-medium text-on-surface-variant">{decision.body}</p>
              {decision.href && (
                <p class="mt-3 text-body-medium">
                  <a class="text-primary underline underline-offset-2" href={decision.href}>
                    {decision.hrefLabel}
                  </a>
                </p>
              )}
            </div>
          ))
        }
      </div>

      <h2 class="mb-4 text-headline-small text-on-surface">
        What does not cross the boundary
      </h2>
      <p class="mb-12 text-body-large text-on-surface-variant">
        A Standard Schema issue carries <code class="font-mono">message</code> and{' '}
        <code class="font-mono">path</code>. Luq's own <code class="font-mono">code</code>{' '}
        and <code class="font-mono">severity</code> have no field in the spec and do
        not survive, so a consumer that switches on <code class="font-mono">issue.code</code>{' '}
        needs the validator rather than this face.
      </p>

      <p class="mb-12 text-body-large text-on-surface-variant">
        One shape does not fit at all.{' '}
        <code class="font-mono">toStandardSchema</code> is declared over{' '}
        <code class="font-mono">T extends object</code>, because{' '}
        <code class="font-mono">.for&lt;T&gt;()</code> is — so what it returns
        validates an object, never a bare string or number. A consumer that wants
        one schema per scalar has nothing to hand it: t3-env's{' '}
        <code class="font-mono">server</code> and{' '}
        <code class="font-mono">client</code> maps take a schema per environment
        variable, and an environment variable is a string.
      </p>

      <h2 id="react-hook-form" class="mb-4 text-headline-small text-on-surface">
        react-hook-form
      </h2>
      <p class="mb-4 text-body-large text-on-surface-variant">
        react-hook-form takes any Standard Schema, so the integration is one line.
      </p>
      <CodeBlock code={resolverExample} language="typescript" fileName="SignupForm.tsx" />
      <div class="md-card md-card-filled my-8 p-6">
        <p class="mb-3 text-body-medium text-on-surface-variant">
          Pair it with <code class="font-mono">normalize</code> and the payload
          reaching <code class="font-mono">handleSubmit</code> is already tidied —
          the name trimmed, the email lowercased, the number input's string turned
          into a number — with no <code class="font-mono">valueAsNumber</code> and
          no per-field <code class="font-mono">setValueAs</code>.
        </p>
        <p class="text-body-medium text-on-surface-variant">
          A running form is in <code class="font-mono">examples/react-hook-form</code>{' '}
          in the repository.
        </p>
      </div>

      <h2 class="mb-4 text-headline-small text-on-surface">
        Writing JSON Schema out
      </h2>
      <p class="mb-12 text-body-large text-on-surface-variant">
        <code class="font-mono">toStandardJsonSchema</code> is the same idea one
        step further: it attaches a <code class="font-mono">~standard.jsonSchema</code>{' '}
        converter as well, so the value satisfies both{' '}
        <code class="font-mono">StandardSchemaV1</code> and{' '}
        <code class="font-mono">StandardJSONSchemaV1</code>. The targets, what
        happens to a rule that cannot be expressed, and the ordering it needs are
        on <a class="text-primary underline underline-offset-2" href="/json-schema#emit"
          >the JSON Schema page</a
        >.
      </p>

      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href="/docs/getting-started"
          class="md-button md-button-filled md-state-layer md-focus-ring"
        >
          Get started
        </a>
        <a href="/json-schema" class="md-button md-button-outlined md-state-layer md-focus-ring">
          JSON Schema
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
