---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PluginCard from '../../components/PluginCard.astro';
import {
  PLUGIN_SLOTS,
  plugins,
  pluginObjectCount,
  pluginSubpathCount,
} from '../../data/plugins';

// src/data/plugins.ts is generated from docs/guide/plugin-reference.md (which
// is itself generated from the built package), cross-checked against
// config/plugin-catalog.lock.json, and every example in it is typechecked
// against src/. Nothing on this page is typed by hand.

const slotFilters = PLUGIN_SLOTS.map((slot) => ({
  slot,
  count: plugins.filter((plugin) => plugin.slots.includes(slot)).length,
}));

const extensionCount = plugins.filter((plugin) => plugin.tier === 'extension').length;
const isolatedCount = pluginObjectCount - extensionCount;

const quickStart = `import { Builder } from "@maroonedog/luq";
import { requiredPlugin } from "@maroonedog/luq/plugins/required";
import { stringMinPlugin } from "@maroonedog/luq/plugins/stringMin";

type Draft = { title: string };

const draftValidator = Builder()
  .use(requiredPlugin)
  .use(stringMinPlugin)
  .for<Draft>()
  .v("title", (b) => b.string.required().min(3))
  .build();

const result = draftValidator.validate({ title: "x" });

if (result.valid) {
  console.log(result.data.title);
} else {
  for (const issue of result.issues) {
    console.error(\`\${issue.path}: \${issue.message} (\${issue.code})\`);
  }
}`;
---

<BaseLayout
  title="Plugins"
  description={`Every rule Luq can apply is a plugin you import by name. ${pluginObjectCount} plugin objects across ${pluginSubpathCount} subpaths, generated from the built package.`}
>
  <Header />

  <main class="bg-surface pb-32">
    <section class="border-b border-outline-variant bg-surface-container">
      <div class="mx-auto max-w-screen-xl px-4 py-14 sm:px-6 lg:px-8">
        <h1 class="md-headline-large text-on-surface">Plugin catalogue</h1>
        <p class="md-body-large mt-3 max-w-3xl text-on-surface-variant">
          Every rule Luq can apply is a plugin you import by name. <code
            class="rounded-shape-xs bg-surface-container-highest px-1.5 py-0.5 font-mono text-[0.9em]"
            >.use()</code
          > puts one in{' '}
          <a class="text-primary underline underline-offset-2" href="/docs/core-concepts#plugins-are-the-vocabulary"
            >the builder's bag</a
          >.
        </p>

        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
          <div>
            <dt class="md-label-medium text-on-surface-variant">Plugin objects</dt>
            <dd class="md-headline-small text-primary">{pluginObjectCount}</dd>
          </div>
          <div>
            <dt class="md-label-medium text-on-surface-variant">Import subpaths</dt>
            <dd class="md-headline-small text-primary">{pluginSubpathCount}</dd>
          </div>
          <div>
            <dt class="md-label-medium text-on-surface-variant">Isolated tier</dt>
            <dd class="md-headline-small text-primary">{isolatedCount}</dd>
          </div>
          <div>
            <dt class="md-label-medium text-on-surface-variant">Extension tier</dt>
            <dd class="md-headline-small text-primary">{extensionCount}</dd>
          </div>
        </dl>

        <p class="md-body-small mt-6 max-w-3xl text-on-surface-variant">
          An <strong class="font-semibold text-on-surface">isolated</strong> plugin imports
          nothing but the plugin kit, the shared types and its own directory, so adding one
          pulls in none of the others. An <strong class="font-semibold text-on-surface"
            >extension</strong
          > plugin may also import the JSON Schema layer and other plugins' entry files —
          which is why <code class="font-mono">jsonSchemaFullFeature</code> bundles 49
          plugins on its own.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-screen-xl px-4 pt-10 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4 pb-4">
        <div>
          <h2 class="md-headline-small text-on-surface">Browse and pick</h2>
          <p class="md-body-medium mt-1 text-on-surface-variant">
            Tick the plugins you need; the builder skeleton writes itself.
          </p>
        </div>
        <!--
          The live region is the <p>, not the <span> inside it: a screen reader
          reads the whole region, so announcing the parent says "42 shown"
          rather than a bare "42". aria-atomic keeps the word attached.
        -->
        <p
          class="md-label-large text-on-surface-variant"
          aria-live="polite"
          aria-atomic="true"
        >
          <span id="visible-count">{pluginObjectCount}</span> shown
        </p>
      </div>

      <!--
        Sticky over the grid: 78 cards scroll past, and the search is the only
        thing that finds one. top-16 = 4rem = the 64dp app bar in
        `.md-top-app-bar`, which is itself sticky at z-40 — so this row parks
        directly beneath it and never covers it. bg-surface matches `main`, so
        cards disappear under it instead of showing through.
      -->
      <div
        class="sticky top-16 z-10 space-y-4 border-b border-outline-variant bg-surface py-4"
      >
        <div class="relative max-w-xl">
          <span
            class="md-icon md-icon-sm pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant"
            aria-hidden="true">search</span
          >
          <label class="sr-only" for="plugin-search">Search plugins</label>
          <input
            type="search"
            id="plugin-search"
            placeholder="Search by name, method or description"
            class="md-body-medium h-14 w-full rounded-shape-sm border border-outline bg-surface-container-low pl-12 pr-4 text-on-surface placeholder:text-on-surface-variant focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <div>
          <p class="md-label-large mb-2 text-on-surface-variant">Filter by slot</p>
          <!--
            Ten chips wrap to three rows on a phone, which would make the sticky
            row a quarter of the viewport. Below sm they scroll sideways in one
            row instead; from sm they wrap as before.
          -->
          <div
            class="-mx-1 flex flex-nowrap gap-2 overflow-x-auto px-1 py-0.5 sm:mx-0 sm:flex-wrap sm:overflow-x-visible sm:px-0"
            role="group"
            aria-label="Filter by slot"
          >
            <button
              type="button"
              class="md-chip md-state-layer slot-filter is-selected shrink-0"
              data-slot="all"
              aria-pressed="true">All {pluginObjectCount}</button
            >
            {
              slotFilters.map(({ slot, count }) => (
                <button
                  type="button"
                  class="md-chip md-state-layer slot-filter shrink-0"
                  data-slot={slot}
                  aria-pressed="false"
                >
                  {slot} {count}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div id="plugin-grid" class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {
          plugins.map((plugin) => (
            <div class="min-w-0" data-plugin-cell={plugin.symbol}>
              <PluginCard plugin={plugin} selectable={true} />
            </div>
          ))
        }
      </div>

      <p
        id="empty-state"
        class="md-body-large py-16 text-center text-on-surface-variant"
        role="status"
        hidden
      >
        No plugin matches that search.
      </p>
    </section>

    <!--
      Below the grid, not above it. A reader arrives here to find a plugin, and
      this section is reference for after they have one; keeping it is cheaper
      than cutting it, because the block is compiled by check:docs and states
      the result shape that nothing else on this page states.
    -->
    <section
      class="mx-auto mt-16 max-w-screen-xl border-t border-outline-variant px-4 pt-10 sm:px-6 lg:px-8"
    >
      <h2 class="md-headline-small text-on-surface">How a plugin is used</h2>
      <div class="mt-4 max-w-3xl">
        <CodeBlock code={quickStart} language="typescript" fileName="draft-validator.ts" />
      </div>
      <p class="md-body-medium mt-4 max-w-3xl text-on-surface-variant">
        The result shape, and the four members of the built object:{' '}
        <a class="text-primary underline underline-offset-2" href="/docs/api/validator"
          >the Validator page</a
        >.
      </p>
    </section>

    <!-- Extended FAB: opens the generated builder. MD3 level 3, pill shape. -->
    <button
      type="button"
      id="open-builder"
      class="md-state-layer md-focus-ring md-elevation-3 fixed bottom-6 right-6 z-40 inline-flex h-14 items-center gap-3 rounded-shape-lg bg-primary-container px-5 text-label-large text-on-primary-container"
    >
      <span class="md-icon" aria-hidden="true">code</span>{' '}
      Your builder{' '}
      <span
        id="selected-count"
        class="inline-flex h-6 min-w-6 items-center justify-center rounded-shape-full bg-primary px-2 text-label-medium text-on-primary"
        >0</span
      >
    </button>

    <dialog
      id="builder-dialog"
      class="md-elevation-3 w-[min(64rem,92vw)] rounded-shape-xl border border-outline-variant bg-surface-container-high p-0 text-on-surface backdrop:bg-scrim/[0.32]"
    >
      <div class="flex max-h-[86vh] flex-col">
        <header
          class="flex items-start justify-between gap-4 border-b border-outline-variant px-6 py-5"
        >
          <div class="min-w-0">
            <h2 class="md-headline-small text-on-surface">Your builder</h2>
            <p class="md-body-medium mt-1 text-on-surface-variant">
              One import per plugin — the root export deliberately ships none, so every
              line names its own subpath. Ticking a plugin also ticks the plugins its
              example chain calls.
            </p>
          </div>
          <button
            type="button"
            class="md-icon-button md-state-layer close-dialog"
            aria-label="Close"
          >
            <span class="md-icon" aria-hidden="true">close</span>
          </button>
        </header>

        <div class="min-w-0 flex-1 overflow-y-auto px-6 py-5">
          <div id="builder-code-slot" class="min-w-0"></div>
        </div>

        <footer class="flex flex-wrap gap-3 border-t border-outline-variant px-6 py-4">
          <button type="button" id="copy-builder" class="md-button md-button-filled md-state-layer">
            Copy
          </button>
          <button
            type="button"
            id="download-builder"
            class="md-button md-button-tonal md-state-layer"
          >
            Download .ts
          </button>
          <button type="button" id="clear-builder" class="md-button md-button-text md-state-layer">
            Clear selection
          </button>
        </footer>
      </div>
    </dialog>

    <dialog
      id="details-dialog"
      class="md-elevation-3 w-[min(52rem,92vw)] rounded-shape-xl border border-outline-variant bg-surface-container-high p-0 text-on-surface backdrop:bg-scrim/[0.32]"
    >
      <div class="flex max-h-[86vh] flex-col">
        <header
          class="flex items-start justify-between gap-4 border-b border-outline-variant px-6 py-5"
        >
          <div class="min-w-0">
            <h2 id="details-name" class="md-headline-small break-words text-on-surface"></h2>
            <p id="details-description" class="md-body-medium mt-1 text-on-surface-variant"></p>
          </div>
          <button
            type="button"
            class="md-icon-button md-state-layer close-dialog"
            aria-label="Close"
          >
            <span class="md-icon" aria-hidden="true">close</span>
          </button>
        </header>
        <div id="details-body" class="min-w-0 flex-1 space-y-6 overflow-y-auto px-6 py-5"></div>
      </div>
    </dialog>
  </main>

  <Footer />
</BaseLayout>

<script is:inline define:vars={{ plugins }}>
  const selected = new Set();

  const grid = document.getElementById('plugin-grid');
  const searchInput = document.getElementById('plugin-search');
  const visibleCount = document.getElementById('visible-count');
  const emptyState = document.getElementById('empty-state');
  const selectedCount = document.getElementById('selected-count');
  const builderDialog = document.getElementById('builder-dialog');
  const builderCodeSlot = document.getElementById('builder-code-slot');
  const detailsDialog = document.getElementById('details-dialog');

  const bySymbol = new Map(plugins.map((plugin) => [plugin.symbol, plugin]));

  let activeSlot = 'all';
  let searchTerm = '';

  const EMPTY_BUILDER = [
    '// Tick a plugin to start. Every rule you can call is a plugin you imported,',
    '// so this file grows only with what you actually use.',
  ].join('\n');

  // ---- code generation ----------------------------------------------------
  // Each plugin carries an example whose chain is typechecked against src/ by
  // docs-site/scripts/verify-plugin-examples.mjs, so what comes out of here
  // compiles.

  function uniqueLines(lines) {
    return [...new Set(lines)];
  }

  function collectImports(chosen) {
    const lines = ['import { Builder } from "@maroonedog/luq";'];
    for (const plugin of chosen) {
      lines.push(`import { ${plugin.symbol} } from "${plugin.subpath}";`);
      lines.push(...plugin.example.imports);
    }
    return uniqueLines(lines);
  }

  function collectPrelude(chosen) {
    const blocks = chosen
      .filter((plugin) => plugin.example.prelude.length > 0)
      .map((plugin) => plugin.example.prelude.join('\n'));
    return uniqueLines(blocks);
  }

  function collectDeclarations(chosen) {
    return uniqueLines(chosen.flatMap((plugin) => plugin.example.declarations));
  }

  function buildGeneratedCode() {
    if (selected.size === 0) return EMPTY_BUILDER;
    const chosen = plugins.filter((plugin) => selected.has(plugin.symbol));
    const preludeBlocks = collectPrelude(chosen);

    return [
      ...collectImports(chosen),
      '',
      ...(preludeBlocks.length > 0 ? [...preludeBlocks, ''] : []),
      'type YourType = {',
      ...collectDeclarations(chosen).map((line) => `  ${line}`),
      '};',
      '',
      'export const validator = Builder()',
      ...chosen.map((plugin) => `  .use(${plugin.symbol})`),
      '  .for<YourType>()',
      ...chosen.map(
        (plugin) => `  .v("${plugin.example.field}", (b) => b.${plugin.example.chain})`
      ),
      '  .build();',
      '',
      'export function check(payload: unknown): YourType | undefined {',
      '  const result = validator.validate(payload);',
      '  if (result.valid) return result.data;',
      '  for (const issue of result.issues) {',
      '    console.error(`${issue.path}: ${issue.message} (${issue.code})`);',
      '  }',
      '  return undefined;',
      '}',
    ].join('\n');
  }

  /** Replaces the node so BaseLayout's MutationObserver re-runs Prism. */
  function renderCode(container, code, fileName) {
    container.replaceChildren();
    const surface = document.createElement('div');
    surface.className = 'md-code-surface overflow-hidden';

    if (fileName) {
      const toolbar = document.createElement('div');
      toolbar.className = 'md-code-toolbar';
      const label = document.createElement('span');
      label.className = 'md-label-medium truncate';
      label.textContent = fileName;
      toolbar.appendChild(label);
      surface.appendChild(toolbar);
    }

    const pre = document.createElement('pre');
    pre.className = 'overflow-x-auto p-4';
    const codeElement = document.createElement('code');
    codeElement.className = 'language-typescript';
    codeElement.textContent = code;
    pre.appendChild(codeElement);
    surface.appendChild(pre);
    container.appendChild(surface);
  }

  /**
   * An example chain calls methods other plugins add, so ticking one plugin
   * ticks the plugins its chain needs. Selecting `arrayEach` without
   * `stringMin` would emit `.each((eb) => eb.string.min(1))` against a bag that
   * has no `.min()` — which is a compile error, not a runtime one.
   */
  function selectWithDependencies(symbol) {
    const plugin = bySymbol.get(symbol);
    if (plugin === undefined) return;
    selected.add(symbol);
    for (const used of plugin.example.uses) selected.add(used);
  }

  function syncCheckboxes() {
    for (const checkbox of document.querySelectorAll('.plugin-checkbox')) {
      checkbox.checked = selected.has(checkbox.dataset.pluginSymbol);
    }
  }

  function refreshBuilder() {
    selectedCount.textContent = String(selected.size);
    renderCode(builderCodeSlot, buildGeneratedCode(), 'validator.ts');
  }

  // ---- filtering ----------------------------------------------------------

  function matches(plugin) {
    const bySlot = activeSlot === 'all' || plugin.slots.includes(activeSlot);
    if (!bySlot) return false;
    if (searchTerm === '') return true;
    const haystack = [
      plugin.name,
      plugin.symbol,
      plugin.method,
      plugin.description,
      plugin.slots.join(' '),
    ]
      .join(' ')
      .toLowerCase();
    return haystack.includes(searchTerm);
  }

  function applyFilters() {
    let shown = 0;
    for (const cell of grid.querySelectorAll('[data-plugin-cell]')) {
      const plugin = bySymbol.get(cell.dataset.pluginCell);
      const visible = plugin !== undefined && matches(plugin);
      cell.hidden = !visible;
      if (visible) shown += 1;
    }
    visibleCount.textContent = String(shown);
    emptyState.hidden = shown > 0;
  }

  // ---- details ------------------------------------------------------------

  /** Descriptions carry Markdown backticks; render those spans as code. */
  function renderProse(target, text) {
    target.replaceChildren();
    text.split(/`([^`]+)`/).forEach((part, index) => {
      if (index % 2 === 0) {
        target.appendChild(document.createTextNode(part));
        return;
      }
      const code = document.createElement('code');
      code.className =
        'rounded-shape-xs bg-surface-container-highest px-1 py-0.5 font-mono text-[0.9em] text-on-surface';
      code.textContent = part;
      target.appendChild(code);
    });
  }

  function appendHeading(parent, text) {
    const heading = document.createElement('h3');
    heading.className = 'md-title-small mb-2 text-on-surface-variant';
    heading.textContent = text;
    parent.appendChild(heading);
  }

  function appendSignature(parent, plugin) {
    const section = document.createElement('section');
    appendHeading(section, 'Signature');
    const list = document.createElement('dl');
    list.className = 'space-y-2';
    if (plugin.parameters.length === 0) {
      const note = document.createElement('p');
      note.className = 'md-body-medium text-on-surface-variant';
      note.textContent = 'Takes no arguments.';
      section.appendChild(note);
    } else {
      for (const parameter of plugin.parameters) {
        const row = document.createElement('div');
        row.className = 'flex flex-wrap items-baseline gap-x-3 gap-y-1';
        const name = document.createElement('dt');
        name.className =
          'md-label-large rounded-shape-xs bg-surface-container-highest px-2 py-0.5 font-mono text-on-surface';
        name.textContent = parameter.name;
        const type = document.createElement('dd');
        type.className = 'md-body-medium font-mono text-on-surface-variant';
        type.textContent = `${parameter.type}${parameter.optional ? '  (optional)' : ''}`;
        row.append(name, type);
        list.appendChild(row);
      }
      section.appendChild(list);
    }
    parent.appendChild(section);
  }

  function appendChips(parent, heading, values) {
    const section = document.createElement('section');
    appendHeading(section, heading);
    const list = document.createElement('ul');
    list.className = 'flex flex-wrap gap-1.5';
    for (const value of values) {
      const item = document.createElement('li');
      item.className = 'md-chip md-chip-static md-label-medium h-7 px-3';
      item.textContent = value;
      list.appendChild(item);
    }
    section.appendChild(list);
    parent.appendChild(section);
  }

  function exampleSource(plugin) {
    const preludeBlock = plugin.example.prelude.join('\n');
    const symbols = [plugin.symbol, ...plugin.example.uses];
    return [
      `import { Builder } from "@maroonedog/luq";`,
      ...symbols.map((symbol) => {
        const owner = bySymbol.get(symbol);
        return `import { ${symbol} } from "${owner.subpath}";`;
      }),
      ...plugin.example.imports,
      '',
      ...(preludeBlock === '' ? [] : [preludeBlock, '']),
      'type Example = {',
      ...plugin.example.declarations.map((line) => `  ${line}`),
      '};',
      '',
      'const validator = Builder()',
      ...symbols.map((symbol) => `  .use(${symbol})`),
      '  .for<Example>()',
      `  .v("${plugin.example.field}", (b) => b.${plugin.example.chain})`,
      '  .build();',
    ].join('\n');
  }

  function showDetails(symbol) {
    const plugin = bySymbol.get(symbol);
    if (plugin === undefined) return;

    document.getElementById('details-name').textContent = `${plugin.name} — .${plugin.method}()`;
    renderProse(document.getElementById('details-description'), plugin.description);

    const body = document.getElementById('details-body');
    body.replaceChildren();

    appendChips(body, 'Slots', plugin.slots);
    appendSignature(body, plugin);
    appendChips(body, 'Tier', [plugin.tier]);

    const exampleSection = document.createElement('section');
    appendHeading(exampleSection, 'Example');
    const holder = document.createElement('div');
    holder.className = 'min-w-0';
    renderCode(holder, exampleSource(plugin), `${plugin.name}.ts`);
    exampleSection.appendChild(holder);
    body.appendChild(exampleSection);

    detailsDialog.showModal();
  }

  // ---- wiring -------------------------------------------------------------

  function flashLabel(button, message) {
    const original = button.textContent;
    button.textContent = message;
    window.setTimeout(() => {
      button.textContent = original;
    }, 1600);
  }

  function bind() {
    searchInput.addEventListener('input', (event) => {
      searchTerm = event.target.value.trim().toLowerCase();
      applyFilters();
    });

    for (const button of document.querySelectorAll('.slot-filter')) {
      button.addEventListener('click', () => {
        for (const other of document.querySelectorAll('.slot-filter')) {
          other.classList.remove('is-selected');
          other.setAttribute('aria-pressed', 'false');
        }
        button.classList.add('is-selected');
        button.setAttribute('aria-pressed', 'true');
        activeSlot = button.dataset.slot;
        applyFilters();
      });
    }

    for (const checkbox of document.querySelectorAll('.plugin-checkbox')) {
      checkbox.addEventListener('change', () => {
        const symbol = checkbox.dataset.pluginSymbol;
        if (checkbox.checked) selectWithDependencies(symbol);
        else selected.delete(symbol);
        syncCheckboxes();
        refreshBuilder();
      });
    }

    for (const button of document.querySelectorAll('.plugin-details-button')) {
      button.addEventListener('click', () => showDetails(button.dataset.pluginSymbol));
    }

    for (const button of document.querySelectorAll('.close-dialog')) {
      button.addEventListener('click', () => button.closest('dialog').close());
    }

    for (const dialog of [builderDialog, detailsDialog]) {
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }

    document.getElementById('open-builder').addEventListener('click', () => {
      refreshBuilder();
      builderDialog.showModal();
    });

    document.getElementById('copy-builder').addEventListener('click', (event) => {
      navigator.clipboard
        .writeText(buildGeneratedCode())
        .then(() => flashLabel(event.currentTarget, 'Copied'))
        .catch(() => flashLabel(event.currentTarget, 'Copy failed'));
    });

    document.getElementById('download-builder').addEventListener('click', () => {
      const blob = new Blob([buildGeneratedCode()], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = 'validator.ts';
      anchor.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('clear-builder').addEventListener('click', () => {
      selected.clear();
      syncCheckboxes();
      refreshBuilder();
    });
  }

  bind();
  applyFilters();
  refreshBuilder();
</script>

<style>
  /* Native <dialog> centring; the scrim colour comes from the backdrop utility. */
  dialog {
    margin: auto;
  }

  dialog::backdrop {
    background-color: rgb(0 0 0 / 0.32);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
