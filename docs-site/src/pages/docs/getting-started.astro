---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { bundleSize } from '../../data/bundle-size';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import { packageInfo } from '../../data/package-info';

// Every TypeScript block on this page was typechecked against the built
// package (dist/*.d.ts through package.json#exports) before it was pasted in.

const tsconfigExample = `{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "moduleResolution": "bundler" // or "node16"
  }
}`;

const basicUsageExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';

// The type you already have. Nothing is rewritten as a schema.
type User = {
  name: string;
  email: string;
  age: number;
};

const userValidator = Builder()   // 1. start — a function, not a constructor
  .use(requiredPlugin)            // 2. put plugins in the bag
  .use(stringMinPlugin)
  .use(stringEmailPlugin)
  .use(numberMinPlugin)
  .for<User>()                    // 3. name the type being validated
  .v('name', b => b.string.required().min(2))   // 4. declare each field
  .v('email', b => b.string.required().email())
  .v('age', b => b.number.required().min(18))
  .build();                       // 5. compile once, keep the validator

const result = userValidator.validate({
  name: 'John Doe',
  email: 'john@example.com',
  age: 25,
});

if (result.valid) {
  // \`data\` exists only on this branch — no cast, no non-null assertion.
  console.log(result.data.name);
} else {
  for (const issue of result.issues) {
    console.log(\`\${issue.path}: \${issue.message} (\${issue.code})\`);
  }
}`;

const buildReturnsExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type Profile = { name: string; bio: string };

const profileValidator = Builder()
  .use(requiredPlugin)
  .use(stringMinPlugin)
  .for<Profile>()
  .v('name', b => b.string.required().min(2))
  .v('bio', b => b.string.required())
  .build();

// The whole object, original values.
const whole = profileValidator.validate({ name: 'Jo', bio: 'b' });

// The whole object, transforms applied.
const parsed = profileValidator.parse({ name: 'Jo', bio: 'b' });

// One declared field, on its own.
const oneField = profileValidator.pick('name').validate('Jo');

// Several fields, returned keyed by the path you asked for.
const subset = profileValidator
  .pickAll(['name', 'bio'])
  .validate({ name: 'Jo', bio: 'b' });`;

const resultExample = `import { Builder } from '@maroonedog/luq';
import type { ValidationIssue } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';

type Note = { title: string; text: string };

const noteValidator = Builder()
  .use(requiredPlugin)
  .for<Note>()
  .v('title', b => b.string.required())
  .v('text', b => b.string.required())
  .build();

const result = noteValidator.validate({ title: 'Hi', text: '' });

export function describe(): string {
  if (result.valid) {
    // Reachable only here. \`data\` is typed as Note.
    return result.data.title;
  }
  // Every issue is { path, code, message, severity }.
  return result.issues
    .map((issue: ValidationIssue) => \`\${issue.path} \${issue.code} \${issue.severity}\`)
    .join(', ');
}`;

const parseExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { transformPlugin } from '@maroonedog/luq/plugins/transform';

type Signup = { email: string };

const signupValidator = Builder()
  .use(requiredPlugin)
  .use(transformPlugin)
  .for<Signup>()
  .v('email', b => b.string.required().transform(value => value.trim()))
  .build();

// -> "  a@b.com  " — validate() never changes your value.
const kept = signupValidator.validate({ email: '  a@b.com  ' });

// -> "a@b.com" — parse() applies transforms, and only to a field whose
// checks all passed.
const trimmed = signupValidator.parse({ email: '  a@b.com  ' });`;

const optionsExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type NameForm = { first: string; last: string };

const formValidator = Builder()
  .use(requiredPlugin)
  .use(stringMinPlugin)
  .for<NameForm>()
  .v('first', b => b.string.required().min(2))
  .v('last', b => b.string.required().min(2))
  .build();

const bad = { first: 'a', last: 'b' };

// Default: stop at the first field that fails -> 1 issue.
const short = formValidator.validate(bad);

// Every field, one representative issue each -> the form UX combination.
const perField = formValidator.validate(bad, { abortEarly: false });

// Every violation of every field.
const everything = formValidator.validate(bad, {
  abortEarly: false,
  abortEarlyOnEachField: false,
});`;

const defaultsExample = `import { Builder } from '@maroonedog/luq';
import { optionalPlugin } from '@maroonedog/luq/plugins/optional';

type Settings = { language?: string };

const settingsValidator = Builder()
  .use(optionalPlugin)
  .for<Settings>()
  // The third argument of .v() is a field configuration, never a rule.
  .v('language', b => b.string.optional(), { default: 'en' })
  .build();

// The default is substituted before any rule looks at the value, so validate()
// and parse() judge the same thing — but only parse() writes it back.
settingsValidator.parse({});     // { valid: true, data: { language: 'en' }, issues: [] }
settingsValidator.validate({});  // { valid: true, data: {}, issues: [] }`;

const nestedExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';
import { arrayMinLengthPlugin } from '@maroonedog/luq/plugins/arrayMinLength';

type Order = {
  customer: { name: string; address: { country: string } };
  lines: { sku: string; tags: string[] }[];
};

const orderValidator = Builder()
  .use(requiredPlugin)
  .use(stringMinPlugin)
  .use(arrayMinLengthPlugin)
  .for<Order>()
  .v('customer.name', b => b.string.required().min(2))
  .v('customer.address.country', b => b.string.required().min(2))
  .v('lines', b => b.array.required().minLength(1))
  .v('lines[*].sku', b => b.string.required().min(4))
  .v('lines[*].tags[*]', b => b.string.required().min(1))
  .build();

const rejected = orderValidator.validate(
  {
    customer: { name: 'Acme', address: { country: 'JP' } },
    lines: [{ sku: 'PROD', tags: ['a'] }, { sku: 'X', tags: ['b'] }],
  },
  { abortEarly: false }
);

// -> ["lines[1].sku"], never "lines[*].sku"
const failedPaths = rejected.issues.map(issue => issue.path);`;

const messagesExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type Account = { handle: string };

const accountValidator = Builder()
  .use(requiredPlugin)
  .use(stringMinPlugin)
  .for<Account>()
  .v('handle', b =>
    b.string.required().min(3, {
      code: 'handleTooShort',
      severity: 'warning',
      // The context carries this plugin's own members, typed.
      messageFactory: context =>
        \`\${context.path}: need \${String(context.min)}, got \${String(context.actual)}\`,
    })
  )
  .build();

accountValidator.validate({ handle: 'ab' });
// {
//   valid: true,
//   data: { handle: 'ab' },
//   issues: [{ path: 'handle', code: 'handleTooShort',
//              message: 'handle: need 3, got 2', severity: 'warning' }]
// }`;

const importsExample = `// The supported route: one subpath per plugin.
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

// The barrel also resolves, and is measurably free when a bundler can
// tree-shake: three plugins gzip to 7,986 B through it against 7,987 B
// through three subpaths — a difference of 1 byte, 0.01%.
import { stringEmailPlugin } from '@maroonedog/luq/plugins';`;

const standardSchemaExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';
import { toStandardSchema } from '@maroonedog/luq/standard-schema';

type Account = { handle: string };

const standard = toStandardSchema(
  Builder()
    .use(requiredPlugin)
    .use(stringMinPlugin)
    .for<Account>()
    .v('handle', (b) => b.string.required().min(2))
    .build()
);

// Still the Validator — validate, parse, pick and pickAll are all there —
// and now also a Standard Schema v1, so tRPC / TanStack Form / Hono / t3-env
// take it wherever they take a zod schema.
const outcome = standard['~standard'].validate({ handle: 'j' });

if (outcome.issues === undefined) {
  console.error(outcome.value.handle);
} else {
  for (const issue of outcome.issues) {
    console.error(issue.message, issue.path);
  }
}`;

const normalizeExample = `import { Builder } from "@maroonedog/luq";
import { requiredPlugin } from "@maroonedog/luq/plugins/required";
import { stringEmailPlugin } from "@maroonedog/luq/plugins/stringEmail";
import { numberMinPlugin } from "@maroonedog/luq/plugins/numberMin";

type Signup = { email: string; age: number };

const signupValidator = Builder()
  .use(requiredPlugin)
  .use(stringEmailPlugin)
  .use(numberMinPlugin)
  .for<Signup>()
  // A form posts "  Ada@Example.com  " — judge the tidied value.
  .v("email", (b) => b.string.required().email(), {
    normalize: (value) =>
      typeof value === "string" ? value.trim().toLowerCase() : value,
  })
  // A number input still hands over a string.
  .v("age", (b) => b.number.required().min(18), {
    normalize: (value) => (value === "" ? value : Number(value)),
  })
  .build();

// true — the rules saw "ada@example.com" and 30
signupValidator.validate({ email: "  Ada@Example.com  ", age: "30" } as never).valid;

// parse() writes the tidied values back; validate() leaves your object alone.
signupValidator.parse({ email: "  Ada@Example.com  ", age: "30" } as never);`;

const tableOfContents = [
  { id: 'installation', title: 'Installation', level: 2 },
  { id: 'typescript-configuration', title: 'TypeScript configuration', level: 3 },
  { id: 'the-five-calls', title: 'The five calls', level: 2 },
  { id: 'what-build-returns', title: 'What build() returns', level: 2 },
  { id: 'reading-the-result', title: 'Reading the result', level: 2 },
  { id: 'validate-vs-parse', title: 'validate() vs parse()', level: 2 },
  { id: 'options', title: 'Options', level: 2 },
  { id: 'defaults', title: 'Defaults', level: 2 },
  { id: 'normalize', title: 'Normalising before the rules run', level: 2 },
  { id: 'nested-fields-and-arrays', title: 'Nested fields and arrays', level: 2 },
  { id: 'messages-codes-and-severity', title: 'Messages, codes and severity', level: 2 },
  { id: 'importing-plugins', title: 'Importing plugins', level: 2 },
  { id: 'standard-schema', title: 'Standard Schema', level: 2 },
  { id: 'next-steps', title: 'Next steps', level: 2 },
];
---

<BaseLayout title="Getting started — Luq documentation">
  <Header />

  <div class="flex min-h-screen">
    <DocsSidebar currentPath="/docs/getting-started" tableOfContents={tableOfContents} />

    <main class="flex-1 px-4 py-8 pt-20 sm:px-6 lg:px-8 lg:pt-8">
      <article class="mx-auto max-w-4xl">
        <h1 class="text-headline-large">Getting started</h1>

        <p class="mt-4 text-body-large text-on-surface-variant">
          Luq takes a type you already wrote and lets you declare rules against its field
          paths. Every rule you can call is a plugin you imported by name.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          <div class="md-card md-card-filled p-4">
            <h2 class="text-title-medium">Type-first</h2>
            <p class="mt-1 text-body-medium text-on-surface-variant">
              <code>.for&lt;T&gt;()</code> names your own type. There is no second schema to
              keep in step with it.
            </p>
          </div>
          <div class="md-card md-card-filled p-4">
            <h2 class="text-title-medium">Plugins are imports</h2>
            <p class="mt-1 text-body-medium text-on-surface-variant">
              An unimported plugin's method does not typecheck. The builder alone gzips to{' '}
              {bundleSize.coreOnly.gzip}.
            </p>
          </div>
          <div class="md-card md-card-filled p-4">
            <h2 class="text-title-medium">One result shape</h2>
            <p class="mt-1 text-body-medium text-on-surface-variant">
              A discriminated union on <code>valid</code>. No result class, no
              <code>unwrap()</code> on the value.
            </p>
          </div>
        </div>

        <h2 id="installation" class="mt-12 text-headline-small">Installation</h2>

        <p class="mt-3 text-body-large">Version {packageInfo.version}.</p>

        <div class="mt-4">
          <div
            class="mb-4 flex gap-1 border-b border-outline-variant"
            role="tablist"
            aria-label="Package manager"
          >
            <button
              type="button"
              class="tab-button md-state-layer md-focus-ring is-active"
              data-tab="npm"
              role="tab"
              aria-selected="true"
            >
              npm
            </button>
            <button
              type="button"
              class="tab-button md-state-layer md-focus-ring"
              data-tab="yarn"
              role="tab"
              aria-selected="false"
            >
              yarn
            </button>
            <button
              type="button"
              class="tab-button md-state-layer md-focus-ring"
              data-tab="pnpm"
              role="tab"
              aria-selected="false"
            >
              pnpm
            </button>
          </div>

          <div class="tab-content" data-content="npm">
            <CodeBlock code={packageInfo.install} language="bash" />
          </div>
          <div class="tab-content" data-content="yarn" hidden>
            <CodeBlock code="yarn add @maroonedog/luq" language="bash" />
          </div>
          <div class="tab-content" data-content="pnpm" hidden>
            <CodeBlock code="pnpm add @maroonedog/luq" language="bash" />
          </div>
        </div>

        <h3 id="typescript-configuration" class="mt-8 text-title-large">
          TypeScript configuration
        </h3>

        <p class="mt-3 text-body-large">
          <code>strict</code> is not required. Every check below is a compile error either
          way — a slot that does not match the field, a missing <code>[*]</code>, a path the
          type does not declare, a method whose plugin you did not import. Luq is checked
          under <code>strict</code> too, so turning it on costs you nothing here and catches
          the rest of your code. <code>node16</code> and <code>bundler</code> resolution both
          work.
        </p>

        <CodeBlock code={tsconfigExample} language="json" fileName="tsconfig.json" />

        <h2 id="the-five-calls" class="mt-12 text-headline-small">The five calls</h2>

        <p class="mt-3 text-body-large">
          Every validator is the same five steps. <code>.use()</code> comes before
          <code>.for()</code>; nothing else has an order that matters.
        </p>

        <CodeBlock code={basicUsageExample} language="typescript" fileName="user.ts" />

        <div class="md-card md-card-outlined mt-6 p-5">
          <h3 class="text-title-medium">Build once, keep the validator</h3>
          <p class="mt-2 text-body-medium text-on-surface-variant">
            <code>build()</code> costs 14–662&nbsp;µs; <code>validate()</code> is
            sub-microsecond. Build at module scope, not per request.
          </p>
        </div>

        <h2 id="what-build-returns" class="mt-12 text-headline-small">
          What <code>build()</code> returns
        </h2>

        <p class="mt-3 text-body-large">
          An object with four members. It is <strong>not callable</strong>.
        </p>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline">
                <th class="py-2 pr-4 text-left text-title-small">Member</th>
                <th class="py-2 text-left text-title-small">What it gives back</th>
              </tr>
            </thead>
            <tbody class="text-on-surface-variant">
              <tr class="border-b border-outline-variant">
                <td class="py-2 pr-4 font-mono text-body-small text-on-surface">
                  validate(value, options?)
                </td>
                <td class="py-2"><code>ValidationResult&lt;T&gt;</code> holding the original value</td>
              </tr>
              <tr class="border-b border-outline-variant">
                <td class="py-2 pr-4 font-mono text-body-small text-on-surface">
                  parse(value, options?)
                </td>
                <td class="py-2">
                  <code>ValidationResult&lt;TParsed&gt;</code> holding the value after transforms
                </td>
              </tr>
              <tr class="border-b border-outline-variant">
                <td class="py-2 pr-4 font-mono text-body-small text-on-surface">pick(path)</td>
                <td class="py-2">a single-field validator for one declared path</td>
              </tr>
              <tr class="border-b border-outline-variant">
                <td class="py-2 pr-4 font-mono text-body-small text-on-surface">pickAll(paths)</td>
                <td class="py-2">
                  a validator returning exactly those paths, keyed by the path string
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <CodeBlock code={buildReturnsExample} language="typescript" />

        <h2 id="reading-the-result" class="mt-12 text-headline-small">Reading the result</h2>

        <p class="mt-3 text-body-large">
          A discriminated union on <code>valid</code> — every member is documented on
          <a class="text-primary underline underline-offset-2" href="/docs/api/validator#validation-result"
            >the validator API</a>.
        </p>

        <CodeBlock code={resultExample} language="typescript" />

        <p class="mt-4 text-body-large">
          <code>data</code> exists only on the success branch, so narrowing on
          <code>valid</code> replaces every cast. The default <code>code</code> is the
          plugin's own name — <code>required</code>, <code>stringMin</code>.
        </p>

        <p class="mt-4 text-body-large">
          Prefer exceptions? <code>@maroonedog/luq/result</code> gives you
          <code>unwrap()</code> and a <code>ValidationFailure</code> that carries
          <code>.issues</code> — see
          <a class="text-primary underline underline-offset-2" href="/docs/api/validator#result-subpath"
            >the validator API</a>.
        </p>

        <h2 id="validate-vs-parse" class="mt-12 text-headline-small">
          <code>validate()</code> vs <code>parse()</code>
        </h2>

        <p class="mt-3 text-body-large">
          <code>validate()</code> never changes your value; <code>parse()</code> applies
          <code>.transform()</code> rules. Why transforms run last, and what that does to
          the chain's type:
          <a class="text-primary underline underline-offset-2" href="/docs/core-concepts#validate-vs-parse"
            >core concepts</a
          >.
        </p>

        <CodeBlock code={parseExample} language="typescript" />

        <h2 id="options" class="mt-12 text-headline-small">Options</h2>

        <p class="mt-3 text-body-large">
          <code>abortEarly</code>, <code>abortEarlyOnEachField</code>, <code>external</code> —
          in full on
          <a class="text-primary underline underline-offset-2" href="/docs/api/validator#options"
            >the validator API</a>.
        </p>

        <CodeBlock code={optionsExample} language="typescript" />

        <div class="md-card md-card-outlined mt-6 border-error p-5">
          <h3 class="text-title-medium text-error">
            <code>abortEarly</code> defaults to <code>true</code>
          </h3>
          <p class="mt-2 text-body-medium text-on-surface-variant">
            Both flags default to <code>true</code>. Pass
            <code>{'{ abortEarly: false }'}</code> to collect every issue.
          </p>
        </div>

        <p class="mt-6 text-body-large">
          <code>external</code> is a pre-resolved bag that
          <code>@maroonedog/luq/plugins/fromContext</code> reads.
          <code>@maroonedog/luq/async</code> resolves promises and passes them in on it.
        </p>

        <h2 id="defaults" class="mt-12 text-headline-small">Defaults</h2>

        <CodeBlock code={defaultsExample} language="typescript" />

        <p class="mt-4 text-body-large">
          <code>applyDefaultToNull</code> defaults to <code>true</code>.
        </p>

        <h2 id="normalize" class="mt-12 text-headline-small">
          Normalising before the rules run
        </h2>

        <p class="mt-3 text-body-large">
          A form gives you a string in a number field and spaces around a name.
          <code>normalize</code> sits beside <code>default</code> in the same options object
          and tidies the value <em>before</em> anything judges it, so
          <code>validate()</code> and <code>parse()</code> never disagree about what they
          looked at.
        </p>

        <CodeBlock code={normalizeExample} language="typescript" />

        <p class="mt-4 text-body-large">
          It takes and returns <code>unknown</code> on purpose: the value has not been
          validated yet, and <code>"42"</code>&nbsp;→&nbsp;<code>42</code> is the point.
          <strong>It is never called with <code>undefined</code> or <code>null</code></strong>
          — so <code>(v) =&gt; String(v).trim()</code> cannot turn a missing field into the
          string <code>"undefined"</code> and sneak it past <code>required</code>. Absence is
          <code>default</code>'s job; <code>normalize</code> only sees a value that is there.
        </p>

        <p class="mt-4 text-body-large">
          The order is what makes the common case work:
          <code>"&nbsp;&nbsp;"</code>&nbsp;→ trim →
          <code>""</code>&nbsp;→ presence reads an empty string as missing →
          <code>required</code> fires.
        </p>

        <h2 id="nested-fields-and-arrays" class="mt-12 text-headline-small">
          Nested fields and arrays
        </h2>

        <p class="mt-3 text-body-large">
          Dots for nested fields, <code>[*]</code> for array elements; you declare
          <code>[*]</code> and the issue comes back with the real index. Every form:
          <a class="text-primary underline underline-offset-2" href="/docs/core-concepts#field-paths"
            >the path grammar</a
          >.
        </p>

        <CodeBlock code={nestedExample} language="typescript" />

        <h2 id="messages-codes-and-severity" class="mt-12 text-headline-small">
          Messages, codes and severity
        </h2>

        <p class="mt-3 text-body-large">
          Every plugin method takes the same trailing options object:
          <code>{'{ code?, messageFactory?, severity? }'}</code>. There is no
          <code>message: string</code> option anywhere — a constant message is
          <code>{'{ messageFactory: () => "..." }'}</code>.
        </p>

        <CodeBlock code={messagesExample} language="typescript" />

        <p class="mt-4 text-body-large">
          A non-<code>error</code> severity is reported <em>without</em> failing the result,
          so <code>issues</code> is worth reading on the success branch too.
        </p>

        <h2 id="importing-plugins" class="mt-12 text-headline-small">Importing plugins</h2>

        <CodeBlock code={importsExample} language="typescript" />

        <p class="mt-4 text-body-large">
          The root <code>@maroonedog/luq</code> entry exports no plugins at all, which is why
          the bare builder gzips to {bundleSize.coreOnly.gzip} and a plugin costs
          129–224&nbsp;B to add.
        </p>

        <h2 id="standard-schema" class="mt-12 text-headline-small">Standard Schema</h2>

        <p class="mt-3 text-body-large">
          Luq implements <a
            class="text-primary underline underline-offset-2"
            href="https://standardschema.dev">Standard Schema v1</a>, on the
