<style>
  /*
   * A scoped style block is compiled on its own, so Tailwind 4 has to be told
   * where the theme lives before `@apply` can resolve a utility. @reference
   * loads it for name resolution only and emits nothing.
   */
  @reference '../../styles/global.css';

  /* Inline code, on the MD3 container tone the design system reserves for it. */
  article :not(pre) > code {
    @apply rounded-shape-xs bg-surface-container-highest px-1.5 py-0.5 font-mono text-[0.875em] text-on-surface;
  }

  .tab-button {
    @apply relative rounded-t-shape-sm px-4 py-2 text-label-large text-on-surface-variant;
    @apply transition-colors duration-short-4 ease-standard;
  }

  .tab-button.is-active {
    @apply text-primary;
  }

  .tab-button.is-active::after {
    content: '';
    @apply absolute inset-x-0 bottom-0 h-0.5 rounded-shape-full bg-primary;
  }
</style>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-button');
  const tabContents = document.querySelectorAll<HTMLElement>('.tab-content');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.tab;

      tabButtons.forEach((one) => {
        const isActive = one === button;
        one.classList.toggle('is-active', isActive);
        one.setAttribute('aria-selected', String(isActive));
      });

      tabContents.forEach((content) => {
        content.hidden = content.dataset.content !== selected;
      });
    });
  });
</script>
