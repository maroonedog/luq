---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import OnThisPage from '../../components/OnThisPage.astro';

const tableOfContents = [
  { id: 'reading-a-result', title: 'Reading a result', level: 2 },
  { id: 'basic-patterns', title: 'Basic patterns', level: 2 },
  { id: 'nested-objects', title: 'Nested objects', level: 3 },
  { id: 'arrays', title: 'Arrays and collections', level: 3 },
  { id: 'presence', title: 'Presence and conditionals', level: 3 },
  { id: 'advanced-patterns', title: 'Advanced patterns', level: 2 },
  { id: 'transforms', title: 'Transforms and parse()', level: 3 },
  { id: 'cross-field', title: 'Rules that read another field', level: 3 },
  { id: 'custom-rules', title: 'One-off custom rules', level: 3 },
  { id: 'error-handling', title: 'Error handling', level: 2 },
  { id: 'form-errors', title: 'Errors for a form', level: 3 },
  { id: 'partial-validation', title: 'Validating part of an object', level: 3 },
  { id: 'performance', title: 'Performance patterns', level: 2 },
  { id: 'real-world', title: 'Real-world examples', level: 2 },
  { id: 'product', title: 'E-commerce product', level: 3 },
  { id: 'registration', title: 'User registration', level: 3 },
];

const readingResultExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';

type User = { name: string; email: string };

const userValidator = Builder()
  .use(requiredPlugin)
  .use(stringEmailPlugin)
  .for<User>()
  .v('name', b => b.string.required())
  .v('email', b => b.string.required().email())
  .build();

const result = userValidator.validate({ name: 'Ada', email: 'nope' });

if (result.valid) {
  // data exists on this branch only — narrowing, not a cast.
  console.log(result.data.email);
} else {
  for (const issue of result.issues) {
    // 'email: Invalid email: invalid format (stringEmail)'
    console.error(issue.path + ': ' + issue.message + ' (' + issue.code + ')');
  }
}`;

const nestedObjectsExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { objectPlugin } from '@maroonedog/luq/plugins/object';
import { oneOfPlugin } from '@maroonedog/luq/plugins/oneOf';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type UserProfile = {
  user: {
    name: string;
    email: string;
  };
  settings: {
    notifications: boolean;
    theme: 'light' | 'dark';
  };
};

export const profileValidator = Builder()
  .use(requiredPlugin)
  .use(objectPlugin)
  .use(oneOfPlugin)
  .use(stringEmailPlugin)
  .use(stringMinPlugin)
  .for<UserProfile>()
  // The container and its members are separate declarations.
  .v('user', b => b.object.required().object())
  .v('user.name', b => b.string.required().min(2))
  .v('user.email', b => b.string.required().email())
  .v('settings', b => b.object.required().object())
  .v('settings.notifications', b => b.boolean.required())
  .v('settings.theme', b => b.string.required().oneOf(['light', 'dark']))
  .build();`;

const arraysExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { arrayMinLengthPlugin } from '@maroonedog/luq/plugins/arrayMinLength';
import { arrayMaxLengthPlugin } from '@maroonedog/luq/plugins/arrayMaxLength';
import { arrayUniquePlugin } from '@maroonedog/luq/plugins/arrayUnique';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';

type Catalogue = {
  tags: string[];
  prices: number[];
  grid: number[][];
};

const catalogueValidator = Builder()
  .use(requiredPlugin)
  .use(arrayMinLengthPlugin)
  .use(arrayMaxLengthPlugin)
  .use(arrayUniquePlugin)
  .use(stringMinPlugin)
  .use(numberMinPlugin)
  .for<Catalogue>()
  // The array itself: length, uniqueness.
  .v('tags', b => b.array.required().minLength(1).maxLength(5).unique())
  // Every element of it.
  .v('tags[*]', b => b.string.required().min(2))
  .v('prices', b => b.array.required().minLength(1))
  .v('prices[*]', b => b.number.required().min(0))
  // [*] chains for nested arrays.
  .v('grid', b => b.array.required().minLength(1))
  .v('grid[*]', b => b.array.required())
  .v('grid[*][*]', b => b.number.required().min(0))
  .build();

const rejected = catalogueValidator.validate(
  { tags: ['ok', 'x'], prices: [1], grid: [[0]] },
  { abortEarly: false }
);

// ['tags[1]'] — the real index, not the wildcard.
export const failedPaths = rejected.issues.map(issue => issue.path);`;

const presenceExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { requiredIfPlugin } from '@maroonedog/luq/plugins/requiredIf';
import { optionalPlugin } from '@maroonedog/luq/plugins/optional';
import { nullablePlugin } from '@maroonedog/luq/plugins/nullable';
import { oneOfPlugin } from '@maroonedog/luq/plugins/oneOf';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type Ticket = {
  kind: 'bug' | 'other';
  reason?: string;
  closedAt: string | null;
};

const ticketValidator = Builder()
  .use(requiredPlugin)
  .use(requiredIfPlugin)
  .use(optionalPlugin)
  .use(nullablePlugin)
  .use(oneOfPlugin)
  .use(stringMinPlugin)
  .for<Ticket>()
  .v('kind', b => b.string.required().oneOf(['bug', 'other']))
  // requiredIf is a PRESENCE rule, not a check.
  .v('reason', b => b.string.requiredIf(root => root.kind === 'other').min(5))
  // .required() narrows out null as well as undefined, so say nullable.
  .v('closedAt', b => b.string.required().nullable())
  .build();

export const outcomes = [
  ticketValidator.validate({ kind: 'other', closedAt: null }),
  ticketValidator.validate({ kind: 'other', reason: 'ab', closedAt: null }),
  ticketValidator.validate({ kind: 'bug', closedAt: null }),
];`;

const transformExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { transformPlugin } from '@maroonedog/luq/plugins/transform';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type SignupForm = {
  email: string;
  age: string;   // an <input> only ever gives you a string
};

const signupValidator = Builder()
  .use(requiredPlugin)
  .use(transformPlugin)
  .use(stringEmailPlugin)
  .use(stringMinPlugin)
  .for<SignupForm>()
  // .email() runs on the ORIGINAL value. Transforms are always last.
  .v('email', b => b.string.required().email().transform(v => v.toLowerCase()))
  .v('age', b => b.string.required().min(1).transform(v => Number.parseInt(v, 10)))
  .build();

const input = { email: 'ADA@EXAMPLE.COM', age: '36' };

// { email: 'ADA@EXAMPLE.COM', age: '36' } — untouched.
export const checked = signupValidator.validate(input);

// { email: 'ada@example.com', age: 36 } — transformed.
export const parsed = signupValidator.parse(input);`;

const crossFieldExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { compareFieldPlugin } from '@maroonedog/luq/plugins/compareField';
import { stitchPlugin } from '@maroonedog/luq/plugins/stitch';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';

type Booking = {
  password: string;
  confirmPassword: string;
  minGuests: number;
  maxGuests: number;
};

export const bookingValidator = Builder()
  .use(requiredPlugin)
  .use(compareFieldPlugin)
  .use(stitchPlugin)
  .use(numberMinPlugin)
  .for<Booking>()
  .v('password', b => b.string.required())
  // One other path: compareField.
  .v('confirmPassword', b => b.string.required().compareField('password'))
  .v('minGuests', b => b.number.required().min(1))
  // Several paths, read together: stitch. The check runs exactly once.
  .v('maxGuests', b =>
    b.number.required().stitch(['minGuests'], (fields, value) => ({
      valid: typeof value === 'number' && value >= Number(fields.minGuests),
      message: 'maxGuests must not be below minGuests.',
    }))
  )
  .build();`;

const customExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { customPlugin } from '@maroonedog/luq/plugins/custom';

type Invoice = { amountCents: number };

export const invoiceValidator = Builder()
  .use(requiredPlugin)
  .use(customPlugin)
  .for<Invoice>()
  // The predicate takes the VALUE only, and runs exactly once.
  // To read another field, use compareField or stitch instead.
  .v('amountCents', b =>
    b.number.required().custom(amount => Number.isInteger(amount) && amount > 0, {
      code: 'positiveWholeAmount',
      messageFactory: context => context.path + ' must be a positive whole number of cents.',
    })
  )
  .build();`;

const formErrorsExample = `import { Builder } from '@maroonedog/luq';
import type { ValidationIssue } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type Signup = { email: string; password: string };

const signupValidator = Builder()
  .use(requiredPlugin)
  .use(stringEmailPlugin)
  .use(stringMinPlugin)
  .for<Signup>()
  .v('email', b => b.string.required().email())
  .v('password', b => b.string.required().min(8))
  .build();

function toFieldErrors(issues: readonly ValidationIssue[]): Record<string, string> {
  const errors: Record<string, string> = {};
  for (const issue of issues) {
    if (issue.severity !== 'error') continue;
    if (errors[issue.path] === undefined) errors[issue.path] = issue.message;
  }
  return errors;
}

// A form wants EVERY field's complaint, so turn abortEarly off.
export function checkSignup(input: unknown): Record<string, string> {
  const result = signupValidator.validate(input, { abortEarly: false });
  return result.valid ? {} : toFieldErrors(result.issues);
}`;

const partialExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type Registration = {
  email: string;
  displayName: string;
  billing: { postcode: string };
};

const registrationValidator = Builder()
  .use(requiredPlugin)
  .use(stringEmailPlugin)
  .use(stringMinPlugin)
  .for<Registration>()
  .v('email', b => b.string.required().email())
  .v('displayName', b => b.string.required().min(2))
  .v('billing.postcode', b => b.string.required().min(4))
  .build();

// One field, as the user types. Siblings are passed for cross-field rules.
const emailField = registrationValidator.pick('email');
export const emailLooksRight = emailField.validate('ada@example.com').valid;

// One wizard step. Returns exactly the named paths, keyed by the path string.
const stepOne = registrationValidator.pickAll(['email', 'displayName']);
const stepOneResult = stepOne.validate({
  email: 'ada@example.com',
  displayName: 'Ada',
  billing: { postcode: '' },   // not picked, so not checked
});

export const stepOneOk = stepOneResult.valid;`;

const reuseExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';

type User = { email: string };

// Build ONCE, at module scope.
export const userValidator = Builder()
  .use(requiredPlugin)
  .use(stringEmailPlugin)
  .for<User>()
  .v('email', b => b.string.required().email())
  .build();

declare function createUser(user: User): Promise<void>;

export async function handleCreate(body: unknown): Promise<number> {
  const result = userValidator.validate(body);
  if (!result.valid) return 400;
  await createUser(result.data);
  return 201;
}`;

const productExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { optionalPlugin } from '@maroonedog/luq/plugins/optional';
import { objectPlugin } from '@maroonedog/luq/plugins/object';
import { oneOfPlugin } from '@maroonedog/luq/plugins/oneOf';
import { arrayMaxLengthPlugin } from '@maroonedog/luq/plugins/arrayMaxLength';
import { arrayUniquePlugin } from '@maroonedog/luq/plugins/arrayUnique';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';
import { stringPatternPlugin } from '@maroonedog/luq/plugins/stringPattern';

type Product = {
  sku: string;
  name: string;
  priceCents: number;
  category: 'electronics' | 'clothing' | 'books';
  specifications: Record<string, string>;
  inStock: boolean;
  tags?: string[];
};

export const productValidator = Builder()
  .use(requiredPlugin)
  .use(optionalPlugin)
  .use(objectPlugin)
  .use(oneOfPlugin)
  .use(arrayMaxLengthPlugin)
  .use(arrayUniquePlugin)
  .use(numberMinPlugin)
  .use(stringMinPlugin)
  .use(stringPatternPlugin)
  .for<Product>()
  .v('sku', b => b.string.required().pattern(/^PROD-\\d{4}$/))
  .v('name', b => b.string.required().min(2))
  .v('priceCents', b => b.number.required().min(0))
  .v('category', b =>
    b.string.required().oneOf(['electronics', 'clothing', 'books'])
  )
  .v('specifications', b => b.object.required().object())
  .v('inStock', b => b.boolean.required())
  .v('tags', b => b.array.optional().maxLength(10).unique())
  .v('tags[*]', b => b.string.required().min(2))
  .strict()
  .build();`;

const registrationExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { optionalPlugin } from '@maroonedog/luq/plugins/optional';
import { booleanTruthyPlugin } from '@maroonedog/luq/plugins/booleanTruthy';
import { compareFieldPlugin } from '@maroonedog/luq/plugins/compareField';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';
import { stringMaxPlugin } from '@maroonedog/luq/plugins/stringMax';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';
import { stringPatternPlugin } from '@maroonedog/luq/plugins/stringPattern';

type UserRegistration = {
  username: string;
  email: string;
  password: string;
  confirmPassword: string;
  age: number;
  acceptsTerms: boolean;
  marketingOptIn?: boolean;
};

export const registrationValidator = Builder()
  .use(requiredPlugin)
  .use(optionalPlugin)
  .use(booleanTruthyPlugin)
  .use(compareFieldPlugin)
  .use(numberMinPlugin)
  .use(stringEmailPlugin)
  .use(stringMaxPlugin)
  .use(stringMinPlugin)
  .use(stringPatternPlugin)
  .for<UserRegistration>()
  .v('username', b =>
    b.string.required().min(3).max(20).pattern(/^[a-zA-Z0-9_]+$/, {
      messageFactory: () => 'Letters, numbers and underscore only.',
    })
  )
  .v('email', b => b.string.required().email())
  .v('password', b =>
    b.string.required().min(8).pattern(/^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)/, {
      messageFactory: () => 'Needs an upper case letter, a lower case letter and a digit.',
    })
  )
  // RuleOptions is always the LAST argument, after the plugin's own.
  // compareField takes an optional comparator second, so it lands third here.
  .v('confirmPassword', b =>
    b.string.required().compareField(
      'password',
      (value, target) => value === target,
      { messageFactory: () => 'The two passwords do not match.' }
    )
  )
  .v('age', b => b.number.required().min(13))
  // There is no .equals(); booleanTruthy gives .truthy().
  .v('acceptsTerms', b =>
    b.boolean.required().truthy({
      messageFactory: () => 'You must accept the terms.',
    })
  )
  .v('marketingOptIn', b => b.boolean.optional())
  .strict()
  .build();`;
---

<BaseLayout title="Examples & Patterns - Luq Documentation">
  <Header />

  <div class="flex min-h-screen">
    <DocsSidebar currentPath="/docs/examples" />

    <main class="flex-1 px-4 py-8 pt-20 sm:px-6 lg:px-8 lg:pt-8">
      <article class="mx-auto max-w-4xl">
        <p class="md-label-large mb-2 text-primary">Guide</p>
        <h1 class="md-headline-large mb-4">Examples &amp; patterns</h1>
        <p class="md-body-large mb-10 text-on-surface-variant">
          Working shapes, from a single field to a registration form. Every block on this page
          is a complete file: the imports are real subpaths and the chains compile against the
          published declarations.
        </p>

        <div class="prose max-w-none">
          <h2 id="reading-a-result">Reading a result</h2>

          <p>
            Start here, because it is what changed most from 1.x. A result is a plain
            discriminated union: check <code>valid</code>, and the compiler hands you
            <code>data</code> on the success branch and <code>issues</code> on both.
          </p>

          <CodeBlock code={readingResultExample} language="typescript" />

          <div class="not-prose md-card md-card-filled my-8 p-6">
            <h3 class="md-title-small mb-3 flex items-center gap-2">
              <span class="md-icon md-icon-sm" aria-hidden="true">info</span>
              Two defaults worth knowing before you read on
            </h3>
            <ul class="md-body-medium space-y-2 text-on-surface-variant">
              <li>
                <code>abortEarly</code> defaults to <strong>true</strong>: validation stops at
                the first field that produced an issue. Pass
                <code>&#123; abortEarly: false &#125;</code> when you want every field's complaint.
              </li>
              <li>
                An issue's <code>code</code> defaults to the <strong>plugin's name</strong> —
                <code>required</code>, <code>stringMin</code>, <code>stringEmail</code> — not
                to a constant like <code>REQUIRED</code>.
              </li>
            </ul>
          </div>

          <h2 id="basic-patterns">Basic patterns</h2>

          <h3 id="nested-objects">Nested objects</h3>

          <p>
            Dots go into plain objects. The container and its members are separate
            declarations, so you can require the object and constrain its fields
            independently.
          </p>

          <CodeBlock code={nestedObjectsExample} language="typescript" />

          <h3 id="arrays">Arrays and collections</h3>

          <p>
            <code>[*]</code> means every element. Declare the array and its elements
            separately: the array's own rules are length and uniqueness, the elements' rules
            are whatever their type allows. Chain <code>[*]</code> for nested arrays.
          </p>

          <CodeBlock code={arraysExample} language="typescript" />

          <div class="not-prose md-card md-card-filled my-8 p-6">
            <h3 class="md-title-small mb-3 flex items-center gap-2">
              <span class="md-icon md-icon-sm" aria-hidden="true">tag</span>
              Issue paths carry the real index
            </h3>
            <p class="md-body-medium text-on-surface-variant">
              You declare <code>'tags[*]'</code> and you get back
              <code>'tags[1]'</code>. A fixed index in the declaration —
              <code>'tags[0]'</code> — does not compile.
            </p>
          </div>

          <h3 id="presence">Presence and conditionals</h3>

          <p>
            <code>requiredIf</code> and <code>optionalIf</code> decide the field's
            <em>presence gate</em>; they are not checks that run in chain order. The
            consequence is visible: when the condition makes a field required and the value is
            missing, the rest of that field's chain does not run.
          </p>

          <CodeBlock code={presenceExample} language="typescript" />

          <div class="not-prose my-8 overflow-x-auto">
            <table class="w-full min-w-[36rem] text-left">
              <thead>
                <tr class="border-b border-outline">
                  <th class="md-title-small py-2 pr-4">Input</th>
                  <th class="md-title-small py-2">Issues on <code>reason</code></th>
                </tr>
              </thead>
              <tbody class="md-body-medium text-on-surface-variant">
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>&#123; kind: 'other' &#125;</code></td>
                  <td class="py-2">
                    one, code <code>requiredIf</code> — <code>min(5)</code> never runs
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4">
                    <code>&#123; kind: 'other', reason: 'ab' &#125;</code>
                  </td>
                  <td class="py-2">one, code <code>stringMin</code></td>
                </tr>
                <tr>
                  <td class="py-2 pr-4"><code>&#123; kind: 'bug' &#125;</code></td>
                  <td class="py-2">none</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p>
            Also note <code>closedAt</code>. <code>.required()</code> now narrows out
            <code>null</code> as well as <code>undefined</code>, and there is no
            <code>allowNull</code> option to pass — a nullable field says
            <code>.nullable()</code>.
          </p>

          <h2 id="advanced-patterns">Advanced patterns</h2>

          <h3 id="transforms">Transforms and parse()</h3>

          <p>
            Transforms run <strong>last</strong> and only in <code>parse()</code>. Chain
            position does not move them: <code>.email().transform(f)</code> and
            <code>.transform(f).email()</code> both check the original value.
          </p>

          <CodeBlock code={transformExample} language="typescript" />

          <h3 id="cross-field">Rules that read another field</h3>

          <p>
            A <code>custom</code> predicate takes the value only. Reading another field is
            <code>compareField</code>'s job for one path, or <code>stitch</code>'s for
            several.
          </p>

          <CodeBlock code={crossFieldExample} language="typescript" />

          <h3 id="custom-rules">One-off custom rules</h3>

          <p>
            When a rule is used once, the <code>custom</code> plugin is enough. A predicate
            that throws becomes a failed validation carrying the thrown message, not a crashed
            <code>validate()</code>.
          </p>

          <CodeBlock code={customExample} language="typescript" />

          <div class="not-prose md-card md-card-filled my-8 p-6">
            <h3 class="md-title-small mb-3 flex items-center gap-2">
              <span class="md-icon md-icon-sm" aria-hidden="true">extension</span>
              When it is worth a real plugin
            </h3>
            <p class="md-body-medium mb-4 text-on-surface-variant">
              If the rule wants its own chain method, its own message context, or its own slot
              list, write a plugin with <code>definePlugin</code> instead of repeating a
              predicate. The 1.x kit —
              <code>plugin(&#123; name, methodName, allowedTypes, category, impl &#125;)</code> —
              does not exist.
            </p>
            <a
              href="/docs/custom-plugins"
              class="md-button md-button-tonal md-state-layer md-focus-ring"
            >
              Writing a plugin
            </a>
          </div>

          <h2 id="error-handling">Error handling</h2>

          <h3 id="form-errors">Errors for a form</h3>

          <CodeBlock code={formErrorsExample} language="typescript" />

          <div
            class="not-prose my-8 rounded-shape-md bg-error-container p-6 text-on-error-container"
          >
            <h3 class="md-title-small mb-3 flex items-center gap-2">
              <span class="md-icon md-icon-sm" aria-hidden="true">block</span>
              The 1.x result API is gone
            </h3>
            <p class="md-body-medium">
              <code>result.isValid()</code>, <code>result.errors</code>,
              <code>result.unwrap()</code>, <code>result.map(...).unwrapOr(...)</code> — none
              of these exist. Write <code>result.valid</code> and <code>result.issues</code>;
              if you want the throwing form, <code>unwrap(result)</code> is a free function on
              <code>@maroonedog/luq/result</code>. The full mapping is on the
              <a href="/docs/api/validator#porting">Validator page</a>.
            </p>
          </div>

          <h3 id="partial-validation">Validating part of an object</h3>

          <p>
            <code>pick()</code> gives you one declared path; <code>pickAll()</code> gives you
            several, keyed by the path strings you asked for. Both run the compiled rules from
            the same validator, so there is no second declaration to keep in step.
          </p>

