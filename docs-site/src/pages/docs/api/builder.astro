---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DocsSidebar from '../../../components/DocsSidebar.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import OnThisPage from '../../../components/OnThisPage.astro';

const tableOfContents = [
  { id: 'overview', title: 'Overview', level: 2 },
  { id: 'builder', title: 'Builder()', level: 2 },
  { id: 'use', title: 'use(plugin)', level: 2 },
  { id: 'with-config', title: 'withConfig(config)', level: 2 },
  { id: 'for', title: 'for<T>()', level: 2 },
  { id: 'v', title: 'v(path, define, options?)', level: 2 },
  { id: 'field-paths', title: 'Field paths', level: 3 },
  { id: 'field-options', title: 'Field options', level: 3 },
  { id: 'strict', title: 'strict()', level: 2 },
  { id: 'extra-properties', title: 'Rejecting extra properties', level: 3 },
  { id: 'build', title: 'build()', level: 2 },
  { id: 'reusable-rules', title: 'Reusing a field rule', level: 2 },
  { id: 'signatures', title: 'Signatures', level: 2 },
  { id: 'removed', title: 'Removed since 1.x', level: 2 },
];

const shapeExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';

type User = {
  name: string;
  age: number;
};

const userValidator = Builder()          // 1. start
  .use(requiredPlugin)                   // 2. put plugins in the bag
  .use(stringMinPlugin)
  .use(numberMinPlugin)
  .for<User>()                           // 3. name the type
  .v('name', b => b.string.required().min(3))   // 4. declare fields
  .v('age', b => b.number.required().min(18))
  .build();                              // 5. get { validate, parse, pick, pickAll }

const result = userValidator.validate({ name: 'Ada', age: 36 });

export const accepted = result.valid;`;

const useExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';

type Draft = { title: string };

const draftValidator = Builder()
  .use(requiredPlugin)
  .for<Draft>()
  // .min(3) is not offered here: stringMinPlugin was never used.
  .v('title', b => b.string.required())
  .build();

export const isTitled = draftValidator.validate({ title: 'x' }).valid;`;

const withConfigExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';

type Row = { note: string };

export const rowValidator = Builder()
  .use(requiredPlugin)
  .withConfig({ defaultSeverity: 'warning' })
  .for<Row>()
  .v('note', b => b.string.required())
  .build();`;

const forExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';

type UserProfile = {
  name: string;
  preferences: {
    theme: 'light' | 'dark';
    notifications: boolean;
  };
};

export const profileValidator = Builder()
  .use(requiredPlugin)
  .for<UserProfile>()
  // 'preferences.theme' is offered by the type; 'preferences.colour' is not.
  .v('preferences.theme', b => b.string.required())
  .build();`;

const vExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type Order = {
  customer: { name: string };
  items: { productId: string }[];
};

const orderValidator = Builder()
  .use(requiredPlugin)
  .use(stringMinPlugin)
  .for<Order>()
  .v('customer.name', b => b.string.required().min(2))
  .v('items[*].productId', b => b.string.required().min(5))
  .build();

const rejected = orderValidator.validate({
  customer: { name: 'Acme' },
  items: [{ productId: 'PROD-1' }, { productId: 'X' }],
});

// -> ['items[1].productId'] — the real index, never 'items[*].productId'
export const failedPaths = rejected.issues.map(issue => issue.path);`;

const fieldOptionsExample = `import { Builder } from '@maroonedog/luq';
import { optionalPlugin } from '@maroonedog/luq/plugins/optional';

type Settings = {
  language: string;
  createdAt: number;
};

export const settingsValidator = Builder()
  .use(optionalPlugin)
  .for<Settings>()
  // A constant default.
  .v('language', b => b.string.optional(), { default: 'en' })
  // A factory default, and a null that is left alone.
  .v('createdAt', b => b.number.optional(), {
    default: () => Date.now(),
    applyDefaultToNull: false,
  })
  .build();`;

const strictExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';

type Account = {
  id: string;
  name: string;
  age: number;
};

export const accountValidator = Builder()
  .use(requiredPlugin)
  .use(stringMinPlugin)
  .use(numberMinPlugin)
  .for<Account>()
  .v('id', b => b.string.required())
  .v('name', b => b.string.required().min(2))
  .v('age', b => b.number.required().min(18))
  .strict()   // every leaf path is declared, so this returns the builder
  .build();`;

const strictFailureExample = `// Drop the .v('age', ...) line above and .strict() no longer returns a
// builder. It returns this instead, so .build() does not exist and the
// file does not compile:
//
//   MissingFieldsError<'age'> = {
//     luqError: 'missingFieldDeclarations';
//     message: 'Declare every leaf path, or drop .strict().';
//     missing: 'age';
//   }`;

const extraPropertiesExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { objectAdditionalPropertiesPlugin } from '@maroonedog/luq/plugins/objectAdditionalProperties';

type Envelope = {
  user: { name: string; age: number };
};

const envelopeValidator = Builder()
  .use(requiredPlugin)
  .use(objectAdditionalPropertiesPlugin)
  .for<Envelope>()
  // Second argument is a plain string array, not an options object.
  .v('user', b => b.object.required().additionalProperties(false, ['name', 'age']))
  .v('user.name', b => b.string.required())
  .v('user.age', b => b.number.required())
  .build();

const rejected = envelopeValidator.validate({
  user: { name: 'Ada', age: 36, nickname: 'A' },
});

export const accepted = rejected.valid;   // false`;

const buildExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type Profile = {
  email: string;
  displayName: string;
  bio: string;
};

const profileValidator = Builder()
  .use(requiredPlugin)
  .use(stringEmailPlugin)
  .use(stringMinPlugin)
  .for<Profile>()
  .v('email', b => b.string.required().email())
  .v('displayName', b => b.string.required().min(2))
  .v('bio', b => b.string.required())
  .build();

// build() returns an OBJECT. It is not callable.
const whole = profileValidator.validate({
  email: 'ada@example.com',
  displayName: 'Ada',
  bio: 'Analyst.',
});

const oneField = profileValidator.pick('displayName').validate('A');

const wizardStep = profileValidator
  .pickAll(['email', 'displayName'])
  .validate({ email: 'ada@example.com', displayName: 'Ada' });

export const outcomes = [whole.valid, oneField.valid, wizardStep.valid];`;

const reusableRuleExample = `import { createPluginRegistry, useField } from '@maroonedog/luq/field-rule';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';

type Contact = {
  email: string;
  backupEmail: string;
};

const registry = createPluginRegistry()
  .use(requiredPlugin)
  .use(stringEmailPlugin);

const emailRule = registry.createFieldRule<string>(
  b => b.string.required().email(),
  { name: 'email' }
);

// useField is a FREE FUNCTION taking the builder first.
const withEmail = useField(registry.toBuilder().for<Contact>(), 'email', emailRule);

export const contactValidator = useField(withEmail, 'backupEmail', emailRule).build();`;
---

<BaseLayout title="Builder API - Luq Documentation">
  <Header />

  <div class="flex min-h-screen">
    <DocsSidebar currentPath="/docs/api/builder" tableOfContents={tableOfContents} />

    <main class="flex-1 px-4 py-8 pt-20 sm:px-6 lg:px-8 lg:pt-8">
      <article class="mx-auto max-w-4xl">
        <p class="md-label-large mb-2 text-primary">API reference</p>
        <h1 class="md-headline-large mb-4">Builder</h1>
        <p class="md-body-large mb-10 text-on-surface-variant">
          <code>Builder()</code> is the one entry point. It has exactly three members —{' '}
          <code>use</code>, <code>withConfig</code> and <code>for</code> — and everything
          the library can do is reached by walking that chain to <code>build()</code>.
        </p>

        <div class="prose max-w-none">
          <h2 id="overview">Overview</h2>

          <p>
            The chain has five steps, and each one narrows the type of what comes next. Each
            narrowing is described under the method that performs it, below.
          </p>

          <CodeBlock code={shapeExample} language="typescript" fileName="the whole chain" />

          <div class="not-prose md-card md-card-filled my-8 p-6">
            <h3 class="md-title-small mb-3 flex items-center gap-2">
              <span class="md-icon md-icon-sm" aria-hidden="true">info</span>{' '}
              build() returns an object
            </h3>
            <p class="md-body-medium text-on-surface-variant">
              Not a function. Its four members are <code>validate</code>, <code>parse</code>,{' '}
              <code>pick</code> and <code>pickAll</code>, all covered on{' '}
              <a href="/docs/api/validator" class="text-primary underline">the Validator page</a>.
            </p>
          </div>

          <h2 id="builder">Builder()</h2>

          <p>
            A factory. It takes no arguments and returns a fresh builder carrying an empty
            plugin bag.
          </p>

          <h2 id="use">use(plugin)</h2>

          <p>
            Adds <strong>one</strong> plugin to the bag and returns the same builder object,
            typed with the plugin folded in. The signature is{' '}
            <code>use(plugin: AnyPlugin)</code> — there is no variadic form, so chain one
            call per plugin.
          </p>

          <CodeBlock code={useExample} language="typescript" />

          <div class="not-prose md-card md-card-filled my-8 p-6">
            <h3 class="md-title-small mb-3 flex items-center gap-2">
              <span class="md-icon md-icon-sm" aria-hidden="true">bolt</span>{' '}
              What use() does and does not do
            </h3>
            <ul class="md-body-medium space-y-2 text-on-surface-variant">
              <li>Registering the same plugin twice is first-wins, not an error.</li>
              <li>
                Two plugins claiming the same chain method is refused, rather than the later
                one silently overwriting the earlier as in 1.x.
              </li>
              <li>
                <code>use()</code> mutates and returns the receiver, so two branches off one
                builder share plugins. If you want an immutable base, use{' '}
                <a href="/docs/api/plugin-registry">a plugin registry</a>.
              </li>
              <li>Every <code>use()</code> must come before <code>for()</code>.</li>
            </ul>
          </div>

          <h2 id="with-config">withConfig(config)</h2>

          <p>
            A per-builder override of the process-wide defaults. It is merged once at{' '}
            <code>build()</code> and reaches every plugin as{' '}
            <code>RuleBuildContext.config</code>, so nothing reads a mutable global while
            validation runs and two builders configured differently keep their own settings
            forever.
          </p>

          <CodeBlock code={withConfigExample} language="typescript" />

          <div class="not-prose my-8 overflow-x-auto">
            <table class="w-full min-w-[40rem] text-left">
              <thead>
                <tr class="border-b border-outline">
                  <th class="md-title-small py-2 pr-4">Key</th>
                  <th class="md-title-small py-2 pr-4">Type</th>
                  <th class="md-title-small py-2">Default</th>
                </tr>
              </thead>
              <tbody class="md-body-medium text-on-surface-variant">
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>defaultSeverity</code></td>
                  <td class="py-2 pr-4"><code>'error' | 'warning' | 'info'</code></td>
                  <td class="py-2"><code>'error'</code></td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>messageKeyPrefix</code></td>
                  <td class="py-2 pr-4"><code>string</code></td>
                  <td class="py-2"><code>''</code></td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>toBooleanTruthyValues</code></td>
                  <td class="py-2 pr-4"><code>readonly string[]</code></td>
                  <td class="py-2"><code>['true', '1', 'yes', 'on']</code></td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>numberFormat</code></td>
                  <td class="py-2 pr-4">
                    <code>&#123; decimalSeparator, thousandSeparator &#125;</code>
                  </td>
                  <td class="py-2"><code>'.'</code> and <code>','</code></td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>dateFormat</code></td>
                  <td class="py-2 pr-4"><code>string</code></td>
                  <td class="py-2"><code>'YYYY-MM-DD'</code></td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>trimStrings</code></td>
                  <td class="py-2 pr-4"><code>boolean</code></td>
                  <td class="py-2"><code>false</code></td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>caseSensitive</code></td>
                  <td class="py-2 pr-4"><code>boolean</code></td>
                  <td class="py-2"><code>true</code></td>
                </tr>
                <tr>
                  <td class="py-2 pr-4"><code>customTransforms</code></td>
                  <td class="py-2 pr-4">
                    <code>Record&lt;string, (value: unknown) =&gt; unknown&gt;</code>
                  </td>
                  <td class="py-2"><code>&#123;&#125;</code></td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 id="for">for&lt;T&gt;()</h2>

          <p>
            Names the type being validated and hands back a field builder. From here on{' '}
            <code>v()</code>'s path argument is a union computed from <code>T</code>.
          </p>

          <CodeBlock code={forExample} language="typescript" />

          <h2 id="v">v(path, define, options?)</h2>

          <p>
            The one declaration mechanism. <code>path</code> is a literal string resolved
            against <code>T</code>, <code>define</code> receives the slot object and returns
            a chain, and the optional third argument configures the <em>field</em> — never a
            rule.
          </p>

          <h3 id="field-paths">Field paths</h3>

          <CodeBlock code={vExample} language="typescript" />

          <p>
            Dots for nested fields, <code>[*]</code> for array elements. Every form, with
            what each one means:{' '}
            <a href="/docs/core-concepts#field-paths">the path grammar</a>.
          </p>

          <p>
            No path enters an opaque leaf. <code>Date</code>, <code>RegExp</code>,{' '}
            <code>Map</code>, <code>Set</code>, <code>Promise</code>, <code>Error</code>, a
            buffer, a function and a class instance all stop the path, so{' '}
            <code>'when.getTime'</code> does not compile.
          </p>

          <h3 id="field-options">Field options</h3>

          <p>
            Two keys, both about the value the field starts from. The default is substituted
            before any rule looks at the value, so <code>validate()</code> and{' '}
            <code>parse()</code> judge the same thing — only <code>parse()</code> writes it
            back into the returned object.
          </p>

          <CodeBlock code={fieldOptionsExample} language="typescript" />

          <div class="not-prose my-8 overflow-x-auto">
            <table class="w-full min-w-[40rem] text-left">
              <thead>
                <tr class="border-b border-outline">
                  <th class="md-title-small py-2 pr-4">Key</th>
                  <th class="md-title-small py-2 pr-4">Type</th>
                  <th class="md-title-small py-2">Notes</th>
                </tr>
              </thead>
              <tbody class="md-body-medium text-on-surface-variant">
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>default</code></td>
                  <td class="py-2 pr-4">
                    <code>TValue | ((root: unknown) =&gt; TValue)</code>
                  </td>
                  <td class="py-2">
                    The factory form may read the object it is filling in.
                  </td>
                </tr>
                <tr>
                  <td class="py-2 pr-4"><code>applyDefaultToNull</code></td>
                  <td class="py-2 pr-4"><code>boolean</code></td>
                  <td class="py-2">
                    Defaults to <code>true</code>: a declared <code>null</code> is replaced.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 id="strict">strict()</h2>

          <p>
            A type-level obligation with no runtime effect. If every leaf path of{' '}
            <code>T</code> has been declared, <code>strict()</code> returns the builder and
            the chain carries on. If any is missing it returns a{' '}
            <code>MissingFieldsError</code> instead, which has no <code>build()</code>, so
            the file stops compiling and the error names the paths you forgot.
          </p>

          <CodeBlock code={strictExample} language="typescript" />
          <CodeBlock code={strictFailureExample} language="typescript" showCopy={false} />

          <p>
            It can sit anywhere in the chain, and you may keep adding rules after it.
          </p>

          <h3 id="extra-properties">Rejecting extra properties</h3>

          <p>
            <code>strict()</code> says nothing about properties that are not in the type.
            Rejecting those at run time is a rule, and it belongs to the{' '}
            <code>objectAdditionalProperties</code> plugin.
          </p>

          <CodeBlock code={extraPropertiesExample} language="typescript" />

          <h2 id="build">build()</h2>

          <p>
            Compiles the declarations into a plan once and returns a{' '}
            <code>Validator&lt;T&gt;</code>. Building is the expensive half, so build once at
            module scope and reuse the object —{' '}
            <a href="/benchmarks#build-cost">the measured cost per shape</a>.
          </p>

          <CodeBlock code={buildExample} language="typescript" />

          <div class="not-prose my-8 overflow-x-auto">
            <table class="w-full min-w-[40rem] text-left">
              <thead>
                <tr class="border-b border-outline">
                  <th class="md-title-small py-2 pr-4">Member</th>
                  <th class="md-title-small py-2">What it gives back</th>
                </tr>
              </thead>
              <tbody class="md-body-medium text-on-surface-variant">
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>validate(value, options?)</code></td>
                  <td class="py-2">
                    <code>ValidationResult&lt;T&gt;</code> holding the <strong>original</strong>{' '}
                    value.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>parse(value, options?)</code></td>
                  <td class="py-2">
                    <code>ValidationResult&lt;T&gt;</code> holding the value{' '}
                    <strong>after transforms</strong>.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>pick(path)</code></td>
                  <td class="py-2">A single-field validator for one declared path.</td>
                </tr>
                <tr>
                  <td class="py-2 pr-4"><code>pickAll(paths)</code></td>
                  <td class="py-2">
                    A validator returning exactly those paths, keyed by the path string.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <p>
            All four in detail: <a href="/docs/api/validator">the Validator page</a>.
          </p>

          <h2 id="reusable-rules">Reusing a field rule</h2>

          <p>
            The same chain used on several fields is a <code>FieldRule</code>, minted from{' '}
            <a href="/docs/api/plugin-registry">a plugin registry</a> and spliced in with{' '}
            <code>useField</code>.
          </p>

          <CodeBlock code={reusableRuleExample} language="typescript" />

          <h2 id="signatures">Signatures</h2>

          <div class="not-prose my-8 overflow-x-auto">
            <table class="w-full min-w-[44rem] text-left">
              <thead>
                <tr class="border-b border-outline">
                  <th class="md-title-small py-2 pr-4">Call</th>
                  <th class="md-title-small py-2 pr-4">Returns</th>
                  <th class="md-title-small py-2">Notes</th>
                </tr>
              </thead>
              <tbody class="md-body-medium text-on-surface-variant">
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>Builder()</code></td>
                  <td class="py-2 pr-4"><code>Builder&lt;&#123;&#125;&gt;</code></td>
                  <td class="py-2">Empty plugin bag.</td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>use(plugin)</code></td>
                  <td class="py-2 pr-4"><code>Builder&lt;B &amp; BagEntry&lt;P&gt;&gt;</code></td>
                  <td class="py-2">One plugin per call. Mutates the receiver.</td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>withConfig(config)</code></td>
                  <td class="py-2 pr-4"><code>Builder&lt;B&gt;</code></td>
                  <td class="py-2">Merged once, at <code>build()</code>.</td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>for&lt;T&gt;()</code></td>
                  <td class="py-2 pr-4"><code>FieldBuilder&lt;T, B, never&gt;</code></td>
                  <td class="py-2"><code>T extends object</code>.</td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>v(path, define, options?)</code></td>
                  <td class="py-2 pr-4">
                    <code>FieldBuilder&lt;T, B, TDeclared | K&gt;</code>
                  </td>
                  <td class="py-2">Declaration list grows in the type.</td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>strict()</code></td>
                  <td class="py-2 pr-4">
                    <code>FieldBuilder</code> or <code>MissingFieldsError</code>
                  </td>
                  <td class="py-2">Compile-time only.</td>
                </tr>
                <tr>
                  <td class="py-2 pr-4"><code>build()</code></td>
                  <td class="py-2 pr-4"><code>Validator&lt;T&gt;</code></td>
                  <td class="py-2">
                    <code>&#123; validate, parse, pick, pickAll &#125;</code>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 id="removed">Removed since 1.x</h2>

          <div class="not-prose my-8 overflow-x-auto">
            <table class="w-full min-w-[40rem] text-left">
              <thead>
                <tr class="border-b border-outline">
                  <th class="md-title-small py-2 pr-4">1.x</th>
                  <th class="md-title-small py-2">Now</th>
                </tr>
              </thead>
              <tbody class="md-body-medium text-on-surface-variant">
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>use(a, b, c)</code></td>
                  <td class="py-2">One plugin per <code>use()</code> call.</td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>builder.useField(path, rule)</code></td>
                  <td class="py-2">
                    <code>useField(builder, path, rule)</code> from{' '}
                    <code>@maroonedog/luq/field-rule</code>.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4">
                    <code>.field(path)</code>, <code>.strictOnEditor()</code>
                  </td>
                  <td class="py-2">
                    Gone. Use <code>.v()</code> and <code>.strict()</code>.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4">
                    <code>'items.name'</code>, <code>'items.*.name'</code>
                  </td>
                  <td class="py-2">Write <code>'items[*].name'</code>.</td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>'items[0].name'</code></td>
                  <td class="py-2">
                    A fixed index. Write <code>'items[*].name'</code>.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>'tags.length'</code></td>
                  <td class="py-2">
                    Use <code>.minLength()</code> / <code>.maxLength()</code> on{' '}
                    <code>'tags'</code>.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>.v(path, define, 'en')</code></td>
                  <td class="py-2">
                    The bare-value shorthand is gone. Write{' '}
                    <code>&#123; default: 'en' &#125;</code>.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4">
                    <code>&#123; description &#125;</code>, <code>&#123; deprecated &#125;</code>,{' '}
                    <code>&#123; metadata &#125;</code>
                  </td>
                  <td class="py-2">
                    Removed from field options. Only <code>default</code> and{' '}
                    <code>applyDefaultToNull</code> remain.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>registry.register(plugin)</code></td>
                  <td class="py-2">
                    <code>registry.use(plugin)</code>, and it is immutable.
                  </td>
                </tr>
                <tr>
                  <td class="py-2 pr-4"><code>Builder().fromJsonSchema(schema)</code></td>
                  <td class="py-2">
                    <code>fromJsonSchema(schema)</code>, a free function. See{' '}
                    <a href="/json-schema">JSON Schema</a>.
                  </td>
                </tr>
              </tbody>
            </table>
