---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DocsSidebar from '../../../components/DocsSidebar.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import OnThisPage from '../../../components/OnThisPage.astro';

const tableOfContents = [
  { id: 'overview', title: 'Overview', level: 2 },
  { id: 'subpath', title: 'The ./field-rule subpath', level: 2 },
  { id: 'create-plugin-registry', title: 'createPluginRegistry()', level: 2 },
  { id: 'immutability', title: 'use() is immutable here', level: 3 },
  { id: 'create-field-rule', title: 'createFieldRule', level: 2 },
  { id: 'standalone', title: 'Running a rule on its own', level: 3 },
  { id: 'rule-defaults', title: 'Field options travel with the rule', level: 3 },
  { id: 'use-field', title: 'useField(builder, path, rule)', level: 2 },
  { id: 'choosing', title: 'Field rule or pick()?', level: 2 },
  { id: 'signatures', title: 'Signatures', level: 2 },
  { id: 'removed', title: 'Changed since 1.x', level: 2 },
];

const overviewExample = `import { createPluginRegistry, useField } from '@maroonedog/luq/field-rule';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';

type Contact = {
  email: string;
  backupEmail: string;
};

// 1. A plugin bag that outlives any one builder.
const registry = createPluginRegistry()
  .use(requiredPlugin)
  .use(stringEmailPlugin);

// 2. One field's rules, named and reusable.
const emailRule = registry.createFieldRule<string>(
  b => b.string.required().email(),
  { name: 'email', description: 'A deliverable address' }
);

// 3. Spliced into a builder — twice, on two different paths.
const withEmail = useField(registry.toBuilder().for<Contact>(), 'email', emailRule);
export const contactValidator = useField(withEmail, 'backupEmail', emailRule).build();

// 4. And usable on its own, with no object around it.
export const standalone = emailRule.validate('ada@example.com').valid;`;

const immutabilityExample = `import { createPluginRegistry } from '@maroonedog/luq/field-rule';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringEmailPlugin } from '@maroonedog/luq/plugins/stringEmail';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';

const base = createPluginRegistry().use(requiredPlugin);

// Each branch gets its OWN registry. \`base\` is never touched.
const emails = base.use(stringEmailPlugin);
const numbers = base.use(numberMinPlugin);

export const baseNames = Object.keys(base.getPlugins());      // ['required']
export const emailNames = Object.keys(emails.getPlugins());   // ['required', 'stringEmail']
export const numberNames = Object.keys(numbers.getPlugins()); // ['required', 'numberMin']`;

const freeFunctionExample = `import { Builder } from '@maroonedog/luq';
import { createFieldRule } from '@maroonedog/luq/field-rule';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

// The builder comes FIRST. 1.x's shape was createFieldRule(define, options).
const slugRule = createFieldRule(
  Builder().use(requiredPlugin).use(stringMinPlugin),
  b => b.string.required().min(3),
  { name: 'slug' }
);

export const accepted = slugRule.validate('getting-started').valid;`;

const standaloneExample = `import { createPluginRegistry } from '@maroonedog/luq/field-rule';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { transformPlugin } from '@maroonedog/luq/plugins/transform';

const registry = createPluginRegistry().use(requiredPlugin).use(transformPlugin);

const trimmedRule = registry.createFieldRule<string>(
  b => b.string.required().transform(value => value.trim()),
  { name: 'trimmed' }
);

// validate() hands the value back untouched...
export const checked = trimmedRule.validate('  ada  ');

// ...parse() applies the transform, exactly as on a built validator.
export const parsed = trimmedRule.parse('  ada  ');

// Issues from a standalone rule are reported under the path 'value'.
export const paths = trimmedRule.validate(undefined).issues.map(issue => issue.path);`;

const ruleDefaultsExample = `import { createPluginRegistry, useField } from '@maroonedog/luq/field-rule';
import { optionalPlugin } from '@maroonedog/luq/plugins/optional';

type Settings = { language: string };

const registry = createPluginRegistry().use(optionalPlugin);

const languageRule = registry.createFieldRule<string>(
  b => b.string.optional(),
  { name: 'language', fieldOptions: { default: 'en' } }
);

// fieldOptions is carried to v()'s third argument, so the default applies
// standalone AND wherever the rule is spliced in.
export const settingsValidator = useField(
  registry.toBuilder().for<Settings>(),
  'language',
  languageRule
).build();`;

const useFieldExample = `import { Builder } from '@maroonedog/luq';
import { createPluginRegistry, useField } from '@maroonedog/luq/field-rule';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type Article = {
  title: string;
  slug: string;
};

const registry = createPluginRegistry().use(requiredPlugin).use(stringMinPlugin);

const slugRule = registry.createFieldRule<string>(
  b => b.string.required().min(3),
  { name: 'slug' }
);

// A rule may be spliced into ANY builder that carries at least its plugins.
// This builder carries them, so the call typechecks.
const articleValidator = useField(
  Builder()
    .use(requiredPlugin)
    .use(stringMinPlugin)
    .for<Article>()
    .v('title', b => b.string.required().min(2)),
  'slug',
  slugRule
).build();

export const accepted = articleValidator.validate({
  title: 'Field rules',
  slug: 'field-rules',
}).valid;`;

const typeArgumentExample = `// Naming the value type is what registry.createFieldRule is for:
//
//   registry.createFieldRule<string>(b => b.string.required().min(3))
//   -> FieldRule<string, B>,  and rule.validate(123) does not compile.
//
// The free createFieldRule(builder, define) has TWO type parameters and no
// default for the bag, so you cannot supply just the first. Called without
// type arguments it infers a LOOSE value type — rule.validate(123) compiles.
// Use the registry form whenever the rule's value type matters.`;
---

<BaseLayout title="Plugin Registry & Field Rules - Luq Documentation">
  <Header />

  <div class="flex min-h-screen">
    <DocsSidebar currentPath="/docs/api/plugin-registry" />

    <main class="flex-1 px-4 py-8 pt-20 sm:px-6 lg:px-8 lg:pt-8">
      <article class="mx-auto max-w-4xl">
        <p class="md-label-large mb-2 text-primary">API reference</p>
        <h1 class="md-headline-large mb-4">Plugin registry &amp; field rules</h1>
        <p class="md-body-large mb-10 text-on-surface-variant">
          Three exports on one subpath: an <strong>immutable</strong> plugin bag, one field's
          rules lifted out of every object, and the free function that splices such a rule
          back into a builder.
        </p>

        <div class="prose max-w-none">
          <h2 id="overview">Overview</h2>

          <p>
            A <code>FieldRule</code> is a <code>v()</code> callback that has been given a name
            and a plugin bag, and nothing else. It is deliberately <em>not</em> a validator of
            its own: everything it can do, it does by handing that callback to the ordinary
            builder. That is why a rule cannot produce anything a hand-written{' '}
            <code>v()</code> could not, and why it runs the same compiler, the same plan and
            the same runtime as every other field.
          </p>

          <CodeBlock code={overviewExample} language="typescript" fileName="the whole idea" />

          <h2 id="subpath">The ./field-rule subpath</h2>

          <p>
            1.x published these from the package root. They are on their own subpath now, so
            a project that never writes a reusable rule never pays for one.
          </p>

          <CodeBlock
            code={`import {
  createPluginRegistry,
  createFieldRule,
  useField,
} from '@maroonedog/luq/field-rule';

import type {
  PluginRegistry,
  FieldRule,
  FieldRuleDefine,
  FieldRuleOptions,
  FieldRuleSubject,
  ExtractFieldRuleValue,
} from '@maroonedog/luq/field-rule';`}
            language="typescript"
            showCopy={false}
          />

          <div
            class="not-prose my-8 rounded-shape-md bg-error-container p-6 text-on-error-container"
          >
            <h3 class="md-title-small mb-3 flex items-center gap-2">
              <span class="md-icon md-icon-sm" aria-hidden="true">block</span>{' '}
              Import specifiers that do not resolve
            </h3>
            <p class="md-body-medium">
              <code>@maroonedog/luq/core/registry</code>,{' '}
              <code>@maroonedog/luq/core</code> and <code>@maroonedog/luq/plugin</code> are
              not export keys and never were. The package has 84 keys:{' '}
              <code>.</code>, <code>./package.json</code>, <code>./result</code>,{' '}
              <code>./plugin-kit</code>, <code>./field-rule</code>, <code>./async</code>,{' '}
              <code>./plugins</code>, and 77 under <code>./plugins/</code>.
            </p>
          </div>

          <h2 id="create-plugin-registry">createPluginRegistry()</h2>

          <p>
            Returns an empty registry. Fill it with <code>use()</code>, mint rules with{' '}
            <code>createFieldRule()</code>, and get a fresh builder carrying the same plugins
            with <code>toBuilder()</code>.
          </p>

          <div class="not-prose my-8 overflow-x-auto">
            <table class="w-full min-w-[40rem] text-left">
              <thead>
                <tr class="border-b border-outline">
                  <th class="md-title-small py-2 pr-4">Member</th>
                  <th class="md-title-small py-2">What it does</th>
                </tr>
              </thead>
              <tbody class="md-body-medium text-on-surface-variant">
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>use(plugin)</code></td>
                  <td class="py-2">
                    Returns a <strong>new</strong> registry with the plugin added. First-wins
                    by name.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4">
                    <code>createFieldRule&lt;TValue&gt;(define, options?)</code>
                  </td>
                  <td class="py-2">
                    Mints a rule against this registry's plugins.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>toBuilder()</code></td>
                  <td class="py-2">
                    A <strong>fresh</strong> builder each call, carrying the same plugins.
                  </td>
                </tr>
                <tr>
                  <td class="py-2 pr-4"><code>getPlugins()</code></td>
                  <td class="py-2">
                    The plugins, indexed by name, frozen.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 id="immutability">use() is immutable here</h3>

          <p>
            This is the whole reason the registry still exists rather than being folded into
            the builder. <code>Builder().use()</code> mutates and returns the receiver, so two
            branches off one builder share plugins. A registry is meant to be a shared base
            that different teams branch, so its <code>use()</code> returns a new registry and
            leaves the receiver alone.
          </p>

          <CodeBlock code={immutabilityExample} language="typescript" />

          <div class="not-prose md-card md-card-filled my-8 p-6">
            <h3 class="md-title-small mb-3 flex items-center gap-2">
              <span class="md-icon md-icon-sm" aria-hidden="true">memory</span>{' '}
              What it costs
            </h3>
            <p class="md-body-medium text-on-surface-variant">
              A registry holds a thunk that replays <code>use()</code> onto a fresh builder,
              never a builder it hands out. Replaying is O(n) per branch, and it happens when
              you ask for a builder or mint a rule — not while validating.
            </p>
          </div>

          <h2 id="create-field-rule">createFieldRule</h2>

          <p>
            Two doors to the same thing. The registry method is the ergonomic one because it
            takes a single type argument; the free function is there when you already have a
            builder.
          </p>

          <CodeBlock code={freeFunctionExample} language="typescript" />
          <CodeBlock code={typeArgumentExample} language="typescript" showCopy={false} />

          <div class="not-prose my-8 overflow-x-auto">
            <table class="w-full min-w-[40rem] text-left">
              <thead>
                <tr class="border-b border-outline">
                  <th class="md-title-small py-2 pr-4">Option</th>
                  <th class="md-title-small py-2 pr-4">Type</th>
                  <th class="md-title-small py-2">Notes</th>
                </tr>
              </thead>
              <tbody class="md-body-medium text-on-surface-variant">
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>name</code></td>
                  <td class="py-2 pr-4"><code>string</code></td>
                  <td class="py-2">
                    Defaults to <code>'value'</code>. Documentation only; it is not the error
                    code.
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>description</code></td>
                  <td class="py-2 pr-4"><code>string</code></td>
                  <td class="py-2">Carried on the rule for tooling to read.</td>
                </tr>
                <tr>
                  <td class="py-2 pr-4"><code>fieldOptions</code></td>
                  <td class="py-2 pr-4">
                    <code>&#123; default?, applyDefaultToNull? &#125;</code>
                  </td>
                  <td class="py-2">
                    Handed to <code>v()</code>'s third argument wherever the rule lands.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 id="standalone">Running a rule on its own</h3>

          <p>
            A standalone rule is exactly{' '}
            <code
              >Builder().use(...).for&lt;&#123; value: TValue &#125;&gt;().v('value', define).build()</code
            >, built once at <code>createFieldRule()</code> time through the public entry
            point. So <code>validate</code> and <code>parse</code> mean the same thing they do
            on a full validator — and issues come back under the path{' '}
            <code>'value'</code>, because the rule is not attached to a place yet.
          </p>

          <CodeBlock code={standaloneExample} language="typescript" />

          <div class="not-prose md-card md-card-filled my-8 p-6">
            <h3 class="md-title-small mb-3 flex items-center gap-2">
              <span class="md-icon md-icon-sm" aria-hidden="true">history</span>{' '}
              1.x had a third execution semantics here
            </h3>
            <p class="md-body-medium text-on-surface-variant">
              Its <code>FieldRule.validate</code> called the validator's <code>check()</code>{' '}
              directly: it ignored <code>getErrorMessage</code>, ignored the null and
              undefined skips, used the plugin's name in place of its code, and re-executed
              your definition on every single call. None of that survives — there is one
              engine and one answer to "what does this rule mean".
            </p>
          </div>

          <h3 id="rule-defaults">Field options travel with the rule</h3>

          <CodeBlock code={ruleDefaultsExample} language="typescript" />

          <h2 id="use-field">useField(builder, path, rule)</h2>

          <p>
            A <strong>free function</strong>, and the builder is its first argument.{' '}
            <code>builder.useField(path, rule)</code> is gone: a second way to declare a field
            on the one entry point is how the registry grew into a parallel world in 1.x.{' '}
            <code>useField</code> is a caller of <code>.v()</code>, so there is still exactly
            one declaration mechanism.
          </p>

          <CodeBlock code={useFieldExample} language="typescript" />

          <div class="not-prose md-card md-card-filled my-8 p-6">
            <h3 class="md-title-small mb-3 flex items-center gap-2">
              <span class="md-icon md-icon-sm" aria-hidden="true">shield</span>{' '}
              The bag gate, and which implementation wins
            </h3>
            <ul class="md-body-medium space-y-2 text-on-surface-variant">
              <li>
                The rule's bag is written as the <strong>builder's</strong> bag. A rule minted
                from plugins the builder does not carry is rejected at the call site; a
                builder carrying more than the rule needs is fine.
              </li>
              <li>
                The chain is rebuilt from the <strong>builder's</strong> bag, not the
                registry's copy. If both register a plugin under one name, the builder's wins
                — one field may not run a different <code>required</code> from its
                neighbours.
              </li>
              <li>
                A rule cannot name a sibling field. Its root type is <code>unknown</code>, so{' '}
                <code>FieldPath&lt;unknown&gt;</code> is <code>never</code> and a{' '}
                <code>compareField</code> inside a reusable rule cannot compile against one
                root and be spliced into another.
              </li>
            </ul>
          </div>

          <h2 id="choosing">Field rule or pick()?</h2>

          <p>
            Both give you one field on its own. They answer different questions.
          </p>

          <div class="not-prose my-8 overflow-x-auto">
            <table class="w-full min-w-[40rem] text-left">
              <thead>
                <tr class="border-b border-outline">
                  <th class="md-title-small py-2 pr-4">Use</th>
                  <th class="md-title-small py-2">When</th>
                </tr>
              </thead>
              <tbody class="md-body-medium text-on-surface-variant">
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4">
                    <a href="/docs/api/validator#pick"><code>validator.pick(path)</code></a>
                  </td>
                  <td class="py-2">
                    You already have a validator and want one of <em>its</em> fields — form
                    field validation, a test on one path. It also passes siblings, so
                    cross-field rules work.
                  </td>
                </tr>
                <tr>
                  <td class="py-2 pr-4"><code>createFieldRule</code></td>
                  <td class="py-2">
                    The <em>same rules</em> belong on several paths, or in several validators,
                    and you want one definition and one name for them.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 id="signatures">Signatures</h2>

          <CodeBlock
            code={`// Abridged: type parameter constraints omitted for readability.

function createPluginRegistry(): PluginRegistry<{}>;

interface PluginRegistry<B> {
  use<P>(plugin: P): PluginRegistry<B & BagEntry<P>>;       // immutable
  createFieldRule<TValue>(
    define: FieldRuleDefine<TValue, B>,
    options?: FieldRuleOptions<TValue>
  ): FieldRule<TValue, B>;
  toBuilder(): Builder<B>;
  getPlugins(): Readonly<Record<string, AnyPlugin>>;
}

function createFieldRule<TValue, B>(
  builder: Builder<B>,
  define: FieldRuleDefine<TValue, B>,
  options?: FieldRuleOptions<TValue>
): FieldRule<TValue, B>;

function useField<T, B, TDeclared, K>(
  builder: FieldBuilder<T, B, TDeclared>,
  path: K,
  rule: FieldRule<ValueAtPath<T, K>, B>
): FieldBuilder<T, B, TDeclared | K>;

interface FieldRule<TValue, B> {
  readonly name: string;
  readonly description: string | undefined;
  readonly define: FieldRuleDefine<TValue, B>;
  readonly fieldOptions: FieldOptions<TValue> | undefined;
  validate<TInput extends TValue | null | undefined>(
    value: TInput,
    options?: ValidateOptions
  ): ValidationResult<TInput>;
  parse(
    value: TValue | null | undefined,
    options?: ValidateOptions
  ): ValidationResult<TValue>;
}`}
            language="typescript"
            showCopy={false}
          />

          <h2 id="removed">Changed since 1.x</h2>

          <div class="not-prose my-8 overflow-x-auto">
            <table class="w-full min-w-[40rem] text-left">
              <thead>
                <tr class="border-b border-outline">
                  <th class="md-title-small py-2 pr-4">1.x</th>
                  <th class="md-title-small py-2">Now</th>
                </tr>
              </thead>
              <tbody class="md-body-medium text-on-surface-variant">
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4">
                    <code>import &#123; createPluginRegistry &#125; from '@maroonedog/luq'</code>
                  </td>
                  <td class="py-2">
                    <code>from '@maroonedog/luq/field-rule'</code>
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>registry.register(plugin)</code></td>
                  <td class="py-2"><code>registry.use(plugin)</code></td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>builder.useField(path, rule)</code></td>
                  <td class="py-2"><code>useField(builder, path, rule)</code></td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>createFieldRule(define, options)</code></td>
                  <td class="py-2">
                    <code>createFieldRule(builder, define, options)</code>
                  </td>
                </tr>
                <tr class="border-b border-outline-variant">
                  <td class="py-2 pr-4"><code>ExtractFieldRuleType</code></td>
                  <td class="py-2"><code>ExtractFieldRuleValue</code></td>
                </tr>
                <tr>
                  <td class="py-2 pr-4">
                    <code>rule._getInternalValidators()</code>
                  </td>
                  <td class="py-2">
                    Gone. <code>rule.define</code> is the callback, typed.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="not-prose mt-12 grid gap-6 md:grid-cols-2">
            <a
              href="/docs/api/builder"
              class="md-card md-card-outlined md-state-layer md-focus-ring block p-6"
            >
              <h3 class="md-title-medium mb-2">Builder</h3>
              <p class="md-body-medium text-on-surface-variant">
                <code>use</code>, <code>for</code>, <code>v</code>, <code>strict</code>,{' '}
                <code>build</code>.
              </p>
            </a>

            <a
              href="/docs/custom-plugins"
              class="md-card md-card-outlined md-state-layer md-focus-ring block p-6"
            >
              <h3 class="md-title-medium mb-2">Writing a plugin</h3>
              <p class="md-body-medium text-on-surface-variant">
                When a rule needs to be a new chain method rather than a reusable chain.
              </p>
            </a>
          </div>
        </div>
      </article>
    </main>

    <OnThisPage tableOfContents={tableOfContents} />
  </div>

  <Footer />
</BaseLayout>

<style>
  /*
   * A scoped style block is compiled on its own, so Tailwind 4 has to be told
   * where the theme lives before `@apply` can resolve a utility. @reference
   * loads it for name resolution only and emits nothing.
   */
  @reference '../../../styles/global.css';

  .prose h2 {
    @apply mb-6 mt-12;
  }

  .prose h3 {
    @apply mb-4 mt-8;
  }
</style>
