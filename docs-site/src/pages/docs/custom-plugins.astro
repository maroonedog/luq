---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { bundleSize } from '../../data/bundle-size';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import OnThisPage from '../../components/OnThisPage.astro';

// Every TypeScript block on this page was typechecked against the built
// package. The block marked "does not compile" was checked the other way:
// it is required to be rejected, and it is.

const minimalExample = `import { definePlugin, check, PASS, fail } from '@maroonedog/luq/plugin-kit';
import type { Unchanged } from '@maroonedog/luq/plugin-kit';

export const evenPlugin = /*#__PURE__*/ definePlugin<{
  args: readonly [];                     // what the chain method takes
  out: Unchanged;                        // what happens to the chain afterwards
  context: { readonly actual: number };  // what messageFactory receives
}>()({
  name: 'even',                  // the default error code
  method: 'even',                // what you call: b.number.even()
  slots: ['number'] as const,    // where the method appears
  build: ctx =>
    check({
      code: ctx.code,
      messageFactory: ctx.messageFactory,
      severity: ctx.severity,
      run: value =>
        typeof value !== 'number' || value % 2 === 0
          ? PASS
          : fail({ actual: value }),
      describe: (_detail, messageContext) =>
        \`\${messageContext.path} must be even\`,
      buildMessageContext: detail => ({
        actual: typeof detail.actual === 'number' ? detail.actual : 0,
      }),
    }),
});`;

// luq-example: with minimalExample — puts the evenPlugin defined in the block above into the bag, so only the check is shown rather than repeating the plugin
const useExample = `import { Builder } from '@maroonedog/luq';

type Basket = { count: number };

// Your plugin goes in the bag exactly like a built-in one. Nothing about the
// 77 shipped plugins is privileged; they are written against this surface.
const basketValidator = Builder()
  .use(evenPlugin)
  .for<Basket>()
  .v('count', b => b.number.even())
  .build();`;

const signatureExample = `interface PluginSignature {
  readonly args: readonly unknown[];  // what the chain method takes
  readonly out: unknown;              // what happens to the chain afterwards
  readonly context: object;           // what messageFactory receives
}`;

// luq-example: must-fail — the out marker disagrees with build()'s return; compiling would make the page's claim false
const outMismatchExample = `import { definePlugin, check, PASS } from '@maroonedog/luq/plugin-kit';
import type { PresenceShift } from '@maroonedog/luq/plugin-kit';

export const broken = definePlugin<{
  args: readonly [];
  out: PresenceShift<'excludeMissing'>;
  context: Record<string, never>;
}>()({
  name: 'broken',
  method: 'broken',
  slots: ['string'] as const,
  // \`out\` demands a PresenceRule; this is a CheckRule.
  build: ctx =>
    check({
      code: ctx.code,
      severity: ctx.severity,
      run: () => PASS,
      describe: () => '',
      buildMessageContext: () => ({}),
    }),
});`;

const argumentsExample = `import {
  definePlugin,
  check,
  PluginArgumentError,
  PASS,
  fail,
  isString,
} from '@maroonedog/luq/plugin-kit';
import type { Unchanged } from '@maroonedog/luq/plugin-kit';

export interface PrefixContext {
  readonly prefix: string;
  readonly actual: string;
}

export const prefixPlugin = /*#__PURE__*/ definePlugin<{
  args: readonly [prefix: string];
  out: Unchanged;
  context: PrefixContext;
}>()({
  name: 'prefix',
  method: 'prefix',
  slots: ['string'] as const,
  build: (ctx, prefix) => {
    // A bad argument is a BUILD-time error, not a check that never fires.
    if (prefix.length === 0) {
      throw new PluginArgumentError(ctx.pluginName, 'prefix', prefix);
    }
    return check({
      code: ctx.code,
      messageFactory: ctx.messageFactory,
      severity: ctx.severity,
      // A wrong-typed value PASSES. The slot guard owns type and the presence
      // rules own null/undefined; re-deciding either duplicates the issue
      // under the wrong code.
      run: value =>
        !isString(value) || value.startsWith(prefix)
          ? PASS
          : fail({ expected: prefix, actual: value }),
      describe: (_detail, messageContext) =>
        \`\${messageContext.path} must start with \${prefix}\`,
      buildMessageContext: detail => ({
        prefix,
        actual: isString(detail.actual) ? detail.actual : '',
      }),
    });
  },
});`;

const transformOutExample = `import { Builder } from '@maroonedog/luq';
import { definePlugin, transform } from '@maroonedog/luq/plugin-kit';
import type {
  MessageContextExtra,
  SelfReader,
  TransformOut,
} from '@maroonedog/luq/plugin-kit';

// out: TransformOut => build() must return a TransformRule, and the chain
// method gets a FIXED signature the marker imposes:
//   <R>(map: (value) => R, options?) => chain whose type is now R
const mapPlugin = /*#__PURE__*/ definePlugin<{
  args: readonly [map: SelfReader<unknown>];
  out: TransformOut;
  context: MessageContextExtra;
}>()({
  name: 'map',
  method: 'map',
  slots: ['string', 'number'] as const,
  build: (_ctx, map) => transform(value => map(value)),
});

type Signup = { email: string };

const signupValidator = Builder()
  .use(mapPlugin)
  .for<Signup>()
  .v('email', b => b.string.map(value => value.trim().length))
  .build();

// Transforms run in parse() only, and only after every check on the field
// passed — never in validate().
signupValidator.parse({ email: '  a@b.com  ' });     // data: { email: 7 }
signupValidator.validate({ email: '  a@b.com  ' });  // data: { email: '  a@b.com  ' }`;

const presenceOutExample = `import { definePlugin, presence } from '@maroonedog/luq/plugin-kit';
import type { MessageContextExtra, PresenceShift } from '@maroonedog/luq/plugin-kit';

// out: PresenceShift<'excludeMissing'> => build() must return a PresenceRule,
// and the chain's type loses undefined and null.
export const mandatoryPlugin = /*#__PURE__*/ definePlugin<{
  args: readonly [];
  out: PresenceShift<'excludeMissing'>;
  context: MessageContextExtra;
}>()({
  name: 'mandatory',
  method: 'mandatory',
  slots: ['string'] as const,
  build: ctx =>
    presence({
      code: ctx.code,
      messageFactory: ctx.messageFactory,
      severity: ctx.severity,
      allowUndefined: false,
      allowNull: false,
      emptyStringIsMissing: true,
      describe: messageContext => \`\${messageContext.path} is mandatory\`,
      buildMessageContext: () => ({}),
    }),
});`;

const chainMarkerCallSiteExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';
import { arrayEachPlugin } from '@maroonedog/luq/plugins/arrayEach';
import { objectPropertyNamesPlugin } from '@maroonedog/luq/plugins/objectPropertyNames';
import { objectAdditionalPropertiesSchemaPlugin } from '@maroonedog/luq/plugins/objectAdditionalProperties';
import { unionGuardPlugin } from '@maroonedog/luq/plugins/unionGuard';

type Inventory = {
  skus: string[];
  quantities: Record<string, number>;
  code: string | number;
};

const inventoryValidator = Builder()
  .use(requiredPlugin)
  .use(stringMinPlugin)
  .use(numberMinPlugin)
  .use(arrayEachPlugin)
  .use(objectPropertyNamesPlugin)
  .use(objectAdditionalPropertiesSchemaPlugin)
  .use(unionGuardPlugin)
  .for<Inventory>()
  // ElementChain — the sub-chain's subject is one ELEMENT of the array.
  .v('skus', b => b.array.each(e => e.string.required().min(4)))
  // PropertyKeyChain — the subject is the property KEY, always a string.
  .v('quantities', b => b.object.propertyNames(k => k.string.min(2)))
  // PropertyValueChain — the subject is any property VALUE.
  .v('quantities', b => b.object.additionalPropertiesSchema(v => v.number.min(0)))
  // NarrowedChain — the subject is the value NARROWED by the guard.
  // \`out: GuardOut\` records the covered member in the chain's state, so
  // \`.build()\` does not exist until every union member is covered.
  .v('code', b =>
    b.union
      .guard(
        (value): value is string => typeof value === 'string',
        narrowed => narrowed.string.min(3)
      )
      .guard(
        (value): value is number => typeof value === 'number',
        narrowed => narrowed.number.min(1)
      )
  )
  .build();`;

const subChainExample = `import {
  definePlugin,
  branch,
  composite,
  PASS,
  fail,
  isArray,
} from '@maroonedog/luq/plugin-kit';
import type {
  ElementChain,
  MessageContextExtra,
  Unchanged,
} from '@maroonedog/luq/plugin-kit';

export const eachPlugin = /*#__PURE__*/ definePlugin<{
  args: readonly [element: ElementChain];
  out: Unchanged;
  context: MessageContextExtra;
}>()({
  name: 'each',
  method: 'each',
  slots: ['array'] as const,
  // WHICH positions carry a sub-chain cannot be recovered once the types are
  // erased — a NarrowedChain and a RootPredicate are both plain functions —
  // so the plugin declares it.
  subChainArguments: [0],
  build: (ctx, element) =>
    composite({
      code: ctx.code,
      messageFactory: ctx.messageFactory,
      severity: ctx.severity,
      // The user's callback ran ONCE, at build() time. What arrives here is a
      // compiled rule list.
      branches: [branch('element', element)],
      combine: runners => {
        const runner = runners[0];
        if (runner === undefined) return () => PASS;
        return (value, runContext) => {
          if (!isArray(value)) return PASS;
          // This loop walks VALUES, not rules. A plugin never loops over
          // rules itself: execution lives in exactly one place, the engine.
          for (let index = 0; index < value.length; index += 1) {
            const outcome = runner.run(value[index], runContext);
            if (!outcome.ok) return fail({ ...outcome.detail, index });
          }
          return PASS;
        };
      },
      describe: detail => \`Element \${String(detail.index)} failed\`,
      buildMessageContext: () => ({}),
    }),
});`;

const argumentMarkers = [
  { marker: 'FieldRef', callSite: 'FieldPath<TRoot> — a checked path literal', build: 'string' },
  { marker: 'FieldRefs', callSite: 'readonly FieldPath<TRoot>[]', build: 'readonly string[]' },
  { marker: 'RootPredicate', callSite: '(root: TRoot, item?) => boolean', build: '(root: unknown, item?) => boolean' },
  { marker: 'RootReader<R>', callSite: '(root: TRoot) => R', build: '(root: unknown) => R' },
  { marker: 'SelfReader<R>', callSite: '(value: TValue) => R', build: '(value: unknown) => R' },
  { marker: 'SelfGuard', callSite: '(value: TValue) => boolean', build: '(value: unknown) => boolean' },
  { marker: 'SelfValue', callSite: "TValue — the field's own type", build: 'unknown' },
  { marker: 'ElementChain', callSite: "(b) => chain over the array's element", build: 'readonly Rule[]' },
  { marker: 'NarrowedChain', callSite: '(b) => chain over the narrowed value', build: 'readonly Rule[]' },
  { marker: 'PropertyValueChain', callSite: '(b) => chain over any property value', build: 'readonly Rule[]' },
  { marker: 'PropertyKeyChain', callSite: '(b) => chain over the property key (a string)', build: 'readonly Rule[]' },
];

const outputMarkers = [
  { marker: 'Unchanged', returns: 'a Rule', chain: 'unchanged' },
  { marker: 'TransformOut', returns: 'a TransformRule', chain: "the map's return type" },
  { marker: 'GuardOut', returns: 'a Rule', chain: 'same type, one union member covered' },
  { marker: 'PresenceShift<K>', returns: 'a PresenceRule', chain: 'narrowed by K' },
];

const constructors = [
  { name: 'check', kind: 'a value test', runs: 'after presence, in declaration order' },
  { name: 'presence', kind: 'a presence policy', runs: 'before every check' },
  { name: 'gate', kind: 'should this field run at all', runs: 'before every check; reports nothing' },
  { name: 'transform', kind: 'rewrite the value', runs: 'in parse() only, after all checks pass' },
  { name: 'branch / composite', kind: 'label a rule list and combine sub-results', runs: 'as one check' },
  { name: 'fieldsBranch', kind: 'a rule list over named sibling fields', runs: 'as one check' },
  { name: 'recursive', kind: 're-enter a plan on a nested structure', runs: 'last' },
];

const buildContext = [
  { member: 'pluginName', is: "the plugin's own name" },
  { member: 'code', is: 'options.code ?? pluginName' },
  { member: 'messageFactory', is: 'options.messageFactory, typed with your context' },
  { member: 'severity', is: 'options.severity ?? config.defaultSeverity' },
  { member: 'config', is: 'the ResolvedGlobalConfig in effect for this builder' },
  { member: 'fieldPath', is: 'the path this rule is attached to' },
  { member: 'declaredSiblingKeys', is: 'the immediate child keys declared under it' },
];

const chainMarkers = [
  { marker: 'ElementChain', subject: 'one element of an array or tuple', example: 'arrayEach — b.array.each(e => …)' },
  { marker: 'NarrowedChain', subject: 'the value after a guard or condition narrowed it', example: 'unionGuard, conditionalSchema' },
  { marker: 'PropertyValueChain', subject: "an object's property value", example: 'objectAdditionalPropertiesSchema' },
  { marker: 'PropertyKeyChain', subject: "an object's property key, always a string", example: 'objectPropertyNames' },
];

const tableOfContents = [
  { id: 'the-shape-of-a-plugin', title: 'The shape of a plugin', level: 2 },
  { id: 'using-it', title: 'Using it', level: 2 },
  { id: 'the-signature-is-the-contract', title: 'The signature is the contract', level: 2 },
  { id: 'argument-markers', title: 'The 11 argument markers', level: 3 },
  { id: 'output-markers', title: 'The 4 output markers', level: 3 },
  { id: 'rule-constructors', title: 'The rule constructors', level: 2 },
  { id: 'arguments', title: 'Arguments, and rejecting bad ones', level: 2 },
  { id: 'rule-build-context', title: 'RuleBuildContext', level: 2 },
  { id: 'sub-chains', title: 'Sub-chains', level: 2 },
  { id: 'never-loop-over-rules', title: 'Never loop over rules', level: 3 },
  { id: 'isolation-and-naming', title: 'Isolation and naming', level: 2 },
  { id: 'next-steps', title: 'Next steps', level: 2 },
];
---

<BaseLayout title="Writing a plugin — Luq documentation">
  <Header />

  <div class="flex min-h-screen">
    <DocsSidebar currentPath="/docs/custom-plugins" tableOfContents={tableOfContents} />

    <main class="flex-1 px-4 py-8 pt-20 sm:px-6 lg:px-8 lg:pt-8">
      <article class="mx-auto max-w-4xl">
        <h1 class="text-headline-large">Writing a plugin</h1>

        <p class="mt-4 text-body-large text-on-surface-variant">
          A plugin is a value. It has four members, it is created by one function, and it
          imports one subpath: <code>@maroonedog/luq/plugin-kit</code>. The 77 plugins that
          ship with Luq are written against exactly this surface — nothing about them is
          privileged.
        </p>

        <h2 id="the-shape-of-a-plugin" class="mt-12 text-headline-small">
          The shape of a plugin
        </h2>

        <CodeBlock code={minimalExample} language="typescript" fileName="even.ts" />

        <div class="md-card md-card-outlined mt-6 p-5">
          <h3 class="text-title-medium">Why <code>definePlugin&lt;Sig&gt;()(spec)</code> is two calls</h3>
          <p class="mt-2 text-body-medium text-on-surface-variant">
            The signature is written explicitly; the identity strings are inferred as
            literals from the spec. That split is what lets <code>name</code>,{' '}
            <code>method</code> and <code>slots</code> stay literal types while{' '}
            <code>args</code>, <code>out</code> and <code>context</code> stay yours to declare.
            The <code>/*#__PURE__*/</code> annotation matters too: it lets a bundler that
            ignores <code>sideEffects: false</code> still drop a plugin nobody imported.
          </p>
        </div>

        <h2 id="using-it" class="mt-12 text-headline-small">Using it</h2>

        <CodeBlock code={useExample} language="typescript" />

        <h2 id="the-signature-is-the-contract" class="mt-12 text-headline-small">
          The signature is the contract
        </h2>

        <CodeBlock code={signatureExample} language="typescript" />

        <p class="mt-4 text-body-large">
          <code>args</code> and <code>out</code> are written with <strong>markers</strong> —
          brands meaning "resolve this into the right thing at the call site, and into the
          right thing inside <code>build()</code>". A marker is never a value you construct;
          it only ever appears in a type position.
        </p>

        <h3 id="argument-markers" class="mt-8 text-title-large">The 11 argument markers</h3>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline">
                <th class="py-2 pr-4 text-left text-title-small">Marker</th>
                <th class="py-2 pr-4 text-left text-title-small">The call site writes</th>
                <th class="py-2 text-left text-title-small"><code>build()</code> receives</th>
              </tr>
            </thead>
            <tbody class="text-on-surface-variant">
              {
                argumentMarkers.map((row) => (
                  <tr class="border-b border-outline-variant">
                    <td class="py-2 pr-4 font-mono text-body-small text-on-surface">
                      {row.marker}
                    </td>
                    <td class="py-2 pr-4 font-mono text-body-small">{row.callSite}</td>
                    <td class="py-2 font-mono text-body-small">{row.build}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-body-large">
          Note the asymmetry, because it is the point: the caller writes typed things and{' '}
          <code>build()</code> receives erased things. A plugin cannot see the root type, so it
          cannot depend on it, so one plugin works for every type. Markers also nest —{' '}
          <code>readonly ElementChain[]</code> (a tuple's positions) and{' '}
          <code>Readonly&lt;Record&lt;string, NarrowedChain&gt;&gt;</code> (a key set, as{' '}
          <code>patternProperties</code> needs) both resolve, element by element and key by key.
        </p>

        <h3 id="output-markers" class="mt-8 text-title-large">The 4 output markers</h3>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline">
                <th class="py-2 pr-4 text-left text-title-small"><code>out</code></th>
                <th class="py-2 pr-4 text-left text-title-small">
                  <code>build()</code> must return
                </th>
                <th class="py-2 text-left text-title-small">The chain becomes</th>
              </tr>
            </thead>
            <tbody class="text-on-surface-variant">
              {
                outputMarkers.map((row) => (
                  <tr class="border-b border-outline-variant">
                    <td class="py-2 pr-4 font-mono text-body-small text-on-surface">
                      {row.marker}
                    </td>
                    <td class="py-2 pr-4">{row.returns}</td>
                    <td class="py-2">{row.chain}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-body-large">
          <code>K</code> is one of <code>"excludeMissing"</code> (what{' '}
          <code>.required()</code> declares), <code>"excludeUndefined"</code>,{' '}
          <code>"excludeNull"</code> (<code>.optional()</code>) or <code>"allowNull"</code>{' '}
          (<code>.nullable()</code>).
        </p>

        <p class="mt-4 text-body-large">
          <strong><code>out</code> constrains what <code>build()</code> may return.</strong>{' '}
          The type the chain carries afterwards and the runtime policy the field gets are
          therefore the same declaration; they cannot drift apart.
        </p>

        <div class="mt-4 rounded-shape-md border border-error p-1">
          <p class="px-3 py-2 text-label-large text-error">
            <span class="md-icon md-icon-sm align-middle" aria-hidden="true">cancel</span>{' '}
            This does not compile
          </p>
          <CodeBlock code={outMismatchExample} language="typescript" invalid />
        </div>

        <h4 class="mt-8 text-title-medium"><code>TransformOut</code></h4>

        <p class="mt-2 text-body-large">
          <code>TransformOut</code> and <code>GuardOut</code> do not just constrain the return
          type — they replace the chain method's signature outright.{' '}
          <code>TransformOut</code> makes it{' '}
          <code>&lt;R&gt;(map, options?)</code>, so the caller always supplies the mapping
          function; <code>GuardOut</code> makes it{' '}
          <code>(condition, define, options?)</code>.
        </p>

        <CodeBlock code={transformOutExample} language="typescript" />

        <h4 class="mt-8 text-title-medium"><code>PresenceShift</code></h4>

        <CodeBlock code={presenceOutExample} language="typescript" />

        <h2 id="rule-constructors" class="mt-12 text-headline-small">The rule constructors</h2>

        <p class="mt-3 text-body-large">
          <code>build()</code> returns <strong>exactly one</strong> rule, made by one of eight
          constructors from <code>@maroonedog/luq/plugin-kit</code>.
        </p>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline">
                <th class="py-2 pr-4 text-left text-title-small">Constructor</th>
                <th class="py-2 pr-4 text-left text-title-small">Kind</th>
                <th class="py-2 text-left text-title-small">Runs</th>
              </tr>
            </thead>
            <tbody class="text-on-surface-variant">
              {
                constructors.map((row) => (
                  <tr class="border-b border-outline-variant">
                    <td class="py-2 pr-4 font-mono text-body-small text-on-surface">{row.name}</td>
                    <td class="py-2 pr-4">{row.kind}</td>
                    <td class="py-2">{row.runs}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-body-large">
          <code>check</code>'s <code>run</code> returns <code>PASS</code> or{' '}
          <code>fail(detail)</code>. The detail is what <code>describe()</code> and{' '}
          <code>buildMessageContext()</code> read, and it is the reason a predicate runs{' '}
          <strong>once</strong>: the message travels with the outcome instead of being rebuilt
          by a second call.
        </p>

        <h2 id="arguments" class="mt-12 text-headline-small">
          Arguments, and rejecting bad ones
        </h2>

        <CodeBlock code={argumentsExample} language="typescript" fileName="prefix.ts" />

        <div class="md-card md-card-outlined mt-6 p-5">
          <h3 class="text-title-medium">Two conventions that are load-bearing</h3>
          <ul class="mt-3 space-y-3 text-body-medium text-on-surface-variant">
            <li>
              <strong class="text-on-surface">A wrong-typed value passes.</strong>
              <code>!isString(value) || …</code> is not defensive clutter. The slot guard owns
              type and the presence rules own <code>null</code> and <code>undefined</code>, so a
              value rule that re-decides either produces a duplicate issue under the wrong code.
            </li>
            <li>
              <strong class="text-on-surface">
                <code>ctx.code</code>, <code>ctx.messageFactory</code> and{' '}
                <code>ctx.severity</code> are already resolved
              </strong>{' '}
              from the caller's <code>RuleOptions</code>, falling back to the plugin name and
              the builder's config. Read them; never re-resolve them. Two resolution sites is
              how an override stops working.
            </li>
          </ul>
        </div>

        <h2 id="rule-build-context" class="mt-12 text-headline-small">
          <code>RuleBuildContext</code>
        </h2>

        <p class="mt-3 text-body-large">
          <code>build()</code>'s first parameter carries everything a plugin may know.
        </p>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline">
                <th class="py-2 pr-4 text-left text-title-small">Member</th>
                <th class="py-2 text-left text-title-small">Is</th>
              </tr>
            </thead>
            <tbody class="text-on-surface-variant">
              {
                buildContext.map((row) => (
                  <tr class="border-b border-outline-variant">
                    <td class="py-2 pr-4 font-mono text-body-small text-on-surface">
                      {row.member}
                    </td>
                    <td class="py-2">{row.is}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-body-large">
          There is no process-wide singleton read at validation time. A builder's{' '}
          <code>.withConfig()</code> reaches a plugin through <code>ctx.config</code> and
          nowhere else.
        </p>

        <h2 id="sub-chains" class="mt-12 text-headline-small">Sub-chains</h2>

        <p class="mt-3 text-body-large">
          Four of the argument markers hand your plugin a whole nested chain rather than a
          value. They differ only in <strong>what the sub-chain's subject is</strong>, and
          that is the thing to get right: none of the four can be derived from the others.
        </p>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline">
                <th class="py-2 pr-4 text-left text-title-small">Marker</th>
                <th class="py-2 pr-4 text-left text-title-small">The sub-chain's subject</th>
                <th class="py-2 text-left text-title-small">Shipped example</th>
              </tr>
            </thead>
            <tbody class="text-on-surface-variant">
              {
                chainMarkers.map((row) => (
                  <tr class="border-b border-outline-variant">
                    <td class="py-2 pr-4 font-mono text-body-small text-on-surface">
                      {row.marker}
                    </td>
                    <td class="py-2 pr-4">{row.subject}</td>
                    <td class="py-2">{row.example}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-body-large">
          Here are all four at their call sites. Note what <code>b</code> is inside each
          callback — an element chain, a key chain, a value chain, a narrowed chain — and that
          the compiler knows which:
        </p>

        <CodeBlock code={chainMarkerCallSiteExample} language="typescript" />

        <p class="mt-4 text-body-large">
          On the implementation side, a plugin must declare <strong>which argument
          positions</strong> carry a sub-chain, because a <code>NarrowedChain</code> and a{' '}
          <code>RootPredicate</code> are both plain functions once the types are erased.
        </p>

        <CodeBlock code={subChainExample} language="typescript" fileName="each.ts" />

        <h3 id="never-loop-over-rules" class="mt-8 text-title-large">Never loop over rules</h3>

        <div class="md-card md-card-outlined mt-4 p-5">
          <p class="text-body-medium text-on-surface-variant">
            The loop in <code>combine</code> above walks <strong>values</strong>, not rules.
            That distinction is the rule: a plugin decides <em>which member of the subject</em>{' '}
            a compiled branch applies to, and the engine decides how a rule list executes.
            Execution exists in exactly one place. A plugin that iterates a rule list itself
            has forked the engine, and its rules will not honour <code>abortEarly</code>,
            severity, or issue paths the way every other rule does.
          </p>
          <p class="mt-3 text-body-medium text-on-surface-variant">
            The same reasoning governs when your code runs. The callback the user writes is
            resolved <strong>once</strong>, at <code>build()</code> time. Nothing in a plugin
            should run per-<code>validate()</code> that could have run per-<code>build()</code>.
          </p>
        </div>

        <h2 id="isolation-and-naming" class="mt-12 text-headline-small">
          Isolation and naming
        </h2>

        <p class="mt-3 text-body-large">
          Plugins inside this repository live in one of two tiers, enforced by{' '}
          <code>npm run check:plugin-isolation</code>:
        </p>

        <ul class="mt-4 space-y-3 text-body-large">
          <li>
            <strong>isolated</strong> (<code>src/plugins/&lt;kebab-name&gt;/</code>) — may
            import <code>plugin-kit</code>, <code>types</code>, <code>path</code>, and its own
            directory. Nothing else: not a sibling plugin, not the JSON Schema layer, not the
            builder. 75 of the 77 are here.
          </li>
          <li>
            <strong>extension</strong>{' '}
            (<code>src/json-schema/extensions/&lt;kebab-name&gt;/</code>) — may additionally
            import the JSON Schema layer and other plugins' entry files.{' '}
            <code>jsonSchema</code> and <code>jsonSchemaFullFeature</code> are the two.
          </li>
        </ul>

        <p class="mt-4 text-body-large">
          That rule is why importing one plugin does not drag in the other 76, and it is
          measured: a plugin costs 129–224&nbsp;B of gzip to add, against a {bundleSize.coreOnly.gzip}{' '}
          builder. A plugin published from your own package has the same shape and imports{' '}
          <code>@maroonedog/luq/plugin-kit</code> instead of relative paths.
        </p>

        <p class="mt-4 text-body-large">
          Naming inside the repository: the directory is <code>kebab-case</code> and the public
          subpath is <code>camelCase</code>, derived from each other and round-trip asserted at
          build time; <code>index.ts</code> re-exports only; and one method name per slot across
          the whole catalogue — <code>npm run check:plugin-uniqueness</code> refuses a
          collision. <code>stringMin</code> and <code>numberMin</code> may both be{' '}
          <code>.min()</code> because their slots do not overlap.
        </p>

