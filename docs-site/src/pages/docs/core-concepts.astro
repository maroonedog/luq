---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import OnThisPage from '../../components/OnThisPage.astro';

// Every TypeScript block on this page was typechecked against the built
// package. The blocks marked "does not compile" were checked the other way:
// they are required to be rejected, and they are.

// This used to be a caret pointing at one line, which CI had to skip because a
// fragment is not a statement. The block carries a "Does not compile" label
// now, and that label is only honest where the build proves it — so the
// fragment became a whole file.
// luq-example: must-fail — `title` is a string, so the number slot is refused; compiling would make the claim beside it false
const slotExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';

type Draft = { title: string };

const draftValidator = Builder()
  .use(requiredPlugin)
  .use(numberMinPlugin)
  .for<Draft>()
  // \`title\` is a string. Choosing the number slot is a compile error.
  .v('title', b => b.number.required().min(3))
  .build();`;

const bagExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';
import { numberMinPlugin } from '@maroonedog/luq/plugins/numberMin';

type UserProfile = { name: string; age: number };

const validator = Builder()
  .use(requiredPlugin)    // adds .required() to every slot
  .use(stringMinPlugin)   // adds .min() to b.string
  .use(numberMinPlugin)   // adds .min() to b.number
  .for<UserProfile>()
  .v('name', b => b.string.required().min(2))
  .v('age', b => b.number.required().min(18))
  .build();`;

// luq-example: must-fail — shows .min() missing from the bag; compiling would make the page's claim false
const unimportedExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';

type Draft = { title: string };

const draftValidator = Builder()
  .use(requiredPlugin)
  .for<Draft>()
  // stringMinPlugin was never \`use\`d, so \`.min\` does not exist here.
  .v('title', b => b.string.required().min(3))
  .build();`;

const pathExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type UserProfile = {
  name: string;
  address: { street: string; city: string };
  tags: string[];
};

const validator = Builder()
  .use(requiredPlugin)
  .use(stringMinPlugin)
  .for<UserProfile>()
  .v('name', b => b.string.required())
  .v('address.street', b => b.string.required())   // dot = nested property
  .v('address.city', b => b.string.required())
  .v('tags', b => b.array.required())              // the array itself
  .v('tags[*]', b => b.string.required().min(1))   // every element
  .build();

const rejected = validator.validate({
  name: 'Jo',
  address: { street: 'Main', city: 'Tokyo' },
  tags: ['ok', ''],
});

// -> ["tags[1]"] — the REAL index, never "tags[*]"
const failedPaths = rejected.issues.map(issue => issue.path);`;

const presenceExample = `import { Builder } from '@maroonedog/luq';
import { requiredPlugin } from '@maroonedog/luq/plugins/required';
import { optionalPlugin } from '@maroonedog/luq/plugins/optional';
import { nullablePlugin } from '@maroonedog/luq/plugins/nullable';
import { stringMinPlugin } from '@maroonedog/luq/plugins/stringMin';

type Member = {
  id: string;
  nickname?: string;
  deletedAt: string | null;
  closedAt: string | null;
};

const memberValidator = Builder()
  .use(requiredPlugin)
  .use(optionalPlugin)
  .use(nullablePlugin)
  .use(stringMinPlugin)
  .for<Member>()
  .v('id', b => b.string.required().min(1))
  .v('nickname', b => b.string.optional().min(2))
  .v('deletedAt', b => b.string.nullable())
  // .required() narrows out null as well as undefined, so "present or
  // explicitly null, but never missing" is the two rules chained.
  .v('closedAt', b => b.string.required().nullable())
  .build();`;

// luq-example: with bagExample — reads the validator built in the block above, so only the check is shown rather than repeating the declaration
const resultExample = `const result = validator.validate({ name: 'John', age: 25 });

if (result.valid) {
  // \`data\` is fully typed as UserProfile, and exists only on this branch.
  console.log(result.data.name);
} else {
  for (const issue of result.issues) {
    console.log(\`\${issue.path}: \${issue.message} [\${issue.code}] \${issue.severity}\`);
  }
}`;

// The runtime half of a slot, from src/chain/slot-type-guard.ts. Literal rows,
// so nothing here is derived and nothing here is a code block to compile.
const slotSeedRows = [
  { slot: 'b.string', code: 'stringType', accepts: 'typeof value === "string"' },
  {
    slot: 'b.number',
    code: 'numberType',
    accepts: 'typeof value === "number" — NaN included',
  },
  { slot: 'b.boolean', code: 'booleanType', accepts: 'typeof value === "boolean"' },
  { slot: 'b.date', code: 'dateType', accepts: 'value instanceof Date' },
  { slot: 'b.array', code: 'arrayType', accepts: 'Array.isArray(value)' },
  {
    slot: 'b.object',
    code: 'objectType',
    accepts: 'a plain object: not an array, not null',
  },
];

const pathGrammar = [
  { form: '"name"', means: 'a property of the root' },
  { form: '"customer.name"', means: 'a nested property' },
  { form: '"items[*]"', means: 'every element of items, as a whole value' },
  { form: '"items[*].sku"', means: 'sku of every element' },
  { form: '"matrix[*][*]"', means: 'every element of every sub-array' },
];

const presenceRows = [
  { declared: '.required()', undef: 'rejected', nul: 'rejected', empty: 'rejected', present: 'checks run' },
  { declared: '.optional()', undef: 'accepted, field ends', nul: 'rejected', empty: 'checks run', present: 'checks run' },
  { declared: '.nullable()', undef: 'rejected', nul: 'accepted, field ends', empty: 'checks run', present: 'checks run' },
  { declared: 'nothing', undef: 'accepted, field ends', nul: 'accepted, field ends', empty: 'checks run', present: 'checks run' },
];

const tableOfContents = [
  { id: 'slots', title: 'Slots', level: 2 },
  { id: 'plugins-are-the-vocabulary', title: 'Plugins are the vocabulary', level: 2 },
  { id: 'field-paths', title: 'Field paths', level: 2 },
  { id: 'presence', title: 'Presence', level: 2 },
  { id: 'the-order-rules-run-in', title: 'The order rules run in', level: 2 },
  { id: 'results', title: 'Results', level: 2 },
  { id: 'next-steps', title: 'Next steps', level: 2 },
];
---

<BaseLayout title="Core concepts — Luq documentation">
  <Header />

  <div class="flex min-h-screen">
    <DocsSidebar currentPath="/docs/core-concepts" tableOfContents={tableOfContents} />

    <main class="flex-1 px-4 py-8 pt-20 sm:px-6 lg:px-8 lg:pt-8">
      <article class="mx-auto max-w-4xl">
        <h1 class="text-headline-large">Core concepts</h1>

        <p class="mt-4 text-body-large text-on-surface-variant">
          Six ideas carry the whole library: your type is the schema, a slot decides which
          methods exist, a plugin bag decides which of those you imported, a path is a
          checked string literal, presence is decided once before any check, and the result
          is a discriminated union.
        </p>

        <h2 id="slots" class="mt-12 text-headline-small">Slots</h2>

        <p class="mt-3 text-body-large">
          Inside a <code>.v()</code> callback you first pick a <strong>slot</strong> —{' '}
          <code>b.string</code>, <code>b.number</code>, <code>b.boolean</code>,{' '}
          <code>b.date</code>, <code>b.array</code>, <code>b.tuple</code>,{' '}
          <code>b.object</code>, <code>b.union</code>, <code>b.any</code>. The slot is what
          decides which methods the chain offers: <code>stringMin</code> puts{' '}
          <code>.min()</code> on <code>b.string</code> and <code>numberMin</code> puts a
          different <code>.min()</code> on <code>b.number</code>, and the two never collide
          because their slots do not overlap.
        </p>

        <p class="mt-4 text-body-large">
          Choosing a slot the field's type cannot be is a <strong>compile</strong> error.
        </p>

        <CodeBlock code={slotExample} language="typescript" class="mt-4" invalid />

        <p class="mt-6 text-body-large">
          A slot also has a run-time half. Entering <code>b.&lt;slot&gt;</code> seeds the
          chain with one rule — the value is of that type — so a field declared{' '}
          <code>b.number</code> and handed a string reports <code>numberType</code>, with
          no value rule on it at all.
        </p>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline">
                <th class="py-2 pr-4 text-left text-title-small">Slot</th>
                <th class="py-2 pr-4 text-left text-title-small">Issue code</th>
                <th class="py-2 text-left text-title-small">Accepts</th>
              </tr>
            </thead>
            <tbody class="text-on-surface-variant">
              {
                slotSeedRows.map((row) => (
                  <tr class="border-b border-outline-variant">
                    <td class="py-2 pr-4 font-mono text-body-small text-on-surface">
                      {row.slot}
                    </td>
                    <td class="py-2 pr-4 font-mono text-body-small text-on-surface">
                      {row.code}
                    </td>
                    <td class="py-2">{row.accepts}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-body-large">
          <code>tuple</code>, <code>union</code> and <code>any</code> seed nothing.{' '}
          <code>any</code> accepts everything by definition, and the other two are settled
          by the branches declared inside them rather than by one <code>typeof</code>.
        </p>

        <div class="md-card md-card-outlined mt-6 p-5">
          <h3 class="text-title-medium">Two things the seeded rule leaves alone</h3>
          <p class="mt-2 text-body-medium text-on-surface-variant">
            <strong class="text-on-surface"
              ><code>undefined</code> and <code>null</code> pass it.</strong
            >{' '}
            Absence belongs to <code>required</code>, <code>optional</code> and{' '}
            <code>nullable</code>, which run in the same list — so a missing field reports{' '}
            <code>required</code>, not a type error, and <code>.optional()</code> can still
            switch it off.
          </p>
          <p class="mt-3 text-body-medium text-on-surface-variant">
            <strong class="text-on-surface"><code>NaN</code> is a number.</strong> The rule
            answers the type question only; <code>min</code>, <code>integer</code> and{' '}
            <code>finite</code> are where you say what you think of <code>NaN</code>.
          </p>
        </div>

        <h2 id="plugins-are-the-vocabulary" class="mt-12 text-headline-small">
          Plugins are the vocabulary
        </h2>

        <p class="mt-3 text-body-large">
          <code>.use()</code> puts a plugin in the builder's <strong>bag</strong>, and the bag
          decides which methods exist on which slots. There is no registry to populate and no
          global state; the bag is a type the builder carries.
        </p>

        <CodeBlock code={bagExample} language="typescript" />

        <p class="mt-4 text-body-large">
          Because the bag is a type, an unimported plugin is not merely absent at run time —
          its method does not typecheck. That is the whole tree-shaking story: the bundle
          contains what you imported, and nothing you did not.
        </p>

        <CodeBlock code={unimportedExample} language="typescript" class="mt-4" invalid />

        <h2 id="field-paths" class="mt-12 text-headline-small">Field paths</h2>

        <p class="mt-3 text-body-large">
          A path is a string literal TypeScript resolves against your type. Nested fields use
          dots; array elements use <code>[*]</code>. That is the entire grammar.
        </p>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline">
                <th class="py-2 pr-4 text-left text-title-small">Form</th>
                <th class="py-2 text-left text-title-small">Means</th>
              </tr>
            </thead>
            <tbody class="text-on-surface-variant">
              {
                pathGrammar.map((row) => (
                  <tr class="border-b border-outline-variant">
                    <td class="py-2 pr-4 font-mono text-body-small text-on-surface">{row.form}</td>
                    <td class="py-2">{row.means}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <CodeBlock code={pathExample} language="typescript" />

        <p class="mt-4 text-body-large">
          The path you <em>declare</em> holds <code>[*]</code>; the path you <em>read back</em>{' '}
          holds the index the failure happened at. Every other form is a compile error,
          including reaching inside a <code>Date</code> or <code>Map</code>, which a path
          treats as opaque —{' '}
          <a
            class="text-primary underline underline-offset-2"
            href="/docs/troubleshooting#bad-path">the rejected forms</a
          >.
        </p>

        <h2 id="presence" class="mt-12 text-headline-small">Presence</h2>

        <p class="mt-3 text-body-large">
          Whether a value is <em>absent</em> is decided once, by the field's presence policy,
          before any check sees it. A check therefore never re-decides whether{' '}
          <code>null</code> is acceptable, and never re-decides the type either: the slot's
          seeded rule has already reported a wrong type under its own code, so{' '}
          <code>stringMin</code> answers pass for a non-string rather than failing it a
          second time. One invalid value produces one issue, not one per rule in the chain.
        </p>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline">
                <th class="py-2 pr-4 text-left text-title-small">Declared</th>
                <th class="py-2 pr-4 text-left text-title-small"><code>undefined</code></th>
                <th class="py-2 pr-4 text-left text-title-small"><code>null</code></th>
                <th class="py-2 pr-4 text-left text-title-small"><code>""</code></th>
                <th class="py-2 text-left text-title-small">present</th>
              </tr>
            </thead>
            <tbody class="text-on-surface-variant">
              {
                presenceRows.map((row) => (
                  <tr class="border-b border-outline-variant">
                    <td class="py-2 pr-4 font-mono text-body-small text-on-surface">
                      {row.declared}
                    </td>
                    <td class="py-2 pr-4">{row.undef}</td>
                    <td class="py-2 pr-4">{row.nul}</td>
                    <td class="py-2 pr-4">{row.empty}</td>
                    <td class="py-2">{row.present}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="md-card md-card-outlined mt-6 p-5">
          <h3 class="text-title-medium">A field with no presence rule is not required</h3>
          <p class="mt-2 text-body-medium text-on-surface-variant">
            That is the last row, and it is one uniform answer replacing 1.x's split, where
            adding an array elsewhere in the schema switched implicit-required on for
            unrelated fields. <code>.required()</code> treating <code>""</code> as absent is
            1.x behaviour kept deliberately — <code>0</code>, <code>false</code>,{' '}
            <code>[]</code> and <code>{'{}'}</code> all count as present.
          </p>
        </div>

        <CodeBlock code={presenceExample} language="typescript" />

        <p class="mt-4 text-body-large">
          <code>requiredIf</code> and <code>optionalIf</code> are presence rules too, not
          checks: a field that fails one produces exactly one issue, under the presence
          rule's own code, and no check on that field runs.
        </p>

        <h2 id="the-order-rules-run-in" class="mt-12 text-headline-small">
          The order rules run in
        </h2>

        <p class="mt-3 text-body-large">
          For every field, always, whatever order you wrote the chain in:
        </p>

        <CodeBlock
          code={'default  ->  presence  ->  gates  ->  checks  ->  transforms  ->  recursion'}
          language="text"
          showCopy={false}
        />

        <p class="mt-4 text-body-large">
          <code>build()</code> sorts the chain into those buckets, so{' '}
          <code>.min(3).validateIf(c)</code> and <code>.validateIf(c).min(3)</code> mean the
          same thing. In 1.x the answer depended on where in the chain the call sat.
        </p>

        <p class="mt-4 text-body-large">
          A <strong>gate</strong> is <code>validateIf</code> or its polarity-inverted twin{' '}
          <code>skip</code>: a predicate over the root value, asked before any check runs,
          with no message of its own to write when it closes. A closed gate silences the
          whole field rather than the rules after it,
          and reports nothing; a rejected presence rule ends the field with exactly one
          issue; and transforms run in <code>parse()</code> only, and only when every check
          passed.
        </p>

        <p id="validate-vs-parse" class="mt-4 text-body-large">
          That last bucket is the whole difference between the two entry points.{' '}
          <code>validate()</code> never changes your value; <code>parse()</code> applies the
          transforms, to a field whose checks all passed and only after they have.{' '}
          <code>.transform()</code> also changes the chain's <em>type</em>, so a transform to
          another type is reflected in what <code>parse()</code> hands back. Use{' '}
          <code>validate()</code> when you want to judge a value and keep it; use{' '}
          <code>parse()</code> when you want the value the rules produced.
        </p>

        <h2 id="results" class="mt-12 text-headline-small">Results</h2>

        <p class="mt-3 text-body-large">
          <code>validate()</code> and <code>parse()</code> return a discriminated union on{' '}
          <code>valid</code>. There is no <code>errors</code> member; narrowing on{' '}
          <code>valid</code> is what gives you <code>data</code>.
        </p>

        <CodeBlock code={resultExample} language="typescript" />

        <p class="mt-4 text-body-large">
          The full shape, <code>ValidationIssue</code>, and why a
          non-<code>error</code> severity does not fail the result:{' '}
          <a
            class="text-primary underline underline-offset-2"
            href="/docs/api/validator#validation-result">the validator API</a
          >.
        </p>

        <h2 id="next-steps" class="mt-12 text-headline-small">Next steps</h2>

        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <a
            href="/docs/examples"
            class="md-card md-card-outlined md-state-layer md-focus-ring block p-5"
          >
            <span class="md-icon text-primary" aria-hidden="true">lightbulb</span>
            <h3 class="mt-2 text-title-medium">Examples &amp; patterns</h3>
            <p class="mt-1 text-body-medium text-on-surface-variant">
              Cross-field rules, form errors, and two real-world validators
            </p>
          </a>

          <a
            href="/docs/custom-plugins"
            class="md-card md-card-outlined md-state-layer md-focus-ring block p-5"
          >
            <span class="md-icon text-primary" aria-hidden="true">build</span>
            <h3 class="mt-2 text-title-medium">Writing a plugin</h3>
            <p class="mt-1 text-body-medium text-on-surface-variant">
              <code>definePlugin</code>, the markers, and the <code>out</code> contract
            </p>
          </a>

          <a href="/plugins" class="md-card md-card-outlined md-state-layer md-focus-ring block p-5">
            <span class="md-icon text-primary" aria-hidden="true">extension</span>
            <h3 class="mt-2 text-title-medium">Plugin catalog</h3>
            <p class="mt-1 text-body-medium text-on-surface-variant">
              Every subpath, chain method and slot
            </p>
          </a>

          <a
            href="/docs/api/validator#porting"
            class="md-card md-card-outlined md-state-layer md-focus-ring block p-5"
          >
            <span class="md-icon text-primary" aria-hidden="true">swap_horiz</span>
            <h3 class="mt-2 text-title-medium">Porting from 1.x</h3>
            <p class="mt-1 text-body-medium text-on-surface-variant">
              What <code>isValid()</code>, <code>errors</code> and the{' '}
              <code>Result</code> monad became
            </p>
          </a>
        </div>
      </article>
    </main>

    <OnThisPage tableOfContents={tableOfContents} />
  </div>

  <Footer />
</BaseLayout>
