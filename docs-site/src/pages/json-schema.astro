        keyword: 'const',
        handling: 'bind',
        target: 'literal — .literal(value)',
        note: 'Reaches every slot; comparison is structural, not reference equality.',
      },
      {
        keyword: 'allOf',
        handling: 'structural',
        target: '—',
        note: 'Every sub-schema becomes a sub-chain the composite runs.',
      },
      {
        keyword: 'anyOf',
        handling: 'structural',
        target: '—',
        note: 'Sub-chains combined existentially.',
      },
      {
        keyword: 'oneOf',
