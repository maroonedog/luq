        keyword: 'definitions',
        handling: 'structural',
        target: '—',
        note: 'A container of schemas, never a constraint itself.',
      },
      {
        keyword: 'type',
        handling: 'structural',
        target: 'the slot itself',
        note: 'Chooses b.string / b.number / …; "integer" adds .integer(); a type array becomes nullable or a union.',
      },
      {
        keyword: 'enum',
        handling: 'structural',
        target: 'oneOf — .oneOf()',
        note: 'The allowed-value list is typed against the field, so the converter resolves it and calls the method itself.',
      },
