const fullFeatureExample = `import { fromJsonSchema } from "@maroonedog/luq/plugins/jsonSchemaFullFeature";

type Account = { email: string; age?: number };

const accountValidator = fromJsonSchema<Account>({
  type: "object",
  properties: {
    email: { type: "string", format: "email" },
    age: { type: "number", minimum: 18 },
  },
  required: ["email"],
});

const result = accountValidator.validate({ email: "not-an-email" });

if (result.valid) {
  // \`data\` exists only on this branch — no cast, no non-null assertion.
  console.log(result.data.email);
} else {
  for (const issue of result.issues) {
    // -> "email: stringEmail"
    console.log(\`\${issue.path}: \${issue.code}\`);
  }
}`;

const chainMethodExample = `import { Builder } from "@maroonedog/luq";
import { jsonSchemaPlugin } from "@maroonedog/luq/plugins/jsonSchema";
import { jsonSchemaBag } from "@maroonedog/luq/plugins/jsonSchemaFullFeature";
import { requiredPlugin } from "@maroonedog/luq/plugins/required";

type Envelope = { id: string; payload: Record<string, unknown> };

const PAYLOAD_SCHEMA = {
  type: "object",
  properties: { kind: { type: "string", minLength: 1 } },
  required: ["kind"],
  additionalProperties: false,
};

const envelopeValidator = Builder()
  .use(requiredPlugin)
  .use(jsonSchemaPlugin)
  .for<Envelope>()
  .v("id", (b) => b.string.required())
  .v("payload", (b) => b.object.required().jsonSchema(PAYLOAD_SCHEMA, jsonSchemaBag))
  .build();

// false — payload.kind is empty
envelopeValidator.validate({ id: "e1", payload: { kind: "" } }).valid;`;

const bundledChainExample = `import { Builder } from "@maroonedog/luq";
import { jsonSchemaFullFeaturePlugin } from "@maroonedog/luq/plugins/jsonSchemaFullFeature";

type Reading = { sample: number };

// Same conversion, but the bag is already inside the plugin, so there is no
// second argument. The method NAME differs on purpose: one builder may hold
// both plugins, and two plugins may not claim one method on one slot.
const readingValidator = Builder()
  .use(jsonSchemaFullFeaturePlugin)
  .for<Reading>()
  .v("sample", (b) => b.number.jsonSchemaFullFeature({ type: "number", minimum: 0 }))
  .build();

readingValidator.validate({ sample: -1 }).valid; // false`;

const runtimeSchemaExample = `import { fromJsonSchema } from "@maroonedog/luq/plugins/jsonSchemaFullFeature";

// Rules loaded at run time, with no type to name. \`T\` defaults to
// Record<string, unknown> — never \`any\` — and no declared path is checked.
export async function loadValidator() {
  const response = await fetch("/api/validation-rules");
  const schema: unknown = await response.json();
  return fromJsonSchema(schema);
}`;

// luq-example: skip — .v() 呼び出し1行だけの断片で、単体では文にならない
const nullPresenceExample = `// A converted { "type": "string" } cannot itself reject null: absence is
// settled before any rule runs, so nullability is the field's PRESENCE policy.
// The converter writes .optional() for every non-required property; a
// hand-written chain says it the same way.
.v("nickname", (b) => b.string.optional().min(2))`;

const reproduceCommands = `git submodule update --init --recursive
npm ci
npx jest test/integration/json-schema-suite.test.ts`;

type KeywordRow = {
  keyword: string;
  handling: 'bind' | 'structural' | 'annotation';
  target: string;
  note: string;
};

const keywordGroups: Array<{ title: string; blurb: string; rows: KeywordRow[] }> = [
