---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header, { navItems } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileMenuOverlay from '../components/MobileMenuOverlay.astro';
import CodeBlock from '../components/CodeBlock.astro';

/**
 * Every figure on this page is imported from the recorded measurement files, so
 * a number here cannot drift from the number CI reads:
 *
 *   config/perf-baseline.json   written by `npm run bench:record`
 *   config/size-budget.json     re-measured by `npm run check:size`
 *
 * Nothing is typed in by hand except the arithmetic derived below, and the
 * conformance figures, which come from docs/json-schema-conformance.md.
 *
 * Competitor figures ARE on this page now, and they were measured here — zod,
 * valibot, ajv and yup, in the same process, interleaved sample by sample,
 * against the same value pools. What is NOT here is a third-party figure this
 * repository did not re-run.
 *
 * Two disciplines make the table mean something. Judgements are compared before
 * anything is timed, and only values every library answers the same way are
 * timed; the disagreements are printed rather than dropped. And the losses are
 * in the same table as the wins — Luq loses to valibot on all four shapes and
 * to ajv by an order of magnitude, and both are here.
 *
 *   config/competitor-baseline.json  written by bench/competitors/
 */
import { competitorBenchmark } from '../data/competitors';
import perfBaseline from '../../../config/perf-baseline.json';
import sizeBudget from '../../../config/size-budget.json';

const machine = perfBaseline.machine;
const conditions = perfBaseline.conditions;

const shapeLabels: Record<string, string> = {
  singleField: '1 field, 1 check',
  multiField: '3 fields, 6 plugins',
  nested: 'nested, depth 2–3',
  array: 'array of 50 elements',
  jsonSchema: 'JSON Schema document',
};

const shapeOrder = ['singleField', 'multiField', 'nested', 'array', 'jsonSchema'] as const;

const throughputByShape = shapeOrder.map((shape) => {
  const declares = perfBaseline.shapes.find((entry) => entry.name === shape)?.declares ?? '';
  const find = (operation: string) =>
    perfBaseline.throughput.find(
      (entry) => entry.shape === shape && entry.operation === operation
    );
  return {
    shape,
    label: shapeLabels[shape],
    declares,
    validate: find('validate'),
    parse: find('parse'),
  };
});

const fastestValidate = Math.max(
  ...throughputByShape.map((row) => row.validate?.opsPerSecond ?? 0)
);

const legacyRows = shapeOrder.map((shape) => {
  const entry = perfBaseline.legacyComparison.find((row) => row.shape === shape);
  return { shape, label: shapeLabels[shape], entry };
});

const buildCostRows = shapeOrder.map((shape) => {
  const entry = perfBaseline.buildCost.find((row) => row.shape === shape);
  return { shape, label: shapeLabels[shape], entry };
});

const gatedRows = perfBaseline.referenceRatio.filter((row) => row.inputIsAccepted);

/**
 * The measured bytes, the ceilings and the ids all come from the JSON. Only the
 * prose is written here, because `size-budget.json` describes each entry in
 * Japanese and this site is in English. No figure is retyped.
 */
const budgetDescriptions: Record<string, string> = {
  'core-only': 'Builder alone. The floor a reader pays before importing a single plugin.',
  'one-plugin': 'Builder + required. The point that shows what one plugin costs.',
  'three-plugin':
    'Builder + required / stringMin / numberMin. The same set the barrel-equivalence check uses.',
  'six-plugin':
    "Builder + the six plugins of 1.x's own “simple” comparison. The direct comparison for the 19–23 KB claim.",
  'full-feature':
    'Builder + every plugin in the catalogue, including the two JSON Schema extensions. The ceiling of everything.',
};

const budgets = sizeBudget.budgets;
const budgetById = (id: string) => budgets.find((entry) => entry.id === id);
const coreOnly = budgetById('core-only');
const sixPlugin = budgetById('six-plugin');
const fullFeature = budgetById('full-feature');

const coreBytes = coreOnly?.recordedGzipBytes ?? 0;
const sixBytes = sixPlugin?.recordedGzipBytes ?? 0;
const fullBytes = fullFeature?.recordedGzipBytes ?? 0;

// Derived arithmetic, from the imported figures only.
const coreShareOfFullPercent = ((coreBytes / fullBytes) * 100).toFixed(1);
const sixPluginDeltaBytes = sixBytes - coreBytes;
const averageBytesPerPlugin = Math.round(sixPluginDeltaBytes / 6);
const coreVersusLegacy = ((sizeBudget.legacyBaseline.coreOnlyGzipBytes / coreBytes)).toFixed(1);

/**
 * The three JSON Schema entry points are not budget rows — they are measured
 * with the same esbuild + gzip method and recorded in docs/guide/json-schema.md
 * and the README's size table.
 */
const jsonSchemaEntries = [
  {
    entry: 'Builder + jsonSchemaPlugin, no bag',
    gzipBytes: 18992,
    note: 'Not a configuration you can validate with — .jsonSchema() needs a bag.',
  },
  {
    entry: 'Builder + jsonSchemaPlugin + a working 49-plugin bag',
    gzipBytes: 21371,
    note: 'The smallest usable JSON Schema build.',
  },
  {
    entry: 'Builder + jsonSchemaFullFeaturePlugin',
    gzipBytes: 21383,
    note: 'One import. 12 B — 0.06% — larger than the row above.',
  },
];

const bytes = (value: number) => `${value.toLocaleString('en-US')} B`;
const ops = (value: number) => value.toLocaleString('en-US');
const barWidth = (value: number, max: number) => Math.max(1.5, (value / max) * 100);

const reproduceCommands = `# Speed — rewrites config/perf-baseline.json
npm run bench:record

# Bundle size — fails the build if any entry exceeds its ceiling
npm run check:size

# CSP — greps every emitted .js/.mjs for eval and new Function
npm run check:no-dynamic-code`;

---

<BaseLayout
  title="Benchmarks"
  description="Measured bundle size and throughput for Luq, taken from config/perf-baseline.json and config/size-budget.json — including the shapes where this release is slower than 1.x."
>
  <Header />
  <MobileMenuOverlay navItems={navItems} />

  <main class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <!-- ================= Hero ================= -->
    <header class="mb-12">
      <p class="mb-2 text-label-large text-primary">Measured, not claimed</p>
      <h1 class="mb-4 text-display-small text-on-surface">Benchmarks</h1>
      <p class="max-w-3xl text-body-large text-on-surface-variant">
        Every number below was produced by a script in this repository and is read back by CI.
        Where a measurement is worse than the 1.x release, it is on this page as worse. There are
        no third-party comparisons here, because this repository does not measure other libraries.
      </p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="md-card md-card-filled p-5">
          <dt class="text-label-medium text-on-surface-variant">Bundle floor, gzipped</dt>
          <dd class="mt-1 text-headline-small text-on-surface">{bytes(coreBytes)}</dd>
          <dd class="mt-1 text-body-small text-on-surface-variant">
            <code>Builder</code> with zero plugins
          </dd>
        </div>
        <div class="md-card md-card-filled p-5">
          <dt class="text-label-medium text-on-surface-variant">3 fields, 6 plugins</dt>
          <dd class="mt-1 text-headline-small text-on-surface">
            {ops(throughputByShape[1].validate?.opsPerSecond ?? 0)}
          </dd>
          <dd class="mt-1 text-body-small text-on-surface-variant">
            <code>validate</code> ops/sec on the machine below
          </dd>
        </div>
        <div class="md-card md-card-filled p-5">
          <dt class="text-label-medium text-on-surface-variant">Dynamic code</dt>
          <dd class="mt-1 text-headline-small text-on-surface">0 occurrences</dd>
          <dd class="mt-1 text-body-small text-on-surface-variant">
            across 762 emitted <code>.js</code> / <code>.mjs</code> files
          </dd>
        </div>
      </dl>
    </header>

    <!-- ================= Honesty ================= -->
    <section id="honesty" class="mb-16 scroll-mt-24">
      <div class="md-card md-card-outlined p-6">
        <h2 class="mb-3 flex items-center gap-2 text-title-large text-on-surface">
          <span class="md-icon text-primary" aria-hidden="true">priority_high</span>
          Read this first
        </h2>
        <ul class="space-y-3 text-body-medium text-on-surface-variant">
          <li>
            <strong class="text-on-surface">This release is slower than 1.x on flat and nested
            shapes.</strong> Measured side by side in one process:
            ×{legacyRows[0].entry?.speedup} on one field, ×{legacyRows[1].entry?.speedup} on three,
            ×{legacyRows[2].entry?.speedup} nested. The two wins are arrays
            (×{legacyRows[3].entry?.speedup}) and JSON Schema (×{legacyRows[4].entry?.speedup}).
            <a class="text-primary underline underline-offset-2" href="#against-1x">The table is below.</a>
          </li>
          <li>
            <strong class="text-on-surface">Neither speed figure 1.x published reproduces here.</strong>
            Its README claimed 1.2M ops/sec simple and 43K complex. On this machine 1.x itself does
            {ops(legacyRows[1].entry?.legacyOpsPerSecond ?? 0)} on the shape rebuilt from its own
            &ldquo;simple&rdquo; benchmark source, and &ldquo;complex&rdquo; has no reproducible
            definition left to measure. Both old claims are gone from this site rather than carried
            forward.
          </li>
          <li>
            <strong class="text-on-surface">Competitors are measured, and Luq loses some of
            them.</strong> zod, valibot, ajv and yup are run here, in this process, against the same
            values — Luq is faster in {competitorBenchmark.luqWins} of
            {competitorBenchmark.total} pairings and slower in the rest. The table is below and the
            losses are in it.
          </li>
          <li>
            <strong class="text-on-surface">The subject is <code>src/</code>, not the bundle.</strong>
            Speed is measured on {conditions.moduleUnderTest}.
          </li>
        </ul>
      </div>
    </section>

    <!-- ================= Bundle size ================= -->
    <section id="bundle-size" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">Bundle size</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        {sizeBudget.method.bundler}, <code>bundle + minify + esm + es2020 + platform:neutral +
        treeShaking</code>, then <code>zlib.gzipSync</code> — the same options 1.x's own
        <code>bundle-size-comparison</code> used, so the two columns are comparable. Recorded
        {sizeBudget.recorded.date} on Node {sizeBudget.recorded.node}. The ceiling is the gate;
        the recorded figure is the evidence behind it.
      </p>

      <div class="md-card md-card-outlined overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[46rem] border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline-variant text-label-large text-on-surface-variant">
                <th class="px-4 py-3 text-left font-medium">Entry</th>
                <th class="px-4 py-3 text-right font-medium">gzip</th>
                <th class="px-4 py-3 text-right font-medium">CI ceiling</th>
                <th class="px-4 py-3 text-right font-medium">1.x, same method</th>
              </tr>
            </thead>
            <tbody>
              {
                budgets.map((budget) => (
                  <tr class="border-b border-outline-variant/60 last:border-0">
                    <td class="px-4 py-3 align-top">
                      <span class="text-on-surface">{budget.id}</span>
                      <span class="mt-0.5 block text-body-small text-on-surface-variant">
                        {budgetDescriptions[budget.id]}
                      </span>
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface">
                      {bytes(budget.recordedGzipBytes)}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface-variant">
                      {bytes(budget.gzipCeilingBytes)}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface-variant">
                      {budget.legacyGzipBytes ? bytes(budget.legacyGzipBytes) : '—'}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="md-card md-card-filled p-5">
          <p class="text-title-medium text-on-surface">{coreShareOfFullPercent}%</p>
          <p class="mt-1 text-body-small text-on-surface-variant">
            of the all-plugins build is the core. 1.x's core was {coreVersusLegacy}× heavier than
            this one in absolute bytes, and 89.1% of its own &ldquo;simple&rdquo; figure.
          </p>
        </div>
        <div class="md-card md-card-filled p-5">
          <p class="text-title-medium text-on-surface">~{bytes(averageBytesPerPlugin)}</p>
          <p class="mt-1 text-body-small text-on-surface-variant">
            per plugin on average across the first six ({bytes(sixPluginDeltaBytes)} for all six).
            You pay for what you import.
          </p>
        </div>
        <div class="md-card md-card-filled p-5">
          <p class="text-title-medium text-on-surface">
            {bytes(sizeBudget.crossCheckAgainstDist.coreOnlyGzipBytes)}
          </p>
          <p class="mt-1 text-body-small text-on-surface-variant">
            the same core measured from the built <code>dist/</code> instead of
            <code>src/</code> — 8 B apart, which is why measuring the source is fair.
          </p>
        </div>
      </div>

      <p class="mt-6 max-w-3xl text-body-medium text-on-surface-variant">
        One row is <strong class="text-on-surface">not</strong> a win: all 76 plugins at
        {bytes(fullBytes)} is larger than the {bytes(sizeBudget.legacyBaseline.complexGzipBytes)}
        1.x published for its <code>complex</code> case. The two are not comparable — 1.x's figure
        was one schema's plugin set, not its whole catalogue — so it is not counted either way.
      </p>
    </section>

    <!-- ================= JSON Schema size ================= -->
    <section id="json-schema-size" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">JSON Schema entry points</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        Same esbuild and gzip method. <code>@maroonedog/luq/plugins/jsonSchema</code> is billed as
        the tree-shakeable half of the JSON Schema story. Measured, it is not.
      </p>

      <div class="md-card md-card-outlined overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[42rem] border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline-variant text-label-large text-on-surface-variant">
                <th class="px-4 py-3 text-left font-medium">Entry</th>
                <th class="px-4 py-3 text-right font-medium">gzip</th>
                <th class="px-4 py-3 text-left font-medium">Note</th>
              </tr>
            </thead>
            <tbody>
              {
                jsonSchemaEntries.map((row) => (
                  <tr class="border-b border-outline-variant/60 last:border-0">
                    <td class="px-4 py-3 font-mono text-body-small text-on-surface">{row.entry}</td>
                    <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface">
                      {bytes(row.gzipBytes)}
                    </td>
                    <td class="px-4 py-3 text-on-surface-variant">{row.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <p class="mt-4 max-w-3xl text-body-medium text-on-surface-variant">
        Use <code>jsonSchemaFullFeature</code>. Reach for
        <code>./plugins/jsonSchema</code> when you want the per-field chain method — not to save
        bytes. <a class="text-primary underline underline-offset-2" href="/json-schema">Both doors
        are explained on the JSON Schema page.</a>
      </p>
    </section>

    <!-- ================= Throughput ================= -->
    <section id="throughput" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">Throughput</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        Recorded {perfBaseline.recordedAt.slice(0, 10)}. Each figure is the median of the fastest
        half of {conditions.sampleCount} samples;
        <code>abortEarly: {String(conditions.abortEarly)}</code> with input the validator accepts,
        so no rule is skipped. The relative spread on every figure is in the last column — treat
        differences smaller than that as noise.
      </p>

      <div class="md-card md-card-outlined overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[48rem] border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline-variant text-label-large text-on-surface-variant">
                <th class="px-4 py-3 text-left font-medium">Shape</th>
                <th class="px-4 py-3 text-right font-medium">validate ops/sec</th>
                <th class="px-4 py-3 text-right font-medium">parse ops/sec</th>
                <th class="px-4 py-3 text-right font-medium">spread</th>
              </tr>
            </thead>
            <tbody>
              {
                throughputByShape.map((row) => (
                  <tr class="border-b border-outline-variant/60 last:border-0">
                    <td class="px-4 py-3 align-top">
                      <span class="text-on-surface">{row.label}</span>
                      <span class="mt-0.5 block text-body-small text-on-surface-variant">
                        {row.declares}
                      </span>
                      <span class="mt-2 block h-1.5 w-full overflow-hidden rounded-shape-full bg-outline-variant">
                        <span
                          class="block h-full rounded-shape-full bg-primary"
                          style={`width: ${barWidth(row.validate?.opsPerSecond ?? 0, fastestValidate)}%`}
                        />
                      </span>
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right align-top font-mono text-on-surface">
                      {ops(row.validate?.opsPerSecond ?? 0)}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right align-top font-mono text-on-surface">
                      {ops(row.parse?.opsPerSecond ?? 0)}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right align-top font-mono text-on-surface-variant">
                      ±{row.validate?.relativeSpreadPercent}%
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <p class="mt-4 max-w-3xl text-body-medium text-on-surface-variant">
        <code>parse</code> and <code>validate</code> land within each other's spread on every
        shape: transforms run last and only in <code>parse</code>, and these shapes declare none.
      </p>
    </section>

    <!-- ================= Against 1.x ================= -->
    <section id="against-1x" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">Against 1.x</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        1.x's source and this source, both transpiled the same way, interleaved sample by sample in
        one process on one machine. 1.x carried a directory of specialised fast paths that this
        implementation has no equivalent of, and on flat shapes that is what the numbers show.
      </p>

      <div class="md-card md-card-outlined overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[42rem] border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline-variant text-label-large text-on-surface-variant">
                <th class="px-4 py-3 text-left font-medium">Shape</th>
                <th class="px-4 py-3 text-right font-medium">1.x</th>
                <th class="px-4 py-3 text-right font-medium">this release</th>
                <th class="px-4 py-3 text-right font-medium">ratio</th>
              </tr>
            </thead>
            <tbody>
              {
                legacyRows.map((row) => {
                  const isRegression = (row.entry?.speedup ?? 1) < 1;
                  return (
                    <tr class="border-b border-outline-variant/60 last:border-0">
                      <td class="px-4 py-3 text-on-surface">{row.label}</td>
                      <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface-variant">
                        {ops(row.entry?.legacyOpsPerSecond ?? 0)}
                      </td>
                      <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface">
                        {ops(row.entry?.currentOpsPerSecond ?? 0)}
                      </td>
                      <td class="whitespace-nowrap px-4 py-3 text-right">
                        <span
                          class:list={[
                            'inline-flex h-7 items-center rounded-shape-full px-3 text-label-large font-mono',
                            isRegression
                              ? 'bg-error-container text-on-error-container'
                              : 'bg-tertiary-container text-on-tertiary-container',
                          ]}
                        >
                          ×{row.entry?.speedup}
                        </span>
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </div>

      <p class="mt-4 max-w-3xl text-body-medium text-on-surface-variant">
        The result was checked for measurement artefacts before it was published: rotating distinct
        inputs instead of one frozen object changed nothing, and 1.x demonstrably rejects bad values
        on all five shapes, so it is not doing less work. It is simply faster on the flat cases.
      </p>
    </section>

    <!-- ================= Competitors ================= -->
    <section id="against-others" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">
        Against zod, valibot, ajv and yup
      </h2>
      <p class="mb-4 max-w-3xl text-body-medium text-on-surface-variant">
        Measured here, in one process, interleaved sample by sample against the same value pools.
        Luq is faster in <strong class="text-on-surface">{competitorBenchmark.luqWins} of
        {competitorBenchmark.total}</strong> pairings. The other
        {competitorBenchmark.total - competitorBenchmark.luqWins} are losses and they are in the
        same table.
      </p>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        <strong class="text-on-surface">Judgements are compared before anything is timed.</strong>
        Only values every library answers the same way are timed, because a ratio against a library
        doing different work is not a slow number, it is a wrong one. Where they disagree, the value
        is listed below rather than dropped. That check earned its place immediately: the first run
        had ajv rejecting every accepted array value, which turned out to be a missing backslash in
        the JSON Schema written here — an error of ours, not a difference of ajv's.
      </p>

      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        The same measurement runs on every push and every pull request. What CI <em>gates</em> on
        is narrower and on purpose: whether the libraries still agree about which values are valid.
        That is deterministic. Throughput is not, and a ratio gate that moves with the runner was
        already tried in this repository and had to be given per-environment floors.
      </p>

      <div class="mb-6 md-card md-card-outlined overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[46rem] border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline-variant text-label-large text-on-surface-variant">
                <th class="px-4 py-3 text-left font-medium">Shape</th>
                <th class="px-4 py-3 text-left font-medium">Library</th>
                <th class="px-4 py-3 text-right font-medium">Luq ops/sec</th>
                <th class="px-4 py-3 text-right font-medium">Theirs ops/sec</th>
                <th class="px-4 py-3 text-right font-medium">Ratio</th>
              </tr>
            </thead>
            <tbody>
              {
                competitorBenchmark.rows.map((row) => (
                  <tr class="border-b border-outline-variant/60 last:border-0">
                    <td class="whitespace-nowrap px-4 py-3 font-mono text-body-small text-on-surface">
                      {row.shape}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-on-surface-variant">
                      {row.competitor} {row.version}
                    </td>
                    <td class="px-4 py-3 text-right font-mono tabular-nums text-on-surface">
                      {row.luq}
                    </td>
                    <td class="px-4 py-3 text-right font-mono tabular-nums text-on-surface-variant">
                      {row.other}
                    </td>
                    <td
                      class={`px-4 py-3 text-right font-mono tabular-nums ${
                        row.luqIsFaster ? 'text-primary' : 'text-error'
                      }`}
                    >
                      ×{row.ratio}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      {
        competitorBenchmark.disagreements.length > 0 && (
          <div class="mb-6 md-card md-card-filled p-6">
            <h3 class="mb-2 text-title-medium text-on-surface">
              Where a library disagreed, and was therefore not timed on that value
            </h3>
            <ul class="space-y-2 text-body-small text-on-surface-variant">
              {competitorBenchmark.disagreements.map((one) => (
                <li>
                  <code class="font-mono">
                    {one.shape} / {one.competitor}
                  </code>{' '}
                  — Luq said {String(one.luqSaid)}, it said {String(!one.luqSaid)} for{' '}
                  <code class="font-mono">{one.value}</code>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-body-small text-on-surface-variant">
              This is a difference in what the libraries consider valid, not in how fast they are.
              Neither answer is a bug.
            </p>
          </div>
        )
      }

      <div class="md-card md-card-filled p-6">
        <h3 class="mb-2 text-title-medium text-on-surface">
          Reading the ajv column, which is the interesting one
        </h3>
        <p class="mb-3 text-body-medium text-on-surface-variant">
          ajv is an order of magnitude faster than Luq on every shape here, and it is faster for a
          structural reason: it compiles a schema into generated JavaScript. That is a real
          advantage and it is not going away.
        </p>
        <p class="mb-3 text-body-medium text-on-surface-variant">
          <strong class="text-on-surface">What is NOT true is that this makes ajv unusable under a
          strict Content-Security-Policy.</strong> <code>ajv/dist/standalone</code> precompiles a
          schema to a module ahead of time, and the generated source contains no dynamic code —
          generated and inspected while writing this page. With build-time schemas, ajv is fine
          under a strict CSP, and saying otherwise would be an easy thing to claim and a wrong one.
        </p>
        <p class="text-body-medium text-on-surface-variant">
          The difference is a schema that is only known at <strong class="text-on-surface">run
          time</strong> — one that arrives from a server, sits in a database, or is written by the
          user. Precompiling is then impossible by construction, and a code-generating validator has
          to build a function in the browser, which is exactly what the policy forbids. Luq turns a
          runtime document into rules and generates nothing, so it keeps working. If your schemas
          are fixed at build time, ajv's speed is yours to take.
        </p>
      </div>
    </section>

    <!-- ================= Build cost ================= -->
    <section id="build-cost" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">What <code>build()</code> costs</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        <code>build()</code> compiles the plan once; <code>validate()</code> walks it. Build a
        validator at module scope and reuse it — the last column is how many <code>validate()</code>
        calls it takes for one <code>build()</code> to have paid for itself.
      </p>

      <div class="md-card md-card-outlined overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[42rem] border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline-variant text-label-large text-on-surface-variant">
                <th class="px-4 py-3 text-left font-medium">Shape</th>
                <th class="px-4 py-3 text-right font-medium">µs per build()</th>
                <th class="px-4 py-3 text-right font-medium">builds/sec</th>
                <th class="px-4 py-3 text-right font-medium">breaks even after</th>
              </tr>
            </thead>
            <tbody>
              {
                buildCostRows.map((row) => (
                  <tr class="border-b border-outline-variant/60 last:border-0">
                    <td class="px-4 py-3 text-on-surface">{row.label}</td>
                    <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface">
                      {row.entry?.microsecondsPerBuild}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface-variant">
                      {ops(row.entry?.buildsPerSecond ?? 0)}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface">
                      {row.entry?.validateCallsPerBuild} calls
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <p class="mt-4 max-w-3xl text-body-medium text-on-surface-variant">
        The 50-element array breaks even after 2 calls only because <code>validate()</code> itself
        costs about 33&nbsp;µs there. The JSON Schema document is the expensive build:
        {buildCostRows[4].entry?.microsecondsPerBuild}&nbsp;µs, because converting a document is
        real work — done once.
      </p>
    </section>

    <!-- ================= The gate ================= -->
    <section id="the-gate" class="mb-16 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">What CI actually gates on</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        Not an absolute ops/sec — a CI runner's speed varies too much for that to mean anything.
        The gate is the <strong class="text-on-surface">ratio</strong> between Luq and a
        hand-written validator measured in the same process on the same inputs, so the runner's
        speed cancels out. If the ratio drops below the recorded floor, the build goes red.
      </p>

      <div class="md-card md-card-outlined overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[44rem] border-collapse text-body-medium">
            <thead>
              <tr class="border-b border-outline-variant text-label-large text-on-surface-variant">
                <th class="px-4 py-3 text-left font-medium">Shape</th>
                <th class="px-4 py-3 text-left font-medium">Operation</th>
                <th class="px-4 py-3 text-right font-medium">ratio to hand-written</th>
                <th class="px-4 py-3 text-right font-medium">floor</th>
              </tr>
            </thead>
            <tbody>
              {
                gatedRows.map((row) => (
                  <tr class="border-b border-outline-variant/60 last:border-0">
                    <td class="px-4 py-3 text-on-surface">{shapeLabels[row.shape]}</td>
                    <td class="px-4 py-3 font-mono text-body-small text-on-surface-variant">
                      {row.operation}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface">
                      {row.ratio}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right font-mono text-on-surface-variant">
                      {row.ratioFloor}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-6 md-card md-card-filled p-6">
        <h3 class="mb-2 text-title-medium text-on-surface">How sensitive is that gate?</h3>
        <p class="mb-3 text-body-medium text-on-surface-variant">
          Measured by deliberately slowing every shape down and watching what the gate does
          ({perfBaseline.gateSensitivity.method}):
        </p>
        <ul class="space-y-1.5 text-body-medium text-on-surface-variant">
          {
            perfBaseline.gateSensitivity.detail.map((line) => (
              <li class="flex gap-2">
                <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-shape-full bg-outline" />
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-body-medium text-on-surface">
          So: a slowdown of {perfBaseline.gateSensitivity.caughtSlowdownPercent}% is caught, and one
          of {perfBaseline.gateSensitivity.missedSlowdownPercent}% is not. That is the honest
          resolution of this gate, and it is written down rather than assumed.
        </p>
      </div>
    </section>

    <!-- ================= Method ================= -->
    <section id="method" class="mb-16 scroll-mt-24">
      <h2 class="mb-6 text-headline-medium text-on-surface">Method</h2>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="md-card md-card-outlined p-6">
          <h3 class="mb-3 text-title-medium text-on-surface">Machine</h3>
          <dl class="space-y-2 text-body-medium">
            <div class="flex justify-between gap-4">
              <dt class="text-on-surface-variant">CPU</dt>
              <dd class="text-right text-on-surface">{machine.cpuModel}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-on-surface-variant">Logical cores</dt>
              <dd class="text-on-surface">{machine.logicalCores}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-on-surface-variant">Memory</dt>
              <dd class="text-on-surface">{machine.totalMemoryGb} GB</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-on-surface-variant">Node</dt>
              <dd class="font-mono text-on-surface">{machine.nodeVersion}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-on-surface-variant">Platform</dt>
              <dd class="font-mono text-on-surface">{machine.platform} / {machine.arch}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-on-surface-variant">Recorded</dt>
              <dd class="font-mono text-on-surface">{perfBaseline.recordedAt.slice(0, 10)}</dd>
            </div>
          </dl>
        </div>

        <div class="md-card md-card-outlined p-6">
          <h3 class="mb-3 text-title-medium text-on-surface">Conditions</h3>
          <ul class="space-y-2 text-body-medium text-on-surface-variant">
            <li>
              <span class="text-on-surface">Subject:</span> {conditions.moduleUnderTest}
            </li>
            <li>
              <span class="text-on-surface">Samples:</span> {conditions.sampleCount}, each targeting
              {' '}{conditions.targetSampleMs} ms; the reported figure is the median of the fastest half
            </li>
            <li>
              <span class="text-on-surface">Options:</span>
              <code>abortEarly: {String(conditions.abortEarly)}</code>, input accepted, so every rule runs
            </li>
            <li>
              <span class="text-on-surface">Inputs:</span> {conditions.inputRotation}
            </li>
            <li>
              <span class="text-on-surface">Array shape:</span>
              {conditions.arrayElementCount} elements
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-6 md-card md-card-outlined p-6">
        <h3 class="mb-3 text-title-medium text-on-surface">Bundle size method</h3>
        <ul class="space-y-2 text-body-medium text-on-surface-variant">
          <li><span class="text-on-surface">Bundler:</span> {sizeBudget.method.bundler}</li>
          <li>
            <span class="text-on-surface">Options:</span>
            <code>bundle</code>, <code>minify</code>, <code>format: esm</code>,
            <code>target: es2020</code>, <code>platform: neutral</code>,
            <code>treeShaking</code>, no legal comments
          </li>
          <li>
            <span class="text-on-surface">Compression:</span> <code>node:zlib</code>
            <code>gzipSync</code> at its default level
          </li>
          <li>
            <span class="text-on-surface">Measured from:</span> the TypeScript in
            <code>src/</code>, not <code>dist/</code> — the package ships unbundled ESM, so the
            tree a reader's bundler walks is the same tree esbuild walks here
          </li>
          <li>
            <span class="text-on-surface">Entry shape:</span> a synthetic module that re-exports
            only the named symbols, so only code reachable from those names survives
          </li>
          <li>
            <span class="text-on-surface">Comparability:</span> these are the options 1.x's own
            <code>bundle-size-comparison</code> used. Without that, the 1.x column would not be a
            comparison at all
          </li>
          <li>
            <span class="text-on-surface">Node:</span> <code>{sizeBudget.recorded.node}</code>,
            recorded {sizeBudget.recorded.date}, over
            {' '}{sizeBudget.recorded.catalogPluginCount} catalogue plugins
          </li>
        </ul>
      </div>
    </section>

    <!-- ================= Reproduce ================= -->
    <section id="reproduce" class="mb-12 scroll-mt-24">
      <h2 class="mb-2 text-headline-medium text-on-surface">Reproduce it</h2>
      <p class="mb-6 max-w-3xl text-body-medium text-on-surface-variant">
        Clone the repository and run these. <code>bench:record</code> overwrites
        <code>config/perf-baseline.json</code>, which is the file this page reads — so the numbers
        above are exactly what the last recorded run produced, on the machine named above and not
        on yours.
      </p>
      <CodeBlock code={reproduceCommands} language="bash" fileName="repository root" />
    </section>

    <nav class="flex flex-wrap gap-3" aria-label="Related pages">
      <a class="md-button md-button-filled md-state-layer" href="/docs/getting-started">
        Get started
      </a>
      <a class="md-button md-button-tonal md-state-layer" href="/json-schema">
        JSON Schema conformance
      </a>
      <a class="md-button md-button-outlined md-state-layer" href="/plugins">
        Browse plugins
      </a>
    </nav>
  </main>

  <Footer />
</BaseLayout>
