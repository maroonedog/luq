---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header, { navItems } from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SimplifiedFeatures from '../components/SimplifiedFeatures.astro';
import CodeExample from '../components/CodeExample.astro';
import PracticalExamples from '../components/PracticalExamples.astro';
import Footer from '../components/Footer.astro';
import MobileMenuOverlay from '../components/MobileMenuOverlay.astro';

const description =
  'Luq is a TypeScript validation library that validates the types you already have. Declare rules against your own type’s field paths; every rule is a plugin you imported by name.';
---

<BaseLayout
  title="Validation for the types you already have"
  description={description}
>
  <Header />
  <MobileMenuOverlay navItems={navItems} />

  <main>
    <Hero />

    <section class="bg-surface-container-low px-4 py-20 sm:px-6 lg:px-8">
      <div class="container mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-3 text-headline-medium text-on-surface">The whole thing, on one screen</h2>
          <p class="mx-auto max-w-2xl text-body-large text-on-surface-variant">
            A builder that takes your type, and a result you narrow with
            <code class="font-mono">valid</code>. There is no <code class="font-mono">Result</code>
            class, no <code class="font-mono">unwrap()</code>, and
            <code class="font-mono">build()</code> returns an object rather than a function.
          </p>
        </div>
        <CodeExample />
      </div>
    </section>

    <PracticalExamples />

    <SimplifiedFeatures />

    <section class="bg-surface-container px-4 py-20 sm:px-6 lg:px-8">
      <div class="container mx-auto max-w-3xl text-center">
        <h2 class="mb-4 text-headline-medium text-on-surface">Coming from 1.x?</h2>
        <p class="mb-8 text-body-large text-on-surface-variant">
          This release is a rewrite, and it breaks things on purpose.
          <code class="font-mono">build()</code> returns an object,
          <code class="font-mono">result.isValid()</code> and
          <code class="font-mono">result.errors</code> are gone in favour of
          <code class="font-mono">result.valid</code> and
          <code class="font-mono">result.issues</code>, and
          <code class="font-mono">abortEarly</code> still defaults to
          <code class="font-mono">true</code>. It is also slower than 1.x on flat and
          nested shapes; the benchmarks page says by how much rather than leaving it out.
        </p>
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/docs/getting-started" class="md-button md-button-filled md-state-layer md-focus-ring">
            Get started
          </a>
          <a href="/benchmarks" class="md-button md-button-tonal md-state-layer md-focus-ring">
            Read the measurements
          </a>
          <a href="/plugins" class="md-button md-button-outlined md-state-layer md-focus-ring">
            All 77 plugins
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
