---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SimplifiedFeatures from '../components/SimplifiedFeatures.astro';
import CodeExample from '../components/CodeExample.astro';
import PracticalExamples from '../components/PracticalExamples.astro';
import Footer from '../components/Footer.astro';

const description =
  'Luq is a TypeScript validation library that validates the types you already have. Declare rules against your own type’s field paths; every rule is a plugin you imported by name.';
---

<BaseLayout
  title="The wrong rule does not compile"
  description={description}
>
  <Header />

  <main>
    <Hero />

    <section class="border-t border-outline-variant bg-surface-container px-4 py-20 sm:px-6 lg:px-8">
      <div class="container mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="mb-3 text-headline-medium text-on-surface">The whole API</h2>
          <p class="mx-auto max-w-2xl text-body-large text-on-surface-variant">
            A builder that takes your type, and a result you narrow with{' '}
            <code class="font-mono">valid</code>. There is no <code class="font-mono">Result</code>{' '}
            class, no <code class="font-mono">unwrap()</code>, and{' '}
            <code class="font-mono">build()</code> returns an object rather than a function.
          </p>
        </div>
        <CodeExample />
      </div>
    </section>

    <PracticalExamples />

    <SimplifiedFeatures />

    <section class="border-t border-outline-variant bg-surface-container px-4 py-20 sm:px-6 lg:px-8">
      <div class="container mx-auto max-w-3xl text-center">
        <h2 class="mb-4 text-headline-medium text-on-surface">Where to start</h2>
        <p class="mb-4 text-body-large text-on-surface-variant">
          Install it, declare one rule against a type you already have, and read the
          result — that is the whole first hour. It is slower than 1.x on flat and
          nested shapes, and the benchmarks page says by how much rather than
          leaving it out.
        </p>
        <p class="mb-8 text-body-medium text-on-surface-variant">
          Coming from 1.x, the mapping from the old{' '}
          <code class="font-mono">Result</code> to today's discriminated union is on
          the{' '}
          <a class="text-primary underline underline-offset-2" href="/docs/api/validator#porting"
            >Validator page</a
          >, beside the API it maps onto.
        </p>
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/docs/getting-started" class="md-button md-button-filled md-state-layer md-focus-ring">
            Get started
          </a>
          <a href="/benchmarks" class="md-button md-button-tonal md-state-layer md-focus-ring">
            Read the measurements
          </a>
          <a href="/luq-or-zod" class="md-button md-button-outlined md-state-layer md-focus-ring">
            Luq or zod?
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
