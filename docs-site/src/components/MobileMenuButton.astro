---
/**
 * Trailing icon button in the top app bar that opens the modal navigation
 * drawer. Rendered by Header.astro; the drawer itself is MobileMenuOverlay.
 */
---

<button
  id="mobile-menu-toggle"
  type="button"
  class="md-icon-button md-state-layer md-focus-ring md:hidden"
  aria-label="Open navigation menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
>
  <span class="md-icon" aria-hidden="true">menu</span>
</button>
