---
import CodeBlock from './CodeBlock.astro';

/**
 * MD3 outlined card for one plugin in the catalogue.
 *
 * The shape matches the rewrite's plugin metadata: a camelCase subpath `name`,
 * the exported `symbol`, the chain `method` it adds, and the `slots` (field
 * types) it may be used on. There is no `category` and no per-plugin bundle
 * size — 1.x had both and neither survives in the rewrite's metadata.
 *
 * `symbol` is passed rather than derived: it is usually `name + "Plugin"`, but
 * `objectAdditionalProperties` exports two symbols and one of them is
 * `objectAdditionalPropertiesSchemaPlugin`, so deriving it would be wrong.
 *
 * Outlined, not elevated: a grid of many cards reads as a list, and MD3 uses
 * outlined cards where elevation would compete across a dense collection.
 */
export interface Props {
  plugin: {
    /** camelCase subpath name under @maroonedog/luq/plugins, e.g. "stringMin". */
    name: string;
    /** Exported symbol, e.g. "stringMinPlugin". */
    symbol: string;
    /** Full import specifier. */
    subpath: string;
    /** Chain method the plugin adds, without parentheses, e.g. "min". */
    method: string;
    /** Field types the method may be called on, e.g. ["string"]. */
    slots: readonly string[];
    description: string;
  };
  /** Optional link on the card's title. Omitted renders a non-linking title. */
  href?: string;
  /** Adds the "add to builder" checkbox and the details button. */
  selectable?: boolean;
}

const { plugin, href, selectable = false } = Astro.props;

const importStatement = `import { ${plugin.symbol} } from "${plugin.subpath}";`;
const checkboxId = `select-${plugin.symbol}`;

// Descriptions are written with Markdown backticks around identifiers. Split on
// them so `.min()` renders as code rather than as literal backticks.
const descriptionParts = plugin.description.split(/`([^`]+)`/);
---

<article
  class="md-card md-card-outlined plugin-card flex h-full flex-col gap-3 p-4"
  data-plugin-symbol={plugin.symbol}
  data-plugin-name={plugin.name}
  data-plugin-method={plugin.method}
  data-plugin-slots={plugin.slots.join(' ')}
>
  <!--
    flex-wrap, and no min-w-0 on the title: a long name like
    `objectAdditionalProperties` next to a long badge like
    `.additionalPropertiesSchema()` must push the badge onto its own line, not
    hyphenate the name down the middle of a word.
  -->
  <header class="flex flex-wrap items-start justify-between gap-2">
    <h3 class="md-title-medium text-on-surface">
      {
        href ? (
          <a href={href} class="md-focus-ring rounded-shape-xs hover:text-primary">
            {plugin.name}
          </a>
        ) : (
          plugin.name
        )
      }
    </h3>
    <code
      class="md-label-medium shrink-0 rounded-shape-xs bg-tertiary-container px-2 py-1 font-mono text-on-tertiary-container"
      >.{plugin.method}()</code
    >
  </header>

  <p class="md-body-medium flex-1 text-on-surface-variant">
    {
      descriptionParts.map((part, index) =>
        index % 2 === 1 ? (
          <code class="rounded-shape-xs bg-surface-container-highest px-1 py-0.5 font-mono text-[0.9em] text-on-surface">
            {part}
          </code>
        ) : (
          part
        )
      )
    }
  </p>

  <ul class="flex flex-wrap gap-1.5" aria-label="Field types">
    {
      plugin.slots.map((slot) => (
        <li class="md-chip md-chip-static md-label-medium h-6 px-2">{slot}</li>
      ))
    }
  </ul>

  <CodeBlock code={importStatement} language="typescript" showCopy={true} />

  {
    selectable && (
      <div class="flex items-center justify-between gap-2 border-t border-outline-variant pt-3">
        <label
          class="md-label-large md-focus-ring inline-flex cursor-pointer items-center gap-2 rounded-shape-sm text-on-surface"
          for={checkboxId}
        >
          <input
            type="checkbox"
            id={checkboxId}
            class="plugin-checkbox h-[18px] w-[18px] accent-[var(--md-sys-color-primary)]"
            data-plugin-symbol={plugin.symbol}
          />
          Add to builder
        </label>
        <button
          type="button"
          class="md-button md-button-text md-state-layer plugin-details-button"
          data-plugin-symbol={plugin.symbol}
        >
          Details
        </button>
      </div>
    )
  }
</article>
