---
/**
 * MD3 modal navigation drawer for the primary navigation.
 *
 * Placed once per page at body level; MobileMenuButton (in the top app bar)
 * opens it. Slides in from the leading edge over a 32% scrim, with the
 * emphasized-decelerate easing MD3 specifies for entering elements.
 */
export interface Props {
  navItems: Array<{ href: string; label: string; icon?: string }>;
}

const { navItems } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<div id="mobile-menu" class="fixed inset-0 z-[100] hidden md:hidden">
  <div id="mobile-menu-scrim" class="md-scrim opacity-0"></div>

  <div
    id="mobile-menu-panel"
    class="md-nav-drawer-modal fixed inset-y-0 left-0 flex w-80 max-w-[85vw] -translate-x-full flex-col"
    role="dialog"
    aria-modal="true"
    aria-label="Navigation"
  >
    <div class="flex items-center justify-between py-4 pl-6 pr-4">
      <span class="md-title-small text-on-surface-variant">Luq</span>
      <button
        id="mobile-menu-close"
        type="button"
        class="md-icon-button md-state-layer md-focus-ring"
        aria-label="Close navigation menu"
      >
        <span class="md-icon" aria-hidden="true">close</span>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-3 pb-4" aria-label="Primary">
      <ul class="space-y-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="md-nav-drawer-item md-state-layer md-focus-ring"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.icon && (
                  <span class="md-icon md-icon-sm" aria-hidden="true">
                    {item.icon}
                  </span>
                )}
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <hr class="md-divider" />

    <div class="p-4">
      <a
        href="https://github.com/maroonedog/luq"
        target="_blank"
        rel="noopener noreferrer"
        class="md-button md-button-tonal md-state-layer md-focus-ring w-full"
      >
        <span class="md-icon md-icon-sm" aria-hidden="true">open_in_new</span>
        GitHub
      </a>
    </div>
  </div>
</div>

<style>
  #mobile-menu-panel {
    transition: transform var(--md-sys-motion-duration-medium-4)
      var(--md-sys-motion-easing-emphasized-decelerate);
  }

  #mobile-menu-scrim {
    transition: opacity var(--md-sys-motion-duration-medium-2)
      var(--md-sys-motion-easing-emphasized);
  }
</style>

<script>
  function bindMobileMenu(): void {
    const menu = document.getElementById('mobile-menu');
    const panel = document.getElementById('mobile-menu-panel');
    const scrim = document.getElementById('mobile-menu-scrim');
    const toggle = document.getElementById('mobile-menu-toggle');
    const close = document.getElementById('mobile-menu-close');
    if (!menu || !panel || !scrim || menu.dataset.bound === 'true') return;
    menu.dataset.bound = 'true';

    const open = () => {
      menu.classList.remove('hidden');
      // Let the browser paint the off-screen state before animating in.
      requestAnimationFrame(() => {
        panel.classList.remove('-translate-x-full');
        scrim.classList.remove('opacity-0');
      });
      toggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      close?.focus();
    };

    const dismiss = () => {
      panel.classList.add('-translate-x-full');
      scrim.classList.add('opacity-0');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      window.setTimeout(() => menu.classList.add('hidden'), 400);
      toggle?.focus();
    };

    toggle?.addEventListener('click', open);
    close?.addEventListener('click', dismiss);
    scrim.addEventListener('click', dismiss);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) dismiss();
    });

    // A drawer left open across a resize to desktop would trap the scroll lock.
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && !menu.classList.contains('hidden')) dismiss();
    });
  }

  bindMobileMenu();
  document.addEventListener('astro:page-load', bindMobileMenu);
</script>
