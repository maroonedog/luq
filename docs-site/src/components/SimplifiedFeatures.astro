---
import CodeBlock from './CodeBlock.astro';
import { bundleSize } from '../data/bundle-size';
import { conformance } from '../data/conformance';

// Read, never hand-written. These figures were once typed here and went
// stale while the page body already read the generated data — the code
// sample inside the component was the part left behind.
const corePercent = (
  (bundleSize.coreOnly.bytes / bundleSize.fullFeature.bytes) *
  100
).toFixed(1);

/**
 * What Luq costs you and what it covers, each claim with the code that backs it.
 *
 * "Your type is the schema" used to open this list. It is now the hero's
 * must-fail block, where the compiler makes the claim instead of a comment: the
 * two "-> compile error" annotations that lived in the example below were
 * written inside a block that compiles precisely because the offending lines are
 * commented out, which is the opposite of proof.
 *
 * Where a claim carries a number, the number is measured on this repository and
 * the file it came from is named in the block. The 1.x version of this file
 * ended its bundle example with "// Final bundle: ~19KB gzipped", a figure that
 * belonged to a core bundle 2.3x this one's size.
 */
const features = [
  {
    icon: 'extension',
    title: 'A plugin you did not import has no method',
    description:
      'There is no registry to populate and no barrel you have to pay for. .use() puts a plugin in the builder’s bag, and the bag decides which methods exist on which slots — so an unimported rule is not merely absent at runtime, it does not typecheck.',
    fileName: 'draft.ts',
    example: `import { Builder } from "@maroonedog/luq";
import { requiredPlugin } from "@maroonedog/luq/plugins/required";

type Draft = { title: string };

const draftValidator = Builder()
  .use(requiredPlugin)
  .for<Draft>()
  // \`.min(3)\` is not offered here: stringMinPlugin
  // was never \`use\`d, so the method does not exist.
  .v("title", (b) => b.string.required())
  .build();`,
  },
  {
    icon: 'deployed_code',
    title: 'You pay for what you import',
    description:
      `Measured with esbuild and gzip. The core is ${corePercent}% of the all-plugins build — the floor you pay before importing anything, which is the part a bundle-size claim usually hides.`,
    fileName: 'imports.ts',
    example: `// Six plugins, six imports.
import { requiredPlugin } from "@maroonedog/luq/plugins/required";
import { stringMinPlugin } from "@maroonedog/luq/plugins/stringMin";
import { stringMaxPlugin } from "@maroonedog/luq/plugins/stringMax";
import { stringEmailPlugin } from "@maroonedog/luq/plugins/stringEmail";
import { numberMinPlugin } from "@maroonedog/luq/plugins/numberMin";
import { numberMaxPlugin } from "@maroonedog/luq/plugins/numberMax";

// Measured gzip — config/size-budget.json:
//   Builder alone ............. ${bundleSize.coreOnly.gzip}
//   Builder + these six ....... ${bundleSize.sixPlugin.gzip}
//   Builder + all 77 plugins .. ${bundleSize.fullFeature.gzip}`,
  },
  {
    icon: 'compare_arrows',
    title: 'Rules that read other fields',
    description:
      'compareField resolves the other field’s path once, at build time. requiredIf is a presence rule rather than a check, so it decides the field’s gate instead of only rejecting an empty string that already got through.',
    fileName: 'signup.ts',
    example: `type Signup = {
  password: string;
  confirmPassword: string;
  contactMethod: "email" | "phone";
  phone?: string;
};

Builder()
  .use(requiredPlugin)
  .use(stringMinPlugin)
  .use(compareFieldPlugin)
  .use(requiredIfPlugin)
  .for<Signup>()
  .v("password", (b) => b.string.required().min(12))
  .v("confirmPassword", (b) =>
    b.string.required().compareField("password")
  )
  .v("phone", (b) =>
    b.string.requiredIf((data) => data.contactMethod === "phone")
  )
  .build();`,
  },
  {
    icon: 'schema',
    title: 'JSON Schema, with the score written down',
    description:
      `${conformance.passingCases} of ${conformance.caseCount} cases on the official Draft-07 suite — required tests only, skipped cases counted as failures. Read it against the trivial floor: a validator that returned true unconditionally scores ${conformance.validCases} / ${conformance.caseCount} = ${conformance.trivialPercent}% on the same corpus.`,
    fileName: 'account.ts',
    example: `import { fromJsonSchema } from "@maroonedog/luq/plugins/jsonSchemaFullFeature";

type Account = { email: string; age?: number };

const accountValidator = fromJsonSchema<Account>({
  type: "object",
  properties: {
    email: { type: "string", format: "email" },
    age: { type: "number", minimum: 18 },
  },
  required: ["email"],
});

// ${conformance.headline} — docs/json-schema-conformance.md`,
  },
];
---

<section class="border-t border-outline-variant bg-surface px-4 py-14 sm:px-6 lg:px-8">
  <div class="container mx-auto max-w-6xl">
    <div class="mb-8 text-center">
      <h2 class="mb-3 text-headline-medium text-on-surface">
        What it costs and what it covers
      </h2>
      <p class="mx-auto max-w-2xl text-body-large text-on-surface-variant">
        Four claims, each with the code that backs it and the file the number came from.
      </p>
    </div>

    <div class="space-y-12">
      {
        features.map((feature, index) => (
          <div class="grid items-center gap-8 lg:grid-cols-2">
            <div class:list={['min-w-0', index % 2 === 1 && 'lg:order-2']}>
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-shape-md bg-primary-container">
                <span class="md-icon text-on-primary-container" aria-hidden="true">
                  {feature.icon}
                </span>
              </div>
              <h3 class="mb-3 text-headline-small text-on-surface">{feature.title}</h3>
              <p class="text-body-large text-on-surface-variant">{feature.description}</p>
            </div>

            <div class:list={['min-w-0', index % 2 === 1 && 'lg:order-1']}>
              <CodeBlock
                code={feature.example}
                language="typescript"
                fileName={feature.fileName}
                showCopy={false}
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
