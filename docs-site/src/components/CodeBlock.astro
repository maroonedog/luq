---
/**
 * Code block on the MD3 code surface.
 *
 * The surface stays dark in both schemes; its background, border and syntax
 * colours are the `--md-code-*` tokens, which are generated MD3 tones measured
 * for contrast against that surface (see scripts/generate-md3-tokens.mjs).
 *
 * `showWindowControls` now means "show the toolbar" — the 1.x traffic-light
 * dots imitated a macOS window and carried no information.
 *
 * `invalid` marks a block the compiler refuses. It forces the toolbar on, puts
 * "Does not compile" where the Copy button would be, and removes Copy. The code
 * surface and its syntax colours are untouched: those tones are measured
 * against that exact background, so tinting it would invalidate every ratio
 * recorded in md3-tokens.css. Only the label carries the error role.
 */
export interface Props {
  code: string;
  language?: string;
  class?: string;
  showCopy?: boolean;
  showWindowControls?: boolean;
  fileName?: string;
  id?: string;
  invalid?: boolean;
}

const {
  code,
  language = 'typescript',
  class: className = '',
  showCopy = true,
  showWindowControls = false,
  fileName = '',
  id = '',
  invalid = false,
} = Astro.props;

// A refused block is never copyable, whatever the caller asked for.
const showCopyButton = showCopy && !invalid;
const showToolbar = showWindowControls || fileName !== '' || showCopyButton || invalid;
const blockId = id || `code-${Math.random().toString(36).slice(2, 10)}`;
---

<div class:list={['md-code-surface overflow-hidden', className]}>
  {
    showToolbar && (
      <div class="md-code-toolbar">
        <span class="md-label-medium truncate">{fileName || language}</span>
        {invalid && (
          /*
           * `dark` is not decoration: the toolbar keeps the code surface's dark
           * background in both schemes, so the light-scheme `error` tone would
           * land on it at 2.55:1. Resolving the role against the dark scheme —
           * the scheme this island actually is — puts the label at 9.70:1,
           * clear of the 7.19:1 floor DESIGN.md records for dark text pairs.
           */
          <span class="dark inline-flex h-8 shrink-0 items-center gap-1.5 px-3 text-label-large text-error">
            <span class="md-icon md-icon-sm" aria-hidden="true">
              cancel
            </span>
            Does not compile
          </span>
        )}
        {showCopyButton && (
          <button
            type="button"
            class="copy-button md-state-layer md-focus-ring inline-flex h-8 items-center gap-1.5 rounded-shape-full px-3 text-label-medium"
            data-copy-target={blockId}
          >
            <span class="md-icon text-[16px] leading-none" aria-hidden="true">
              content_copy
            </span>
            <span class="copy-button-label">Copy</span>
          </button>
        )}
      </div>
    )
  }
  <pre
    id={blockId}
    class="overflow-x-auto p-4"><code class={`language-${language}`}>{code}</code></pre>
</div>

<script>
  function bindCopyButtons(): void {
    document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';

      button.addEventListener('click', async () => {
        const targetId = button.dataset.copyTarget;
        const source = targetId ? document.getElementById(targetId) : null;
        const text = source?.textContent ?? '';
        if (text === '') return;

        const label = button.querySelector('.copy-button-label');
        try {
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = 'Copied';
        } catch {
          if (label) label.textContent = 'Press Ctrl+C';
        }
        window.setTimeout(() => {
          if (label) label.textContent = 'Copy';
        }, 2000);
      });
    });
  }

  bindCopyButtons();
  document.addEventListener('astro:page-load', bindCopyButtons);
</script>
