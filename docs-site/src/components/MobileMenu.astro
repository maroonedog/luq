---
import MobileMenuButton from './MobileMenuButton.astro';
import MobileMenuOverlay from './MobileMenuOverlay.astro';

/**
 * Convenience wrapper: the top app bar's menu button plus the modal navigation
 * drawer it opens, in one component.
 *
 * Prefer the two pieces separately — Header.astro already renders
 * MobileMenuButton, so a page only needs MobileMenuOverlay at body level. Use
 * this wrapper only where a page owns both.
 */
export interface Props {
  navItems: Array<{ href: string; label: string; icon?: string }>;
}

const { navItems } = Astro.props;
---

<MobileMenuButton />
<MobileMenuOverlay navItems={navItems} />
