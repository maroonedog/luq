---
/**
 * Right-hand table of contents (xl and up).
 *
 * Styled as an MD3 navigation drawer: the same nav-drawer item shape and
 * secondary-container active indicator as DocsSidebar, so a reader sees one
 * navigation idiom on both sides of the page.
 */
export interface Props {
  tableOfContents: Array<{
    id: string;
    title: string;
    level: number;
  }>;
}

const { tableOfContents } = Astro.props;
---

<aside
  class="hidden w-64 flex-shrink-0 border-l border-outline-variant bg-surface xl:block"
  aria-label="On this page"
>
  <div class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto px-3 py-4">
    <h2 class="md-nav-drawer-headline">On this page</h2>

    <nav class="space-y-1">
      {
        tableOfContents.map((item) => (
          <a
            href={`#${item.id}`}
            data-target={item.id}
            class:list={[
              'page-toc-link md-nav-drawer-item md-nav-drawer-item-dense md-state-layer md-focus-ring',
              item.level >= 3 && 'ml-3',
            ]}
          >
            <span class="truncate">{item.title}</span>
          </a>
        ))
      }
    </nav>

    <hr class="md-divider my-4" />

    <div class="px-4">
      <p class="md-label-medium mb-2 text-on-surface-variant">Reading progress</p>
      <div
        class="h-1 w-full overflow-hidden rounded-shape-full bg-surface-container-highest"
        role="progressbar"
        aria-label="Reading progress"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        id="reading-progress-track"
      >
        <div
          id="reading-progress"
          class="h-full rounded-shape-full bg-primary transition-[width] duration-short-4 ease-standard"
          style="width: 0%"
        >
        </div>
      </div>
    </div>
  </div>
</aside>

<style>
  .page-toc-link.is-active {
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }
</style>

<script>
  function bindOnThisPage(): void {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.page-toc-link')
    );
    const bar = document.getElementById('reading-progress');
    const track = document.getElementById('reading-progress-track');
    if (links.length === 0 && !bar) return;

    const headings = links
      .map((link) => document.getElementById(link.dataset.target ?? ''))
      .filter((element): element is HTMLElement => element !== null);

    if (headings.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          links.forEach((link) => {
            link.classList.toggle('is-active', link.dataset.target === visible.target.id);
          });
        },
        { rootMargin: '-10% 0% -70% 0%', threshold: [0, 0.5, 1] }
      );
      headings.forEach((heading) => observer.observe(heading));
    }

    if (bar && track) {
      const update = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const percent = scrollable <= 0 ? 0 : Math.min((window.scrollY / scrollable) * 100, 100);
        bar.style.width = `${percent}%`;
        track.setAttribute('aria-valuenow', String(Math.round(percent)));
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    }
  }

  bindOnThisPage();
  document.addEventListener('astro:page-load', bindOnThisPage);
</script>
