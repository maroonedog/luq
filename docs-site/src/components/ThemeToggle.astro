---
/**
 * MD3 standard icon button that switches the colour scheme.
 *
 * Writes an explicit choice to localStorage under `theme`; BaseLayout's inline
 * script reads it before first paint. Icons are Material Symbols ligatures.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="md-icon-button md-state-layer md-focus-ring text-on-surface-variant"
  aria-label="Switch colour scheme"
>
  <span class="md-icon md-icon-sm theme-toggle-light" aria-hidden="true">light_mode</span>
  <span class="md-icon md-icon-sm theme-toggle-dark" aria-hidden="true">dark_mode</span>
</button>

<style>
  #theme-toggle {
    display: grid;
    place-items: center;
  }

  /* Both glyphs occupy the same cell so the button never reflows. */
  .theme-toggle-light,
  .theme-toggle-dark {
    grid-area: 1 / 1;
    transition:
      transform var(--md-sys-motion-duration-medium-2) var(--md-sys-motion-easing-emphasized),
      opacity var(--md-sys-motion-duration-short-4) var(--md-sys-motion-easing-standard);
  }

  .theme-toggle-dark {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  :global(.dark) .theme-toggle-light {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  :global(.dark) .theme-toggle-dark {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  function bindThemeToggle(): void {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    toggle.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.classList.contains('dark') ? 'light' : 'dark';
      root.classList.toggle('dark', next === 'dark');
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Private-mode storage refusal only costs persistence, not the switch.
      }
    });
  }

  bindThemeToggle();
  document.addEventListener('astro:page-load', bindThemeToggle);
</script>
