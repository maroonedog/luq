---
/**
 * MD3 navigation drawer for the documentation tree.
 *
 * Standard (permanent) drawer from `lg` up; below that it is a modal drawer
 * opened by the extended FAB this component also renders — the 1.x version
 * expected a trigger with id `mobile-docs-menu-button` that no page ever
 * rendered, so the drawer was unreachable on phones.
 *
 * Every href below must point at a page that exists, and every label matches the
 * h1 of the page it opens. The "Result: 1.x → now" entry deliberately points at
 * a section rather than a page: the 1.x-to-now mapping lives on the Validator
 * page, next to the API it maps onto, and there is no separate migration page to
 * send readers to. It sits under API directly beneath Validator so the group
 * explains why the click lands there — filed under Guides it read as a promise
 * of a guide that does not exist.
 *
 * The Reference group re-lists the four top-level reference pages, so the docs
 * tree is not a cul-de-sac. /standard-schema is there because the app bar no
 * longer carries it.
 */
export interface TableOfContentsItem {
  id: string;
  title: string;
  level: number;
}

export interface Props {
  currentPath: string;
  tableOfContents?: TableOfContentsItem[];
}

const { currentPath, tableOfContents } = Astro.props;

const sections = [
  {
    title: 'Learn',
    items: [
      { label: 'Getting started', href: '/docs/getting-started', icon: 'rocket_launch' },
      { label: 'Core concepts', href: '/docs/core-concepts', icon: 'category' },
      { label: 'Examples & patterns', href: '/docs/examples', icon: 'lightbulb' },
    ],
  },
  {
    title: 'Guides',
    items: [
      { label: 'Writing a plugin', href: '/docs/custom-plugins', icon: 'build' },
      { label: 'Troubleshooting', href: '/docs/troubleshooting', icon: 'help' },
    ],
  },
  {
    title: 'API',
    items: [
      { label: 'Builder', href: '/docs/api/builder', icon: 'construction' },
      { label: 'Validator', href: '/docs/api/validator', icon: 'checklist' },
      { label: 'Result: 1.x → now', href: '/docs/api/validator#porting', icon: 'swap_horiz' },
      {
        label: 'Plugin registry & field rules',
        href: '/docs/api/plugin-registry',
        icon: 'inventory_2',
      },
    ],
  },
  {
    title: 'Reference',
    items: [
      { label: 'Plugin catalogue', href: '/plugins', icon: 'extension' },
      { label: 'JSON Schema', href: '/json-schema', icon: 'schema' },
      { label: 'Standard Schema', href: '/standard-schema', icon: 'hub' },
      { label: 'Benchmarks', href: '/benchmarks', icon: 'speed' },
    ],
  },
];
---

<!-- Modal-drawer scrim (below lg only) -->
<div id="docs-drawer-scrim" class="md-scrim z-40 hidden lg:hidden"></div>

<aside
  id="docs-sidebar"
  class="md-nav-drawer md-nav-drawer-modal fixed left-0 top-0 z-40 h-screen w-80 -translate-x-full overflow-y-auto lg:sticky lg:top-16 lg:z-auto lg:h-[calc(100vh-4rem)] lg:w-72 lg:flex-shrink-0 lg:translate-x-0 lg:rounded-none lg:border-r lg:border-outline-variant lg:bg-surface lg:shadow-none"
  aria-label="Documentation"
>
  <!-- Modal-drawer header (below lg only) -->
  <div class="flex items-center justify-between py-4 pl-6 pr-4 lg:hidden">
    <span class="md-title-small text-on-surface-variant">Documentation</span>
    <button
      id="docs-drawer-close"
      class="md-icon-button md-state-layer md-focus-ring"
      aria-label="Close documentation menu"
    >
      <span class="md-icon" aria-hidden="true">close</span>
    </button>
  </div>

  <nav class="px-3 pb-8 lg:pt-4">
    {
      tableOfContents && tableOfContents.length > 0 && (
        <div class="mb-4 xl:hidden">
          <h2 class="md-nav-drawer-headline">On this page</h2>
          <ul>
            {tableOfContents.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  data-target={item.id}
                  class:list={[
                    'toc-link md-nav-drawer-item md-nav-drawer-item-dense md-state-layer md-focus-ring',
                    item.level >= 3 && 'ml-4',
                  ]}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
          <hr class="md-divider mt-4" />
        </div>
      )
    }

    {
      sections.map((section) => (
        <div class="mb-2">
          <h2 class="md-nav-drawer-headline">{section.title}</h2>
          <ul class="space-y-1">
            {section.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? 'page' : undefined}
                  class="md-nav-drawer-item md-nav-drawer-item-dense md-state-layer md-focus-ring"
                >
                  <span class="md-icon md-icon-sm" aria-hidden="true">
                    {item.icon}
                  </span>
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>

<!-- Extended FAB: the modal drawer's trigger below lg -->
<button
  id="docs-drawer-open"
  type="button"
  class="md-state-layer md-focus-ring fixed bottom-6 left-6 z-30 flex h-14 items-center gap-3 rounded-shape-lg bg-primary-container px-4 text-label-large text-on-primary-container shadow-elevation-3 lg:hidden"
  aria-label="Open documentation menu"
  aria-expanded="false"
  aria-controls="docs-sidebar"
>
  <span class="md-icon md-icon-sm" aria-hidden="true">menu_book</span>{' '}
  Contents
</button>

<style>
  #docs-sidebar {
    transition: transform var(--md-sys-motion-duration-medium-4)
      var(--md-sys-motion-easing-emphasized-decelerate);
  }

  #docs-drawer-scrim {
    transition: opacity var(--md-sys-motion-duration-medium-2)
      var(--md-sys-motion-easing-emphasized);
  }

  /* Active table-of-contents entry gets the same indicator as a nav item. */
  .toc-link.is-active {
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }
</style>

<script>
  const DESKTOP_QUERY = '(min-width: 1024px)';

  function bindDocsDrawer(): void {
    const sidebar = document.getElementById('docs-sidebar');
    const scrim = document.getElementById('docs-drawer-scrim');
    const openButton = document.getElementById('docs-drawer-open');
    const closeButton = document.getElementById('docs-drawer-close');
    if (!sidebar || !scrim || sidebar.dataset.drawerBound === 'true') return;
    sidebar.dataset.drawerBound = 'true';

    const open = () => {
      sidebar.classList.remove('-translate-x-full');
      scrim.classList.remove('hidden');
      openButton?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const dismiss = () => {
      if (window.matchMedia(DESKTOP_QUERY).matches) return;
      sidebar.classList.add('-translate-x-full');
      scrim.classList.add('hidden');
      openButton?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    openButton?.addEventListener('click', open);
    closeButton?.addEventListener('click', dismiss);
    scrim.addEventListener('click', dismiss);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') dismiss();
    });
    sidebar.querySelectorAll('nav a').forEach((link) => {
      link.addEventListener('click', dismiss);
    });
    window.addEventListener('resize', dismiss);
  }

  function bindSidebarTableOfContents(): void {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#docs-sidebar .toc-link')
    );
    if (links.length === 0) return;

    const headings = links
      .map((link) => document.getElementById(link.dataset.target ?? ''))
      .filter((element): element is HTMLElement => element !== null);
    if (headings.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        links.forEach((link) => {
          link.classList.toggle('is-active', link.dataset.target === visible.target.id);
        });
      },
      { rootMargin: '-20% 0% -60% 0%', threshold: [0, 0.5, 1] }
    );

    headings.forEach((heading) => observer.observe(heading));
  }

  function initialize(): void {
    bindDocsDrawer();
    bindSidebarTableOfContents();
  }

  initialize();
  document.addEventListener('astro:page-load', initialize);
</script>
