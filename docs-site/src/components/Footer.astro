---
import LuqLogo from './LuqLogo.astro';
import { packageInfo } from '../data/package-info';

/**
 * Site footer, on `surface-container` so it separates from the page's
 * `surface` without a border. Links use the MD3 list-item shape.
 *
 * This is the only component on all sixteen pages, which makes it the site's
 * real universal navigation. The app bar carries five items; everything it does
 * not carry is listed here, because /openapi, /standard-schema and /roadmap
 * have no in-content inbound links anywhere on the site — strip the header,
 * drawer, sidebar and footer out of the built HTML and all three have zero. The
 * docs sidebar already re-lists three top-level reference pages for the same
 * reason. Every label matches the h1 of the page it opens.
 *
 * Every href must point at a page that exists — the 1.x footer linked
 * /docs/changelog, which has never been a page here. check-built-pages now
 * resolves each one against dist/.
 */
interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const footerLinks: Record<string, FooterLink[]> = {
  Documentation: [
    { label: 'Getting started', href: '/docs/getting-started' },
    { label: 'Core concepts', href: '/docs/core-concepts' },
    { label: 'Examples & patterns', href: '/docs/examples' },
    { label: 'Troubleshooting', href: '/docs/troubleshooting' },
  ],
  Reference: [
    { label: 'Plugin catalogue', href: '/plugins' },
    { label: 'Builder API', href: '/docs/api/builder' },
    { label: 'Validator API', href: '/docs/api/validator' },
    { label: 'JSON Schema', href: '/json-schema' },
    { label: 'Standard Schema', href: '/standard-schema' },
    { label: 'Benchmarks', href: '/benchmarks' },
  ],
  Deciding: [
    { label: 'Luq or zod?', href: '/luq-or-zod' },
    { label: 'Rules on generated types', href: '/openapi' },
    { label: 'Project status', href: '/roadmap' },
  ],
  Project: [
    { label: 'GitHub', href: 'https://github.com/maroonedog/luq', external: true },
    { label: 'npm', href: 'https://www.npmjs.com/package/@maroonedog/luq', external: true },
  ],
};
---

<footer class="bg-surface-container text-on-surface">
  <div class="mx-auto w-full max-w-screen-2xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 py-12 md:grid-cols-3 lg:grid-cols-5">
      <div class="col-span-2 md:col-span-1">
        <LuqLogo class="mb-4 h-10 w-auto" />
        <p class="md-body-small text-on-surface-variant">
          A type-first validation library for TypeScript.
        </p>
        <p class="md-body-small mt-2 text-on-surface-variant">MIT licensed.</p>
      </div>

      {
        Object.entries(footerLinks).map(([group, links]) => (
          <nav aria-label={group}>
            <h2 class="md-title-small mb-3 text-on-surface">{group}</h2>
            <ul class="space-y-1">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    class="md-state-layer md-focus-ring -ml-2 inline-flex items-center gap-1 rounded-shape-sm px-2 py-1 text-body-medium text-on-surface-variant transition-colors duration-short-4 ease-standard hover:text-primary"
                  >
                    {link.label}
                    {link.external && (
                      <span class="md-icon md-icon-sm" aria-hidden="true">
                        open_in_new
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <hr class="md-divider" />

    <div
      class="flex flex-col items-center justify-between gap-4 py-6 md:flex-row"
    >
      <p class="md-body-small text-on-surface-variant">
        &copy; {new Date().getFullYear()} Luq. Released under the MIT License.
      </p>
      <span class="md-chip md-chip-static">
        <span class="md-icon md-icon-sm text-tertiary" aria-hidden="true">
          verified
        </span>
        {packageInfo.tag}
      </span>
    </div>
  </div>
</footer>
