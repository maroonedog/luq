---
import LuqLogo from './LuqLogo.astro';
import CodeBlock from './CodeBlock.astro';
import { bundleSize } from '../data/bundle-size';
import { conformance } from '../data/conformance';
import { packageInfo } from '../data/package-info';
import { pluginSubpathCount } from '../data/plugins';

/**
 * Landing hero.
 *
 * Every figure in `measured` comes from a file in the repository that CI
 * re-measures; the `source` field names it. Nothing here is carried over from
 * the 1.x site, whose two headline numbers ("19-23KB", "695K ops/s") were
 * neither reproducible nor measured against this implementation.
 */
const measured = [
  {
    // Read, never hand-written. This figure was once typed here and went
    // stale while the rest of the page already read the generated data.
    value: bundleSize.coreOnly.gzip,
    label: 'Builder alone, gzipped',
    source: 'config/size-budget.json',
  },
  {
    value: String(pluginSubpathCount),
    label: 'plugins, one import each',
    source: 'config/plugin-catalog.lock.json',
  },
  {
    value: `${conformance.percent}%`,
    label: 'JSON Schema Draft-07',
    source: 'config/json-schema-suite.json',
  },
  {
    value: '0',
    label: 'eval / new Function',
    source: 'npm run check:no-dynamic-code',
  },
];

const install = packageInfo.install;

// The first row of `refused`, written out so the compiler answers for it
// rather than the page.
//
// Every other headline figure here is read from a generated file. This one
// claim — the one the h1, the <title> and the README all lead with — was four
// English sentences footnoted to a directory nobody reading the page can open.
// The directive is what turns it back into a measurement: check:doc-examples
// compiles the block on every build and fails if it ever succeeds. If an API
// change ever makes `b.string` legal on a number field, this breaks the build,
// and the claim is what has to change — not the directive.
//
// luq-example: must-fail — the page's headline claim; compiling would make it false
const refusedExample = `import { Builder } from "@maroonedog/luq";
import { requiredPlugin } from "@maroonedog/luq/plugins/required";

// The type is the schema, and \`age\` is a number.
type User = { age: number };

const userValidator = Builder()
  .use(requiredPlugin)
  .for<User>()
  .v("age", (b) => b.string.required())
  //               ^^^^^^^^ not a slot a number field can be.
  .build();`;

// Things the previous major accepted and this one refuses to compile: the
// claim that constraints are machine-enforced, shown case by case. The first
// is proved by the block above; the other three come from negative type tests,
// so the type check passing is itself the proof that they still fail.
const refused = [
  {
    mistake: 'A slot unrelated to the field’s type',
    example: 'b.string on a number field',
  },
  {
    mistake: 'A missing array wildcard',
    example: '"items.name" instead of "items[*].name"',
  },
  {
    mistake: 'Descending into a built-in',
    example: '"when.getTime" on a Date',
  },
  {
    mistake: 'A method that does not exist',
    example: 'inside an element sub-chain',
  },
];
---

<section class="relative overflow-hidden bg-surface px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
  <div class="container mx-auto max-w-5xl text-center">
    <div class="mb-8 flex justify-center">
      <LuqLogo
        class="h-24 w-auto transition-transform duration-medium-2 ease-emphasized hover:scale-105 sm:h-28"
        label="Luq"
      />
    </div>

    <p class="mb-6">
      <span class="md-chip md-chip-static">
        <span class="md-icon md-icon-sm" aria-hidden="true">verified</span>
        {packageInfo.tag}
      </span>
    </p>

    <h1 class="mb-6 text-display-small text-on-surface sm:text-display-medium lg:text-display-large">
      The wrong rule<br class="hidden sm:block" />{' '}
      <span class="text-primary">does not compile</span>
    </h1>

    <div class="mx-auto max-w-3xl text-left">
      <p class="mb-8 text-body-large text-on-surface">
        Your types were probably not written by you.{' '}
        <a class="text-primary underline underline-offset-2" href="/openapi"
          ><code class="font-mono">openapi-typescript</code></a
        >{' '}
        generates them from a spec you do not own; Prisma generates them from the
        schema of record; protobuf generates them for four languages at once. When
        the shape is already decided somewhere else,{' '}
        <strong class="text-on-surface"
          >a validator whose schema is the source of truth asks you to maintain a
          second description of it</strong
        >.
      </p>
    </div>

    <div class="mx-auto mb-8 max-w-3xl text-left">
      <p class="mb-3 text-label-large uppercase tracking-wide text-on-surface-variant">
        Caught by the compiler, not at run time
      </p>
      <ul class="divide-y divide-outline-variant border-y border-outline-variant">
        {
          refused.map((item) => (
            <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3">
              <span class="md-icon md-icon-sm text-error" aria-hidden="true">block</span>
              <span class="text-body-medium text-on-surface">{item.mistake}</span>
              <span class="font-mono text-label-medium text-on-surface-variant">
                {item.example}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mb-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/docs/getting-started" class="md-button md-button-filled md-state-layer md-focus-ring">
        Get started
      </a>
      <a href="/plugins" class="md-button md-button-tonal md-state-layer md-focus-ring">
        Browse the plugins
      </a>
      <a
        href="https://github.com/maroonedog/luq"
        target="_blank"
        rel="noopener noreferrer"
        class="md-button md-button-outlined md-state-layer md-focus-ring"
      >
        <span class="md-icon md-icon-sm" aria-hidden="true">open_in_new</span>{' '}
        GitHub
      </a>
    </div>

    <div class="mx-auto mb-12 max-w-xl">
      <CodeBlock code={install} language="bash" fileName="Install" showCopy={true} />
    </div>

    <div class="mx-auto mb-12 max-w-3xl text-left">
      <p class="mb-3 text-body-large text-on-surface-variant">
        Luq runs the other way. It takes the type you already have and lets you
        declare rules against its field paths —{' '}
        <strong class="text-on-surface"
          >the compiler checks those declarations against the type</strong
        >, so a rule that does not apply to the field it is written on is an error
        rather than a rule that quietly never fires.
      </p>
      <p class="mb-4 text-body-medium text-on-surface-variant">
        Nothing is rewritten and no type is inferred back out of a schema object:
        the type below is the schema, and <code class="font-mono">b.string</code> is
        not a slot a number field can be. That is the first row of the list above,
        written out.
      </p>
      <div class="rounded-shape-md border border-error p-1">
        <p class="px-3 py-2 text-label-large text-error">
          <span class="md-icon md-icon-sm align-middle" aria-hidden="true">cancel</span>{' '}
          This does not compile
        </p>
        <CodeBlock code={refusedExample} language="typescript" invalid />
      </div>
      <p class="mt-3 text-body-small text-on-surface-variant">
        That block is marked <code class="font-mono">must-fail</code> in this
        component's source. <code class="font-mono">npm run check:doc-examples</code>{' '}
        compiles it on every build and fails if it ever succeeds, so the claim is
        checked in the direction it is made. The other three rows are pinned the
        same way by a <code class="font-mono">@ts-expect-error</code> in{' '}
        <code class="font-mono">test/type/</code>.
      </p>
    </div>

    <div class="mb-4 grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        measured.map((item) => (
          <div class="md-card md-card-outlined min-w-0 p-5 text-left">
            <div class="text-headline-small text-primary">{item.value}</div>
            <div class="mt-1 text-body-medium text-on-surface">{item.label}</div>
            <div class="mt-2 truncate font-mono text-label-small text-on-surface-variant" title={item.source}>
              {item.source}
            </div>
          </div>
        ))
      }
    </div>

    <p class="text-body-small text-on-surface-variant">
      Every number on this site was measured on this repository, and the file it
      came from is named beside it.
    </p>
  </div>
</section>
