  "scripts": {
    "build": "npx ts-node --project scripts/tsconfig.json scripts/build.ts",
    "test": "jest --no-watch --no-watchman --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "npm run lint:ox && npm run lint:naming",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify",
    "generate-docs": "npx ts-node --project scripts/tsconfig.json scripts/generate-docs.ts",
    "lint:fix": "oxlint -c .oxlintrc.json --fix src bench",
    "lint:filenames": "node scripts/check-filenames.js",
    "format": "oxfmt src test scripts bench",
    "format:check": "oxfmt --check src test scripts bench",
    "typecheck": "npm run typecheck:src && npm run typecheck:scripts && npm run typecheck:bench",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:bench": "tsc --noEmit -p bench/tsconfig.json",
    "generate": "npm run generate:sources && npm run generate:exports && npm run generate:lock",
    "generate:sources": "npm run generate:manifest && npm run generate:barrel",
    "generate:manifest": "npx ts-node --project scripts/tsconfig.json scripts/generate-plugin-manifest.ts",
    "generate:barrel": "npx ts-node --project scripts/tsconfig.json scripts/generate-plugin-barrel.ts",
    "generate:exports": "npx ts-node --project scripts/tsconfig.json scripts/generate-package-exports.ts",
    "generate:lock": "npx ts-node --project scripts/tsconfig.json scripts/generate-plugin-catalog.ts",
    "check:exports": "npx ts-node --project scripts/tsconfig.json scripts/check-exports.ts --mode=exact",
    "check:catalog-lock": "npx ts-node --project scripts/tsconfig.json scripts/check-catalog-lock.ts",
    "check:plugin-isolation": "npx ts-node --project scripts/tsconfig.json scripts/check-plugin-isolation.ts",
    "check:plugin-uniqueness": "npx ts-node --project scripts/tsconfig.json scripts/check-plugin-uniqueness.ts",
    "check:catalog": "npm run check:plugin-uniqueness && npm run check:plugin-isolation && npm run check:exports && npm run check:catalog-lock",
    "check:size": "npx ts-node --project scripts/tsconfig.json scripts/measure-bundle-size.ts",
    "check:barrel-equivalence": "npx ts-node --project scripts/tsconfig.json scripts/check-barrel-equivalence.ts",
    "check:no-dynamic-code": "npx ts-node --project scripts/tsconfig.json scripts/check-no-dynamic-code.ts",
    "check:dist-layout": "npx ts-node --project scripts/tsconfig.json scripts/check-dist-layout.ts",
    "check:dist": "npm run check:no-dynamic-code && npm run check:dist-layout",
    "check:distribution": "npm run check:size && npm run check:barrel-equivalence",
    "check:contract-arity": "npx ts-node --project scripts/tsconfig.json scripts/check-contract-arity.ts",
    "check:module-has-test": "npx ts-node --project scripts/tsconfig.json scripts/check-module-has-test.ts",
    "check:suite-pin": "npx ts-node --project scripts/tsconfig.json scripts/check-suite-pin.ts",
    "check:source": "npm run check:contract-arity && npm run check:module-has-test && npm run check:suite-pin",
    "verify": "npm run generate:sources && npm run format:check && npm run lint && npm run lint:filenames && npm run typecheck && npm run test:types && npm run check:source && npm run check:catalog && npm run build && npm run check:dist && npm run check:docs && npm run check:distribution && npm test",
    "test:types": "tsc --noEmit -p tsconfig.type-test.json",
    "check:doc-examples": "npx ts-node --project scripts/tsconfig.json scripts/check-doc-examples.ts",
    "check:doc-imports": "npx ts-node --project scripts/tsconfig.json scripts/check-doc-imports.ts",
    "check:generated-docs": "npx ts-node --project scripts/tsconfig.json scripts/generate-docs.ts --check",
    "check:docs": "npm run check:generated-docs && npm run check:doc-examples && npm run check:doc-imports && npm run check:conformance-figures && npm run check:perf-figures",
    "bench:record": "npx ts-node --project scripts/tsconfig.json scripts/run-bench.ts --record",
    "bench:gate": "npx ts-node --project scripts/tsconfig.json scripts/run-bench.ts --gate",
    "check:conformance-figures": "npx ts-node --project scripts/tsconfig.json scripts/check-conformance-figures.ts",
    "bench:competitors": "npx ts-node --project bench/tsconfig.json bench/competitors/report-competitors.ts",
    "bench:competitors:check": "npx ts-node --project bench/tsconfig.json bench/competitors/check-competitors.ts",
    "lint:ox": "oxlint -c .oxlintrc.json src bench",
    "lint:naming": "eslint \"src/**/*.ts\" \"bench/**/*.ts\"",
    "generate:perf-figures": "npx ts-node --project scripts/tsconfig.json scripts/check-perf-figures.ts --write",
    "check:perf-figures": "npx ts-node --project scripts/tsconfig.json scripts/check-perf-figures.ts"
  },
