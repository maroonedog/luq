# ========================================
# Node.js Dependencies
# ========================================
/node_modules
**/node_modules
/.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========================================
# Production builds and compiled outputs
# ========================================
/build
/dist
**/dist
# test/dist/ is not build output: it is the source of the tests that inspect the output.
!test/dist/
!test/dist/**
/out
**/out
/bin
**/bin
/dist-unminified
/.build
*.tsbuildinfo

# WebAssembly files
*.wasm
*.wasm.d.ts

# Binary executables
luq-lsp
*.exe

# ========================================
# Development Environment Files
# ========================================
# IDE files
/.vscode
/.idea
*.sublime-*
*.swp
*~
.#*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk

# ========================================
# Runtime and Temporary Files
# ========================================
pids
*.pid
*.seed
*.pid.lock
/temp
**/temp
*.tmp
*.log

# ========================================
# Environment and Configuration
# ========================================
.env
.env.local
.env.development
.env.test
.env.production
.env.development.local
.env.test.local
.env.production.local

# ========================================
# Testing and Coverage
# ========================================
/coverage
**/coverage
*.lcov

# Temporary test files
test-*.js
test-*.ts
debug-*.ts
debug-*.js

# Test import files (generated during testing)

# ========================================
# Language-specific build outputs
# ========================================
# TypeScript
*.js.map
*.d.ts.map

# JavaScript source maps and generated files
src/**/*.js

# ========================================
# Framework and Tool Caches
# ========================================
# Next.js
.next/
.swc/

# Turbo
.turbo/

# Astro (docs site)
docs-site/.astro/

# VS Code extension
vscode-luq/out/
*.vsix

# ========================================
# Project-specific artifacts
# ========================================
# Bundle analysis and size comparison
bundle-size-comparison/dist/
bundle-size-comparison/node_modules/

# Auto-generated documentation files
docs-site/src/content/plugins/*.md
docs-site/src/data/plugins.json

# Docs site build artifacts
docs-site/dist/

# Luq generated files
dist/validators/
*.validator.js
*.validator.ts

# LSP server files
*.lsp-log

# ========================================
# Git and Version Control
# ========================================
*.orig
*.rej
*.patch

# ========================================
# Archive and Package files
# ========================================
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Claude Code local settings
**/.claude/settings.local.json

# ========================================
# Plugin catalog derivatives (untracked: regenerate with `npm run generate`)
# config/plugin-catalog.lock.json and package.json#/exports are TRACKED.
# ========================================
src/plugins/manifest.generated.ts
src/plugins/index.generated.ts
src/chain/slot-catalog.generated.ts

# ESM probe written temporarily by the dist tests
.dist-esm-probe.mjs

# luq-codegen build output, and the scratch directory its two tsc
# emits are copied out of.
luq-codegen/dist/
luq-codegen/.build/
# Not committed: the lock would pin a resolution of the repository root that
# a checkout at a different commit no longer matches, and the sub-package is
# not published from a lockfile anyway.
luq-codegen/package-lock.json
