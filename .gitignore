/build
/dist
**/dist
/out
**/out
/bin
**/bin
/dist-unminified
/.build
*.tsbuildinfo

# WebAssembly files
*.wasm
*.wasm.d.ts

# Binary executables
luqc
luq-lsp
*.exe

