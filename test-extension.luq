interface User {
  @required
  @min(3)
  name: string;
  
  @required
  @email
  email: string;
  
  @min(18)
  @max(120)
  age: number;
  
  @optional
  address?: {
    street: string;
    city: string;
    @pattern("^[0-9]{5}$")
    zipCode: string;
  };
}

